// pylon: the phase-0 command-line client (SPEC 17).
//
//   pylon [-p PORT] [--allow-no-strict] USER@HOST [COMMAND...]
//       Run COMMAND on HOST, or with no COMMAND an interactive shell on a
//       pseudo-terminal, authenticating with the agent at
//       SSH_AUTH_SOCK (Symbolon's `symbolon ssh-agent`, or any agent
//       that supports session-bind@openssh.com).
//
//   pylon pin [-p PORT] HOST FINGERPRINT|LINE...|-
//   pylon pin [-p PORT] 'pylon-hostkey/1 HOST[:PORT] SHA256:...'
//       Pin HOST's key, but only if it matches a fingerprint the principal
//       obtained out of band (SPEC 6.1.4): a bare SHA256:..., lines of
//       `ssh-keygen -lf` (as arguments, or pasted on standard input with
//       -), or the QR payload that binds them to the host.
//
//   pylon sshfp HOST
//       What DNSSEC-validated DNS says of HOST's SSHFP records (SPEC 6.1.2).

import "crypto.resid";
import "../core/dns.resid";
import "../core/dnssec.resid";
import "../core/resolver.resid";
import "../core/oob.resid";
import "../core/wire.resid";
import "../core/hostkey.resid";
import "../core/transport.resid";
import "../core/agent.resid";
import "../core/auth.resid";
import "../core/authorize.resid";
import "../core/qr.resid";
import "../core/session.resid";
import "../core/known.resid";
import "../core/forward.resid";
import "../core/sftp.resid";
import "../core/jump.resid";
import "../core/proto.resid";
import "../core/link.resid";
import "../core/pyclient.resid";
import "../core/files.resid";
import "../core/release.resid";
import "../core/release_gate.resid";
import "../core/addr.resid";
import "sftp_shell.resid";

type Opts = { Int port; Bool no_strict; Bool no_obfuscate; Bool no_cmd; Bool force; Str jump; Str pylond; List(Str) pflags; List(Str) fwds; List(Str) rest; Str err; };

@requires(args)
Opts parse(Int i, Opts o) {
    if (i >= args.count() || o.rest.len() > 0) { return rest_from(i, o); }
    Str a = args.get(i);
    if (a == "-p" && i + 1 < args.count()) {
        Str v = args.get(i + 1);
        if (!str_is_int(v) || str_parse_int(v) < 1 || str_parse_int(v) > 65535) { return Opts {.port = o.port, .no_strict = o.no_strict, .no_obfuscate = o.no_obfuscate, .no_cmd = o.no_cmd, .force = o.force, .jump = o.jump, .pylond = o.pylond, .pflags = o.pflags, .fwds = o.fwds, .rest = [], .err = "bad port " + v}; }
        return parse(i + 2, Opts {.port = str_parse_int(v), .no_strict = o.no_strict, .no_obfuscate = o.no_obfuscate, .no_cmd = o.no_cmd, .force = o.force, .jump = o.jump, .pylond = o.pylond, .pflags = o.pflags, .fwds = o.fwds, .rest = [], .err = ""});
    }
    if (a == "-J" && i + 1 < args.count()) { return parse(i + 2, Opts {.port = o.port, .no_strict = o.no_strict, .no_obfuscate = o.no_obfuscate, .no_cmd = o.no_cmd, .force = o.force, .jump = args.get(i + 1), .pylond = o.pylond, .pflags = o.pflags, .fwds = o.fwds, .rest = [], .err = ""}); }
    if (a == "--pylond" && i + 1 < args.count()) { return parse(i + 2, Opts {.port = o.port, .no_strict = o.no_strict, .no_obfuscate = o.no_obfuscate, .no_cmd = o.no_cmd, .force = o.force, .jump = o.jump, .pylond = args.get(i + 1), .pflags = o.pflags, .fwds = o.fwds, .rest = [], .err = ""}); }
    if (a == "--attach" || a == "--ca" || a == "--sessions" || a == "--ephemeral" || a == "--allow-unconfined" || a == "--app" || a == "--resume") { return parse(i + 1, Opts {.port = o.port, .no_strict = o.no_strict, .no_obfuscate = o.no_obfuscate, .no_cmd = o.no_cmd, .force = o.force, .jump = o.jump, .pylond = o.pylond, .pflags = o.pflags.concat([str_slice(a, 2, str_len(a))]), .fwds = o.fwds, .rest = [], .err = ""}); }
    if (a == "--session" && i + 1 < args.count()) {
        Str v = args.get(i + 1);
        if (!str_is_int(v) || str_parse_int(v) < 0) { return Opts {.port = o.port, .no_strict = o.no_strict, .no_obfuscate = o.no_obfuscate, .no_cmd = o.no_cmd, .force = o.force, .jump = o.jump, .pylond = o.pylond, .pflags = o.pflags, .fwds = o.fwds, .rest = [], .err = "bad session " + v}; }
        return parse(i + 2, Opts {.port = o.port, .no_strict = o.no_strict, .no_obfuscate = o.no_obfuscate, .no_cmd = o.no_cmd, .force = o.force, .jump = o.jump, .pylond = o.pylond, .pflags = o.pflags.concat(["session=" + v]), .fwds = o.fwds, .rest = [], .err = ""});
    }
    if (a == "--pylond-unverified") { return parse(i + 1, Opts {.port = o.port, .no_strict = o.no_strict, .no_obfuscate = o.no_obfuscate, .no_cmd = o.no_cmd, .force = o.force, .jump = o.jump, .pylond = o.pylond, .pflags = o.pflags.concat(["pylond-unverified"]), .fwds = o.fwds, .rest = [], .err = ""}); }
    if (a == "--pylond-roots" && i + 1 < args.count()) { return parse(i + 2, Opts {.port = o.port, .no_strict = o.no_strict, .no_obfuscate = o.no_obfuscate, .no_cmd = o.no_cmd, .force = o.force, .jump = o.jump, .pylond = o.pylond, .pflags = o.pflags.concat(["roots=" + args.get(i + 1)]), .fwds = o.fwds, .rest = [], .err = ""}); }
    if (a == "--force") { return parse(i + 1, Opts {.port = o.port, .no_strict = o.no_strict, .no_obfuscate = o.no_obfuscate, .no_cmd = o.no_cmd, .force = true, .jump = o.jump, .pylond = o.pylond, .pflags = o.pflags, .fwds = o.fwds, .rest = [], .err = ""}); }
    if (a == "-N") { return parse(i + 1, Opts {.port = o.port, .no_strict = o.no_strict, .no_obfuscate = o.no_obfuscate, .no_cmd = true, .force = o.force, .jump = o.jump, .pylond = o.pylond, .pflags = o.pflags, .fwds = o.fwds, .rest = [], .err = ""}); }
    if ((a == "-L" || a == "-D" || a == "-R") && i + 1 < args.count()) { return parse(i + 2, Opts {.port = o.port, .no_strict = o.no_strict, .no_obfuscate = o.no_obfuscate, .no_cmd = o.no_cmd, .force = o.force, .jump = o.jump, .pylond = o.pylond, .pflags = o.pflags, .fwds = o.fwds.concat([str_slice(a, 1, 2) + " " + args.get(i + 1)]), .rest = [], .err = ""}); }
    if (a == "--no-obfuscate-keystrokes") { return parse(i + 1, Opts {.port = o.port, .no_strict = o.no_strict, .no_obfuscate = true, .no_cmd = o.no_cmd, .force = o.force, .jump = o.jump, .pylond = o.pylond, .pflags = o.pflags, .fwds = o.fwds, .rest = [], .err = ""}); }
    if (a == "--allow-no-strict") { return parse(i + 1, Opts {.port = o.port, .no_strict = true, .no_obfuscate = o.no_obfuscate, .no_cmd = o.no_cmd, .force = o.force, .jump = o.jump, .pylond = o.pylond, .pflags = o.pflags, .fwds = o.fwds, .rest = [], .err = ""}); }
    if (str_starts_with(a, "-")) { return Opts {.port = o.port, .no_strict = o.no_strict, .no_obfuscate = o.no_obfuscate, .no_cmd = o.no_cmd, .force = o.force, .jump = o.jump, .pylond = o.pylond, .pflags = o.pflags, .fwds = o.fwds, .rest = [], .err = "unknown option " + a}; }
    return rest_from(i, o);
}

@requires(args)
Opts rest_from(Int i, Opts o) {
    if (i >= args.count()) { return o; }
    return rest_from(i + 1, Opts {.port = o.port, .no_strict = o.no_strict, .no_obfuscate = o.no_obfuscate, .no_cmd = o.no_cmd, .force = o.force, .jump = o.jump, .pylond = o.pylond, .pflags = o.pflags, .fwds = o.fwds, .rest = o.rest.concat([args.get(i)]), .err = o.err});
}

Int usage() {
    eprintln("usage: pylon [-p PORT] [--allow-no-strict] [--no-obfuscate-keystrokes] USER@HOST [COMMAND...]");
    eprintln("       pylon [-p PORT] -N [-L [127.0.0.1:]PORT:HOST:HOSTPORT] [-D [127.0.0.1:]PORT]");
    eprintln("                       [-R [localhost:]RPORT:HOST:HOSTPORT] ... USER@HOST");
    eprintln("       pylon get [-p PORT] [--force] USER@HOST:REMOTE LOCAL");
    eprintln("       pylon put [-p PORT] LOCAL USER@HOST:REMOTE");
    eprintln("       pylon sftp [-p PORT] USER@HOST[:DIR]   browse, move and copy files (help inside lists the commands)");
    eprintln("       pylon get/put --pylond DIR [--resume] ...   over the Pylon protocol, resumable");
    eprintln("       pylon --pylond DIR [-N -L/-D/-R ...] USER@HOST   a terminal or forwards over the");
    eprintln("                       Pylon protocol (experimental; with -J, HOST as an IP address)");
    eprintln("                       DIR holds pylond-x86_64, pylond-aarch64 and the signed release");
    eprintln("                       (pylond.release, pylond.proof), checked before pylond is pushed;");
    eprintln("                       for a local build: --pylond-roots ROOTS or --pylond-unverified");
    eprintln("                       --attach: pick up a session pylond keeps unattended;");
    eprintln("                       --session ID: pick up that one (the ID pylon names when a link is gone)");
    eprintln("       pylon pylond-check DIR [PROOF]          check DIR's release (PROOF: a newer log proof)");
    eprintln("       any of these with -J USER@JUMP[:PORT] to go through a jump host");
    eprintln("       pylon authorize [-p PORT] [--ca] USER@HOST [KEY-LINE...|-]");
    eprintln("                       from a device that can log in: add keys to HOST's authorized_keys");
    eprintln("                       (only appending), and fix what makes sshd ignore them; no KEY-LINE:");
    eprintln("                       the agent's keys; --ca: trust certificates a CA signs for USER");
    eprintln("       pylon share [-p PORT] HOST              HOST's pin as a QR code, for another device to scan");
    eprintln("       pylon pin [-p PORT] HOST FINGERPRINT   (replaces any key pinned for HOST)");
    eprintln("                       FINGERPRINT: SHA256:..., ssh-keygen -lf lines, or - to paste them");
    eprintln("       pylon pin [-p PORT] 'pylon-hostkey/1 HOST[:PORT] SHA256:...'   a scanned QR payload");
    eprintln("       pylon sshfp HOST                        HOST's SSHFP records, DNSSEC-validated");
    eprintln("       pylon history [HOST]                    what happened to pins");
    eprintln("       pylon pins                              every pinned key");
    eprintln("       pylon ca [PATTERN 'ALG BASE64']         trust a host CA for PATTERN (host, *.domain, *)");
    return 2;
}

// The inner end of a jump pipe, as a connection to the target.
@requires(network, declassify, clock(readonly))
Conn piped(Int fd) {
    _ = resid_tcp_deadline(fd, 30000);
    return conn_new(fd);
}

@requires(network, declassify, clock(readonly))
Conn dial(Str host, Int port) {
    Int fd = resid_tcp_connect(host, port);
    Conn c = conn_new(fd);
    if (fd < 0) { return conn_err(c, "cannot connect to " + host + ":" + f"{port}"); }
    _ = resid_tcp_deadline(fd, 30000);
    return c;
}

@requires(network, filesystem, environment, declassify, clock(readonly))
Int cmd_pin(Opts o, Int via) {
    if (o.rest.len() < 1) { return usage(); }
    Bool payload_only = o.rest.len() == 1;
    Str given = if (payload_only) { o.rest[0] } else { if (o.rest.len() == 2 && o.rest[1] == "-") { pasted(read_stdin(16384, []), 0, "") } else { str_join(o.rest[1..o.rest.len()], " ") } };
    Oob x = oob_parse(given);
    if (str_len(x.err) > 0) { eprintln("pylon: " + x.err); return 2; }
    if (payload_only && str_len(x.host) == 0) { eprintln("pylon: give HOST and its fingerprint, or a " + payload_tag() + " payload"); return usage(); }
    Str host = if (payload_only) { x.host } else { split_host(o.rest[0]).host };
    if (str_len(x.host) > 0 && x.host != str_to_lower(host)) { eprintln("pylon: NOT pinned. That payload is for " + x.host + ", not " + host); return 1; }
    // A payload without a port is for port 22.
    Int xport = if (x.port > 0) { x.port } else { 22 };
    if (str_len(x.host) > 0 && xport != o.port) { eprintln("pylon: NOT pinned. That payload is for port " + f"{xport}" + (if (xport != 22) { "; give -p " + f"{xport}" } else { "" })); return 1; }
    Conn c = if (via >= 0) { piped(via) } else { dial(host, o.port) };
    if (!conn_ok(c)) { eprintln("pylon: " + c.err); return 1; }
    Handshake h = handshake(c, probing(), o.no_strict);
    _ = resid_tcp_close(c.fd);
    if (h.c.err != probe_done()) { eprintln("pylon: " + h.c.err); return 1; }
    _ = if (!h.c.strict) { eprintln_true(no_strict_warning(host)) } else { true };
    if (!x.fps.contains(h.fingerprint)) {
        eprintln("pylon: NOT pinned. " + host + " presents " + h.fingerprint);
        eprintln("       which differs from " + (if (x.fps.len() == 1) { "the fingerprint you gave (" + x.fps[0] + ")." } else { "every fingerprint you gave (" + str_join(x.fps, ", ") + ")." }));
        return 1;
    }
    if (!pin(host_token(host, o.port), h.host.blob, environment.get("HOSTNAME"))) { eprintln("pylon: cannot write " + pylon_home() + "/known_hosts"); return 1; }
    println("pinned " + host_token(host, o.port) + " " + h.host.alg + " " + h.fingerprint);
    return 0;
}

// Pasted bytes as text: printable ASCII kept, every other byte a space.
Str pasted(List(Int) b, Int i, Str acc) {
    if (i >= b.len()) { return acc; }
    return pasted(b, i + 1, acc + if (b[i] > 32 && b[i] < 127) { str_from_code(b[i]) } else { " " });
}

@requires(network)
List(Int) read_stdin(Int n, List(Int) acc) {
    if (acc.len() >= n) { return acc; }
    List(Int) more = resid_read_some(n - acc.len());
    if (more.len() == 0) { return acc; }
    return read_stdin(n, acc.concat(more));
}

// pylon sshfp HOST: what DNSSEC-validated DNS says of HOST's SSHFP
// records; 0 when the answer is secure, 1 otherwise.
@requires(network, filesystem(readonly), environment, clock(readonly))
Int cmd_sshfp(Opts o) {
    if (o.rest.len() != 1) { return usage(); }
    if (name_from_text(o.rest[0]).len() == 0) { eprintln("pylon: " + o.rest[0] + " is not a DNS name"); return 2; }
    Verdict v = sshfp_lookup(o.rest[0], dnssec_anchors(), clock.now_sec());
    println(verdict_line(v));
    _ = print_lines(sshfp_lines(v), 0);
    return if (v.state == "secure") { 0 } else { 1 };
}

// What DNS says of an unpinned host's SSHFP records, or no_dns() for an
// address literal.
@requires(network, filesystem(readonly), environment, clock(readonly))
Verdict dns_for(Str host) {
    if (name_from_text(host).len() == 0) { return no_dns(); }
    return sshfp_lookup(host, dnssec_anchors(), clock.now_sec());
}

@requires(network, filesystem, environment, declassify, terminal, clock)
Int cmd_run(Opts o, Int via) {
    if (o.rest.len() < 1) { return usage(); }
    if (o.fwds.len() > 0 && (!o.no_cmd || o.rest.len() != 1)) { eprintln("pylon: -L, -D and -R run a forwarding-only session: give -N and no COMMAND"); return 2; }
    List(Fwd) fs = parse_fwds(o.fwds, 0, []);
    if (fs.len() != o.fwds.len()) { return 2; }
    Bool interactive = o.rest.len() == 1 && !o.no_cmd;
    if (o.no_cmd && o.fwds.len() == 0) { eprintln("pylon: -N needs at least one -L, -D or -R"); return 2; }
    Bool app = has_flag(o.pflags, "app");
    if (interactive && !app && !has_flag(o.pflags, "sessions") && !resid_term_is_tty(0)) { eprintln("pylon: an interactive shell needs a terminal; give a COMMAND to run instead"); return 2; }
    List(Str) uh = str_split(o.rest[0], "@");
    HostRest hr = split_host(if (uh.len() == 2) { uh[1] } else { "" });
    if (uh.len() != 2 || str_len(uh[0]) == 0 || str_len(hr.host) == 0 || str_len(hr.rest) > 0) { eprintln("pylon: give the user as USER@HOST (an IPv6 address may be in brackets)"); return 2; }
    Str user = uh[0];
    Str host = hr.host;
    Str command = if (interactive) { "" } else { str_join(o.rest[1..o.rest.len()], " ") };
    Authed a = login(user, host, o, via);
    if (!a.ok) { eprintln("pylon: " + a.why); return 1; }
    if (str_len(o.pylond) > 0 && !o.no_cmd && !interactive) { _ = disconnect(a.c, "done"); eprintln("pylon: --pylond runs a terminal or -N forwards, not a COMMAND"); return 2; }
    if (str_len(o.pylond) > 0) { return run_pylon(a.c, host, fs, o.pylond, interactive, !o.no_obfuscate, o.pflags, via < 0); }
    if (o.no_cmd) { return run_forwards(a.c, fs); }
    Chan ch = open_session(a.c);
    if (str_len(ch.err) > 0) { eprintln("pylon: " + ch.err); return 1; }
    Chan done = if (interactive) { run_shell(ch, if (app) { "xterm-256color" } else { environment.get("TERM") }, !o.no_obfuscate, app) } else { pump(exec(ch, command)) };
    if (str_len(done.err) > 0) { eprintln("pylon: " + done.err); return 1; }
    _ = disconnect(done.c, "done");
    return if (done.status >= 0 && done.status < 256) { done.status } else { 255 };
}

// Connect, verify the host under its pins, and authenticate through the
// agent: the steps every command shares. Not ok, with the reason, on any
// failure (the connection is closed then).
@requires(network, filesystem, environment, declassify, clock(readonly))
Authed login(Str user, Str host, Opts o, Int via) {
    List(List(Int)) pinned = pinned_for(host_token(host, o.port));
    Int agent = agent_connect();
    Conn none = conn_new(-1);
    if (agent == -1) { return Authed {.c = none, .ok = false, .why = "no agent (set SSH_AUTH_SOCK to Symbolon's agent)"}; }
    List(Ident) ids = agent_ids(agent);
    // In the Android app an unreachable Symbolon also answers with nothing.
    Str nokeys = if (environment.get("PYLON_AGENT") == "app") { "Symbolon offered no keys: it holds none, or Pylon cannot reach it (Pylon must be installed after Symbolon)" } else { "the agent holds no keys" };
    if (ids.len() == 0) { return Authed {.c = none, .ok = false, .why = nokeys}; }
    // A host with no pin: what DNSSEC-validated SSHFP records say (SPEC 6.1.2).
    Verdict dv = if (pinned.len() == 0) { dns_for(host) } else { no_dns() };
    Conn c0 = if (via >= 0) { piped(via) } else { dial(host, o.port) };
    if (!conn_ok(c0)) { return Authed {.c = c0, .ok = false, .why = c0.err}; }
    // Test hooks: rekey sooner than SPEC 5's limits (never later).
    Conn c = rekey_limits(c0, env_int("PYLON_TEST_SSH_REKEY_BYTES"), env_int("PYLON_TEST_SSH_REKEY_PACKETS"), env_int("PYLON_TEST_SSH_REKEY_SECS"));
    Handshake h = handshake(c, Trust {.pinned = pinned, .probe = false, .cas = cas_for(host), .name = host, .now = clock.now_sec(), .dns = dv}, o.no_strict);
    Str token = host_token(host, o.port);
    if (!conn_ok(h.c)) {
        _ = resid_tcp_close(c.fd);
        Bool changed = str_contains(h.c.err, "HOST KEY HAS CHANGED");
        Bool sshfp_bad = str_contains(h.c.err, "DOES NOT MATCH THE HOST'S DNSSEC-SIGNED SSHFP");
        _ = if (changed) { history("refused", token, h.fingerprint, "a key other than the pinned one") } else { true };
        _ = if (sshfp_bad) { history("refused", token, h.fingerprint, "a key its DNSSEC-signed SSHFP records do not name") } else { true };
        return Authed {.c = h.c, .ok = false, .why = if (changed) { h.c.err + pin_details(pins_for(token), 0, "") } else { h.c.err }};
    }
    _ = if (!h.c.strict) { eprintln_true(no_strict_warning(host)) } else { true };
    // Accepted through SSHFP: pin it, so that later changes follow 6.2.
    List(Int) plain = plain_key_blob(h.c.host_blob);
    Bool by_dns = pinned.len() == 0 && sshfp_match(dv, plain) == "match";
    _ = if (by_dns) { pin(token, plain, "sshfp") && history("sshfp", token, fingerprint(plain), "DNSSEC-validated in " + name_text(dv.zone)) } else { true };
    _ = if (by_dns) { eprintln_true("pylon: " + host + " was not pinned; its key " + fingerprint(plain) + " matches its DNSSEC-validated SSHFP record (zone " + name_text(dv.zone) + "), so Pylon pinned it.") } else { true };
    Authed a = authenticate(h.c, agent, user, ids, host, o.port);
    _ = resid_unix_close(agent);
    if (!a.ok) { _ = disconnect(a.c, "authentication failed"); return a; }
    // Session traffic may idle for a long time: no read deadline now.
    _ = resid_tcp_deadline(a.c.fd, 0);
    return a;
}

Bool eprintln_true(Str s) { eprintln(s); return true; }

@requires(environment)
Int env_int(Str name) {
    Str v = environment.get(name);
    return if (str_is_int(v)) { str_parse_int(v) } else { 0 };
}

// SPEC 5's exception for a server without strict key exchange, shown
// every time it is used.
Str no_strict_warning(Str host) {
    return "pylon: WARNING: " + host + " does not support strict key exchange (the Terrapin fix), and\n"
        + "       --allow-no-strict let the connection proceed without it. An attacker on the path\n"
        + "       can truncate the start of the encrypted stream (Terrapin-style prefix truncation).";
}

// What was pinned, when and from which device (SPEC 6.2).
Str pin_details(List(Pin) ps, Int i, Str acc) {
    if (i >= ps.len()) { return acc; }
    Str when = if (str_len(ps[i].when) > 0) { " on " + ps[i].when } else { "" };
    Str by = if (str_len(ps[i].by) > 0) { " from " + ps[i].by } else { "" };
    return pin_details(ps, i + 1, acc + "\nPinned: " + fingerprint(ps[i].blob) + when + by);
}

// pylon authorize [-p PORT] [--ca] USER@HOST [KEY-LINE...|-]: log in
// with the agent's keys and have HOST add the keys given (or, with none,
// the agent's own) to the account's authorized_keys, appending only, and
// repair what makes sshd ignore that file (core/authorize.resid). With
// --ca the keys are CAs whose certificates for USER are accepted. With
// --app (the app runs it) the report goes out as frames of type 1.
@requires(network, filesystem, environment, declassify, clock)
Int cmd_authorize(Opts o, Int via) {
    if (o.rest.len() < 1) { return usage(); }
    Bool app = has_flag(o.pflags, "app");
    Bool ca = has_flag(o.pflags, "ca");
    List(Str) uh = str_split(o.rest[0], "@");
    HostRest hr = split_host(if (uh.len() == 2) { uh[1] } else { "" });
    if (uh.len() != 2 || str_len(uh[0]) == 0 || str_len(hr.host) == 0 || str_len(hr.rest) > 0) { eprintln("pylon: give the user as USER@HOST (an IPv6 address may be in brackets)"); return 2; }
    Str user = uh[0];
    if (ca && !principal_ok(user)) { eprintln("pylon: --ca needs a user name of letters, digits and . _ - @"); return 2; }
    List(Str) given = if (o.rest.len() == 2 && o.rest[1] == "-") { str_split(text_of(read_stdin(65536, [])), "\n") } else { o.rest[1..o.rest.len()] };
    List(KeyLine) named = key_lines(given, 0, []);
    KeyLine bad = first_bad(named, 0);
    if (str_len(bad.err) > 0) { eprintln("pylon: " + bad.err); return 2; }
    if (ca && named.len() == 0) { eprintln("pylon: --ca needs the CA's public key line"); return 2; }
    List(KeyLine) ks = if (named.len() > 0) { named } else { agent_lines() };
    if (ks.len() == 0) { eprintln("pylon: no key to add (the agent holds none Pylon can read; give KEY-LINEs)"); return 1; }
    Authed a = login(user, hr.host, o, via);
    if (!a.ok) { eprintln("pylon: " + a.why); return 1; }
    Chan ch = open_session(a.c);
    if (str_len(ch.err) > 0) { eprintln("pylon: " + ch.err); return 1; }
    // The script goes to sh on standard input: no quoting layer between.
    Chan run = send_eof(send_data(capturing(exec(ch, "sh")), bytes_of(authorize_script(ks, ca, user))));
    Chan done = pump(run);
    if (str_len(done.err) > 0) { eprintln("pylon: " + done.err); return 1; }
    _ = disconnect(done.c, "done");
    List(Str) rep = report_of(kept(done));
    _ = say_all(rep, 0, app);
    if (done.status != 0 || !rep.contains("done")) {
        eprintln("pylon: " + hr.host + "'s shell did not finish adding the keys" + (if (done.status > 0) { " (exit status " + f"{done.status}" + ")" } else { "" }) + "; what it said is above");
        return 1;
    }
    return 0;
}

Str text_of(List(Int) b) { return display_text(b); }

List(KeyLine) key_lines(List(Str) ls, Int i, List(KeyLine) acc) {
    if (i >= ls.len()) { return acc; }
    Bool blank = str_len(str_trim(ls[i])) == 0 || str_starts_with(str_trim(ls[i]), "#");
    return key_lines(ls, i + 1, if (blank) { acc } else { acc.concat([key_line_of(ls[i])]) });
}

KeyLine first_bad(List(KeyLine) ks, Int i) {
    if (i >= ks.len()) { return KeyLine {.alg = "", .blob = [], .comment = "", .err = ""}; }
    if (str_len(ks[i].err) > 0) { return ks[i]; }
    return first_bad(ks, i + 1);
}

// The agent's plain keys (not its certificates), as key lines.
@requires(network, environment)
List(KeyLine) agent_lines() {
    Int agent = agent_connect();
    if (agent == -1) { return []; }
    List(Ident) ids = agent_ids(agent);
    _ = if (agent >= 0) { resid_unix_close(agent) } else { true };
    return idents_as_lines(ids, 0, []);
}

List(KeyLine) idents_as_lines(List(Ident) ids, Int i, List(KeyLine) acc) {
    if (i >= ids.len()) { return acc; }
    GotText a = rd_text(rd(ids[i].blob));
    KeyLine k = if (is_cert_alg(a.v)) { KeyLine {.alg = "", .blob = [], .comment = "", .err = "certificate"} } else { key_line_of(key_line(ids[i].blob) + " " + ids[i].comment) };
    return idents_as_lines(ids, i + 1, if (str_len(k.err) == 0) { acc.concat([k]) } else { acc });
}

Bool say_all(List(Str) ls, Int i, Bool app) {
    if (i >= ls.len()) { return true; }
    _ = if (app) { print_bytes(app_frame(1, bytes_of(ls[i] + "\n"))) } else { println(ls[i]) };
    return say_all(ls, i + 1, app);
}

// pylon share [-p PORT] HOST: the payload of SPEC 6.1.4 for HOST's pinned
// keys, and the same as a QR code another device scans to pin HOST (it
// still pins only a key the host presents to it).
@requires(filesystem(readonly), environment)
Int cmd_share(Opts o) {
    if (o.rest.len() != 1) { return usage(); }
    Str host = split_host(o.rest[0]).host;
    List(List(Int)) ps = pinned_for(host_token(host, o.port));
    if (ps.len() == 0) { eprintln("pylon: " + host + (if (o.port != 22) { " port " + f"{o.port}" } else { "" }) + " has no pinned key here (pylon pins lists them)"); return 1; }
    Str payload = payload_for(host, o.port, fps_of(ps, 0, []));
    println(payload);
    _ = print_raw(qr_lines(bytes_of(payload)), 0);
    return 0;
}

// Lines Pylon made itself (the QR code's colors and blocks), unescaped.
Bool print_raw(List(Str) ls, Int i) {
    if (i >= ls.len()) { return true; }
    println(ls[i]);
    return print_raw(ls, i + 1);
}

List(Str) fps_of(List(List(Int)) bs, Int i, List(Str) acc) {
    if (i >= bs.len() || acc.len() >= oob_max()) { return acc; }
    return fps_of(bs, i + 1, acc.concat([fingerprint(bs[i])]));
}

// pylon ca [PATTERN 'ALG BASE64']: trust a host CA for names under
// PATTERN (the key obtained out of band), or list the trusted CAs.
@requires(filesystem, environment, clock(readonly))
Int cmd_ca(Opts o) {
    if (o.rest.len() == 0) { _ = print_lines(ca_lines(), 0); return 0; }
    if (o.rest.len() != 2) { return usage(); }
    Str why = add_ca(o.rest[0], o.rest[1]);
    if (str_len(why) > 0) { eprintln("pylon: " + why); return 1; }
    println("trusting the CA for " + str_to_lower(o.rest[0]));
    return 0;
}

// pylon history [HOST[:PORT]]: what happened to pins (SPEC 6.2).
@requires(filesystem(readonly), environment)
Int cmd_history(Opts o) {
    Str token = if (o.rest.len() == 1) { if (str_contains(o.rest[0], ":")) { str_to_lower(o.rest[0]) } else { host_token(o.rest[0], o.port) } } else { "" };
    List(Str) ls = history_lines(token);
    _ = print_lines(ls, 0);
    return if (ls.len() == 0) { 1 } else { 0 };
}

Bool print_lines(List(Str) ls, Int i) {
    if (i >= ls.len()) { return true; }
    println(display_text(bytes_of(ls[i])));
    return print_lines(ls, i + 1);
}

// "USER@HOST:PATH" split, or user "" when malformed.
type Remote = { Str user; Str host; Str path; };

Remote parse_remote(Str s) {
    List(Str) uh = str_split(s, "@");
    if (uh.len() != 2 || str_len(uh[0]) == 0) { return Remote {.user = "", .host = "", .path = ""}; }
    // An IPv6 host is in brackets here: USER@[ADDR]:PATH.
    HostRest hr = split_host(uh[1]);
    if (str_len(hr.host) == 0 || str_len(hr.rest) < 2) { return Remote {.user = "", .host = "", .path = ""}; }
    return Remote {.user = uh[0], .host = hr.host, .path = str_slice(hr.rest, 1, str_len(hr.rest))};
}

// pylon get [-p PORT] [--force] USER@HOST:REMOTE LOCAL
@requires(network, filesystem, environment, declassify, clock)
Int cmd_get(Opts o, Int via) {
    if (o.rest.len() != 2) { return usage(); }
    Remote r = parse_remote(o.rest[0]);
    Str local = o.rest[1];
    if (str_len(r.user) == 0) { eprintln("pylon: give the source as USER@HOST:PATH"); return 2; }
    Bool resume = has_flag(o.pflags, "resume");
    if (resume && str_len(o.pylond) == 0) { eprintln("pylon: --resume needs --pylond (SFTP transfers start over)"); return 2; }
    if (filesystem.exists(local) && !o.force && !resume) { eprintln("pylon: " + local + " exists; not replaced (use --force to replace it" + (if (str_len(o.pylond) > 0) { ", or --resume to continue it" } else { "" }) + ")"); return 1; }
    if (filesystem.is_dir(local)) { eprintln("pylon: " + local + " is a directory"); return 1; }
    Authed a = login(r.user, r.host, o, via);
    if (!a.ok) { eprintln("pylon: " + a.why); return 1; }
    if (str_len(o.pylond) > 0) { return pylon_transfer(a.c, r, local, 0, resume && filesystem.exists(local), o, via < 0); }
    Sftp s = sftp_start(open_session(a.c));
    if (str_len(s.err) > 0) { eprintln("pylon: " + s.err); return 1; }
    Copied c = get_file(s, r.path, local);
    if (str_len(c.s.err) > 0) { eprintln("pylon: " + c.s.err); return 1; }
    _ = disconnect(c.s.ch.c, "done");
    eprintln("pylon: " + f"{c.bytes}" + " bytes to " + local);
    return 0;
}

// pylon put [-p PORT] LOCAL USER@HOST:REMOTE
@requires(network, filesystem, environment, declassify, clock)
Int cmd_put(Opts o, Int via) {
    if (o.rest.len() != 2) { return usage(); }
    Str local = o.rest[0];
    Remote r = parse_remote(o.rest[1]);
    if (str_len(r.user) == 0) { eprintln("pylon: give the destination as USER@HOST:PATH"); return 2; }
    if (!filesystem.exists(local) || filesystem.is_dir(local)) { eprintln("pylon: " + local + " is not a file"); return 1; }
    Bool resume = has_flag(o.pflags, "resume");
    if (resume && str_len(o.pylond) == 0) { eprintln("pylon: --resume needs --pylond (SFTP transfers start over)"); return 2; }
    Authed a = login(r.user, r.host, o, via);
    if (!a.ok) { eprintln("pylon: " + a.why); return 1; }
    if (str_len(o.pylond) > 0) { return pylon_transfer(a.c, r, local, 1, resume, o, via < 0); }
    Sftp s = sftp_start(open_session(a.c));
    if (str_len(s.err) > 0) { eprintln("pylon: " + s.err); return 1; }
    // Read in pieces as it is sent (the Pylon protocol reads it itself).
    Copied c = put_local(s, local, bytes_of(r.path), true);
    if (str_len(c.s.err) > 0) { eprintln("pylon: " + c.s.err); return 1; }
    _ = disconnect(c.s.ch.c, "done");
    eprintln("pylon: " + f"{c.bytes}" + " bytes to " + r.host + ":" + display_text(bytes_of(r.path)));
    return 0;
}

// pylon sftp [-p PORT] USER@HOST[:DIR]: the interactive file browser
// (cli/sftp_shell.resid), or with --app its framed requests for the app.
// Always over SSH: the Pylon protocol carries whole-file transfers only.
@requires(network, filesystem, environment, declassify, terminal, clock)
Int cmd_sftp(Opts o, Int via) {
    if (o.rest.len() != 1) { return usage(); }
    if (str_len(o.pylond) > 0) { eprintln("pylon: sftp runs over SSH (--pylond carries get and put)"); return 2; }
    Bool app = has_flag(o.pflags, "app");
    List(Str) uh = str_split(o.rest[0], "@");
    HostRest hr = split_host(if (uh.len() == 2) { uh[1] } else { "" });
    Bool has_dir = str_len(hr.rest) > 0;
    if (uh.len() != 2 || str_len(uh[0]) == 0 || str_len(hr.host) == 0 || (has_dir && !str_starts_with(hr.rest, ":"))) { eprintln("pylon: give the server as USER@HOST or USER@HOST:DIR"); return 2; }
    Authed a = login(uh[0], hr.host, o, via);
    if (!a.ok) { eprintln("pylon: " + a.why); return 1; }
    Sftp s = sftp_start(open_session(a.c));
    if (str_len(s.err) > 0) { eprintln("pylon: " + s.err); return 1; }
    if (app) { return sftp_app(s); }
    return sftp_shell(s, if (has_dir) { bytes_of(str_slice(hr.rest, 1, str_len(hr.rest))) } else { [] });
}

// get (op 0) or put (1) over the Pylon protocol: a resumable transfer
// (core/files.resid). --resume continues a transfer that stopped: only
// the chunks the other side lacks are sent, and the whole file's hash is
// checked at the end.
@requires(network, filesystem, environment, declassify, clock)
Int pylon_transfer(Conn c, Remote r, Str local, Int op, Bool resume, Opts o, Bool direct) {
    if (!path_ok(bytes_of(r.path))) { _ = disconnect(c, "done"); eprintln("pylon: the Pylon protocol (v1) takes remote paths of printable ASCII only"); return 2; }
    List(UInt(8)) data = if (op == 1 || resume) { filesystem.read_bytes_u8(local) } else { [] };
    if (data.len() > file_max()) { _ = disconnect(c, "done"); eprintln("pylon: " + local + " is larger than 64 MiB (the Pylon protocol v1 limit)"); return 1; }
    Up u = pylon_up(c, r.host, o.pylond, o.pflags, direct);
    if (u.code >= 0) { return u.code; }
    eprintln("pylon: Pylon protocol session to " + addr_port(u.l.addr, u.l.port) + " (experimental); SSH closed");
    Str st = environment.get("PYLON_TEST_STOP_AFTER");
    Fx x = pylon_file(file_start(u.l, u.rk, watch_new(u.l), op, resume, r.path, local, data, if (str_is_int(st)) { str_parse_int(st) } else { 0 }, clock.monotonic_ns()));
    if (str_len(x.err) > 0) { eprintln("pylon: " + x.err); return 1; }
    Str whence = if (x.start > 0) { " (resumed at " + f"{x.start}" + ")" } else { "" };
    eprintln("pylon: " + f"{x.size}" + " bytes to " + (if (op == 0) { local } else { r.host + ":" + display_text(bytes_of(r.path)) }) + whence);
    return 0;
}

// pylond delivered, started and bootstrapped over the verified SSH
// connection (closed then), and the UDP handshake done: the link and its
// rekeying state, or code >= 0 (the message printed) when that failed.
type Up = { Link l; Rk rk; Int rebind; Int code; };

@requires(network, filesystem, environment, declassify, clock)
Up pylon_up(Conn c, Str host, Str path, List(Str) pflags, Bool direct) {
    List(Secret(UInt(8))) e = [];
    Link none = link_new(false, -1, [], 0, SessionKeys {.ok = false, .tx = e, .rx = e, .my_idx = 0, .their_idx = 0}, 0);
    Rk none_rk = rk_new(boot_finish(boot_client_new(), []), static_new(), 0);
    // The link goes where the verified SSH connection went: the address
    // (IPv6 or IPv4) the host name or literal reached. Through a jump host
    // that connection ends at the local pipe, so the host must then be an
    // address literal, reached directly.
    List(Int) peer = if (direct) { resid_tcp_peer(c.fd) } else { [] };
    List(Int) addr = if (direct) { if (dg_ok(peer)) { dg_addr(peer) } else { [] } } else { ip_literal(host) };
    if (addr.len() == 0) {
        eprintln(if (direct) { "pylon: cannot tell which address the SSH connection reached" } else { "pylon: through a jump host, the Pylon protocol (v1) needs the host as an IP address" });
        return Up {.l = none, .rk = none_rk, .rebind = 0, .code = 2};
    }
    // A directory holds one build per machine type: pylond-x86_64, pylond-aarch64.
    Bool dir = filesystem.is_dir(path);
    Arch ar = if (dir) { host_arch(c) } else { Arch {.c = c, .arch = "", .err = ""} };
    if (str_len(ar.err) > 0) { eprintln("pylon: " + ar.err); return Up {.l = none, .rk = none_rk, .rebind = 0, .code = 1}; }
    Bool plain = ar.arch == "x86_64" || ar.arch == "aarch64";
    if (dir && !plain) { eprintln("pylon: no pylond for this host's machine type (" + display_text(bytes_of(ar.arch)) + ")"); return Up {.l = none, .rk = none_rk, .rebind = 0, .code = 2}; }
    Str file = if (dir) { path + "/pylond-" + ar.arch } else { path };
    if (!filesystem.exists(file)) { eprintln("pylon: no pylond at " + file); return Up {.l = none, .rk = none_rk, .rebind = 0, .code = 2}; }
    List(Int) bin = filesystem.read_bytes(file);
    Str hash = hex_encode(sha256_bytes(bin));
    // The release check (SPEC 8.2): signed by the release quorum, in the
    // log, not a rollback; before anything is sent to the host.
    if (!pylond_vetted(if (dir) { path } else { dir_of(path) }, if (dir) { ar.arch } else { "" }, hash, pflags)) { _ = disconnect(ar.c, "done"); return Up {.l = none, .rk = none_rk, .rebind = 0, .code = 1}; }
    Pushed p = push_pylond(ar.c, bin, hash);
    if (str_len(p.err) > 0) { eprintln("pylon: " + p.err); return Up {.l = none, .rk = none_rk, .rebind = 0, .code = 1}; }
    Started st = start_pylond_b(p.c, hash, 600, has_flag(pflags, "ephemeral"), has_flag(pflags, "allow-unconfined"), environment.get("PYLON_TEST_BUSY") == "1");
    if (str_len(st.err) > 0) { eprintln("pylon: " + st.err); return Up {.l = none, .rk = none_rk, .rebind = 0, .code = 1}; }
    _ = disconnect(st.c, "pylond started");
    Int udp = resid_udp_open();
    SessionKeys k = connect_udp(udp, addr, st.b.port, st.b, st.bc.c, 5);
    if (!k.ok) { eprintln("pylon: no handshake with pylond on UDP port " + f"{st.b.port}"); return Up {.l = none, .rk = none_rk, .rebind = 0, .code = 1}; }
    Str rb = environment.get("PYLON_TEST_REBIND_AFTER");
    Str rks = environment.get("PYLON_TEST_REKEY_SECS");
    Rk rk = rk_new(st.b, st.bc.c, if (str_is_int(rks) && str_parse_int(rks) > 0) { str_parse_int(rks) * 1000000000 } else { 120000000000 });
    return Up {.l = link_new(false, udp, addr, st.b.port, k, clock.monotonic_ns()), .rk = rk, .rebind = if (str_is_int(rb)) { str_parse_int(rb) } else { 0 }, .code = -1};
}

// Whether the pylond with `hash` (the `arch` build, "" for any) may be
// pushed: its release in `dir` verifies (core/release_gate.resid), or the
// developer said not to check (--pylond-unverified), which is announced.
@requires(filesystem, environment)
Bool pylond_vetted(Str dir, Str arch, Str hash, List(Str) pflags) {
    if (has_flag(pflags, "pylond-unverified")) {
        eprintln("pylon: WARNING: pushing an unverified pylond (--pylond-unverified): no release signatures, transparency log or rollback check");
        return true;
    }
    Str roots = flag_value(pflags, "roots=");
    ReleaseVerdict v = release_gate(dir, proof_file(dir), arch, hash, roots);
    if (!v.ok) {
        eprintln("pylon: refusing to push pylond: " + v.why);
        eprintln("pylon: (a local build of pylond: --pylond-roots ROOTS with a release signed by your own keys, or --pylond-unverified)");
        return false;
    }
    if (str_len(roots) > 0) { eprintln("pylon: WARNING: pylond release checked against the roots in " + roots + " (--pylond-roots), not the pinned release keys"); }
    eprintln("pylon: pylond " + v.version + " (release " + f"{v.counter}" + "): signed by " + f"{v.signed}" + " release keys, entry " + f"{v.index}" + " of the log's " + f"{v.size}");
    return true;
}

// The value of the first flag that starts with `key` ("" for none).
Str flag_value(List(Str) fs, Str key) {
    if (fs.len() == 0) { return ""; }
    if (str_starts_with(fs[0], key)) { return str_slice(fs[0], str_len(key), str_len(fs[0])); }
    return flag_value(fs[1..fs.len()], key);
}

// pylon pylond-check DIR [PROOF]: check the release in DIR as a push
// would, for every build it holds, with PROOF in place of the bundled
// DIR/pylond.proof (a newer one, fetched from where the log is published,
// moves the newest log head seen forward).
@requires(filesystem, environment)
Int cmd_pylond_check(Opts o) {
    if (o.rest.len() < 1 || o.rest.len() > 2) { return usage(); }
    Str dir = o.rest[0];
    Str proof = if (o.rest.len() == 2) { o.rest[1] } else { proof_file(dir) };
    return check_builds(dir, proof, flag_value(o.pflags, "roots="), ["aarch64", "x86_64"], 0, 0);
}

@requires(filesystem, environment)
Int check_builds(Str dir, Str proof, Str roots, List(Str) archs, Int i, Int seen) {
    if (i >= archs.len()) {
        if (seen == 0) { eprintln("pylon: no pylond-aarch64 or pylond-x86_64 in " + dir); return 1; }
        return 0;
    }
    Str f = dir + "/pylond-" + archs[i];
    if (!filesystem.exists(f)) { return check_builds(dir, proof, roots, archs, i + 1, seen); }
    Str hash = hex_encode(sha256_bytes(filesystem.read_bytes(f)));
    ReleaseVerdict v = release_gate(dir, proof, archs[i], hash, roots);
    if (!v.ok) { eprintln("pylon: pylond-" + archs[i] + ": " + v.why); return 1; }
    println("pylond-" + archs[i] + " " + v.version + " (release " + f"{v.counter}" + "): signed by " + f"{v.signed}" + " release keys, entry " + f"{v.index}" + " of the log's " + f"{v.size}");
    return check_builds(dir, proof, roots, archs, i + 1, seen + 1);
}

// --pylond FILE: a terminal (no -N), or -N -L forwards, over the Pylon
// protocol (EXPERIMENTAL, SPEC 9). FILE is the pylond binary, delivered
// over the verified SSH connection and checked by its hash on the host;
// the SSH connection closes once pylond has answered the bootstrap.
@requires(network, filesystem, environment, declassify, clock, terminal)
Int run_pylon(Conn c, Str host, List(Fwd) fs, Str path, Bool shell0, Bool obfuscate, List(Str) pflags, Bool direct) {
    Bool sessions = has_flag(pflags, "sessions");
    Bool shell = shell0 && !sessions;
    Up u = pylon_up(c, host, path, pflags, direct);
    if (u.code >= 0) { return u.code; }
    List(Fwd) ls = listen_local(fs, 0, []);
    if (ls.len() != fs.len()) { eprintln("pylon: cannot listen on a local port"); return 1; }
    Link l0 = listen_remote(u.l, ls, 0, 0);
    if (str_len(l0.err) > 0) { eprintln("pylon: " + l0.err); return 1; }
    eprintln("pylon: Pylon protocol session to " + addr_port(u.l.addr, u.l.port) + " (experimental); SSH closed");
    _ = announce(ls, 0);
    Rk rk = u.rk;
    Int rebind_after = u.rebind;
    if (sessions) {
        Listed ls0 = list_sessions(l0, 0, clock.monotonic_ns());
        if (!ls0.ok) { eprintln("pylon: pylond did not list its sessions"); return 1; }
        if (sessions) { _ = print_sessions(ls0.items, 0); return 0; }
    }
    if (shell) {
        Bool app = has_flag(pflags, "app");
        Int cols = if (app) { 80 } else { resid_term_cols() };
        Int rows = if (app) { 24 } else { resid_term_rows() };
        Str want = flag_value(pflags, "session=");
        Bool pickup = has_flag(pflags, "attach") || str_len(want) > 0;
        Listed found = if (pickup) { list_sessions(l0, 0, clock.monotonic_ns()) } else { Listed {.l = l0, .ok = false, .items = []} };
        _ = if (pickup && !found.ok) { eprintln("pylon: pylond did not list its sessions; starting a new shell") } else { true };
        Int asked = if (str_len(want) > 0) { str_parse_int(want) } else { -1 };
        Int pick = if (asked >= 0) { if (listed(found.items, asked, 0)) { asked } else { -1 } } else { detached(found.items, 0) };
        _ = if (asked >= 0 && pick < 0 && found.ok) { eprintln("pylon: session " + want + " is no longer on the host (its shell ended, or pylond restarted); starting a new shell") } else { true };
        _ = if (pick >= 0) { eprintln("pylon: attaching to session " + f"{pick}") } else { true };
        Link l1 = if (pick >= 0) { attach(found.l, pick, rows, cols, clock.monotonic_ns()) } else { open_shell(found.l, rows, cols, clock.monotonic_ns()) };
        _ = if (app) { print_bytes(app_frame(4, [])) } else { resid_term_raw() };
        Int code = pylon_shell(Sh {.l = l1, .sid = l1.next_sid - 2, .rows = rows, .cols = cols, .in_eof = false, .k = keys_new(obfuscate), .rebind = rebind_after, .rk = rk, .app = App {.on = app, .buf = []},
            .w = watch_new(l1), .session = pick, .asks = 0, .asked = 0}, ls);
        _ = if (app) { false } else { resid_term_restore() };
        return code;
    }
    Link done = pylon_forwards(l0, ls, rebind_after, rk, watch_new(l0));
    eprintln("pylon: " + done.err);
    return 1;
}

List(Fwd) parse_fwds(List(Str) specs, Int i, List(Fwd) acc) {
    if (i >= specs.len()) { return acc; }
    Str flag = str_slice(specs[i], 0, 1);
    Str spec = str_slice(specs[i], 2, str_len(specs[i]));
    Int kind = if (flag == "D") { 1 } else { if (flag == "R") { 2 } else { 0 } };
    Fwd f = parse_fwd(kind, spec);
    Str want = if (kind == 1) { "[127.0.0.1:]PORT" } else { if (kind == 2) { "[localhost:]REMOTEPORT:HOST:HOSTPORT" } else { "[127.0.0.1:]PORT:HOST:HOSTPORT" } };
    if (f.lport == 0) { eprintln("pylon: bad -" + flag + " " + spec + " (want " + want + "; only loopback binds)"); return acc; }
    return parse_fwds(specs, i + 1, acc.concat([f]));
}

@requires(network, declassify, clock(readonly))
Int run_forwards(Conn c, List(Fwd) fs) {
    Mux m = mux_new(c, fs);
    if (str_len(m.err) > 0) { eprintln("pylon: " + m.err); return 1; }
    _ = announce(fs, 0);
    Mux done = serve(m, 0);
    eprintln("pylon: " + done.err);
    return 1;
}

Bool announce(List(Fwd) fs, Int i) {
    if (i >= fs.len()) { return true; }
    Str line = if (fs[i].kind == 1) { "pylon: SOCKS5 on 127.0.0.1:" + f"{fs[i].lport}" + " (connections go out from the server)" }
        else { if (fs[i].kind == 2) { "pylon: the server's localhost:" + f"{fs[i].lport}" + " -> " + fs[i].host + ":" + f"{fs[i].hport}" + " (from here)" }
        else { "pylon: forwarding 127.0.0.1:" + f"{fs[i].lport}" + " -> " + fs[i].host + ":" + f"{fs[i].hport}" + " (via the server)" } };
    eprintln(line);
    return announce(fs, i + 1);
}

// The shell on a pty, with the local terminal in raw mode for its whole
// life: restored on every way out (the runtime also restores it at exit
// and on an abort).
@requires(network, declassify, terminal, clock(readonly))
Chan run_shell(Chan ch, Str term0, Bool obfuscate, Bool app) {
    Str term = if (str_len(term0) > 0 && str_len(term0) < 64) { term0 } else { "xterm-256color" };
    Int cols = if (app) { 80 } else { resid_term_cols() };
    Int rows = if (app) { 24 } else { resid_term_rows() };
    Chan s = shell(ch, term, cols, rows);
    if (!chan_ok(s)) { return s; }
    _ = if (app) { print_bytes(app_frame(4, [])) } else { resid_term_raw() };
    Chan done = interact(if (app) { capturing(s) } else { s }, cols, rows, false, keys_new(obfuscate), App {.on = app, .buf = []});
    _ = if (app) { false } else { resid_term_restore() };
    return done;
}

@requires(network, filesystem, environment, declassify, terminal, clock)
Int dispatch(Str verb, Opts o, Int via) {
    if (verb == "pin") { return cmd_pin(o, via); }
    if (verb == "history") { return cmd_history(o); }
    if (verb == "get") { return cmd_get(o, via); }
    if (verb == "put") { return cmd_put(o, via); }
    if (verb == "sftp") { return cmd_sftp(o, via); }
    if (verb == "authorize") { return cmd_authorize(o, via); }
    return cmd_run(o, via);
}

// The target's host as each command names it.
Str target_host(Str verb, Opts o) {
    Str spec = if (verb == "pin") { if (o.rest.len() == 1) { oob_parse(o.rest[0]).host } else { if (o.rest.len() > 0) { o.rest[0] } else { "" } } }
        else { if (verb == "put") { if (o.rest.len() > 1) { o.rest[1] } else { "" } } else { if (o.rest.len() > 0) { o.rest[0] } else { "" } } };
    List(Str) uh = str_split(spec, "@");
    return split_host(if (uh.len() == 2) { uh[1] } else { spec }).host;
}

// -J USER@JUMP[:PORT]: log in to the jump host, open a pipe, relay it to
// the target through a direct-tcpip channel on a second thread, and run
// the command over the pipe. The region ends when the command's session
// closes its end of the pipe.
@requires(network, filesystem, environment, declassify, terminal, clock)
Int via_jump(Str verb, Opts o) {
    List(Str) uh = str_split(o.jump, "@");
    HostRest jh = split_host(if (uh.len() == 2) { uh[1] } else { "" });
    Str ps = if (str_len(jh.rest) > 1) { str_slice(jh.rest, 1, str_len(jh.rest)) } else { "" };
    Bool okp = str_len(jh.rest) == 0 || (str_is_int(ps) && str_parse_int(ps) > 0 && str_parse_int(ps) < 65536);
    if (uh.len() != 2 || str_len(uh[0]) == 0 || str_len(jh.host) == 0 || !okp) { eprintln("pylon: give the jump host as USER@HOST[:PORT] (USER@[ADDR]:PORT for IPv6)"); return 2; }
    Int jport = if (str_len(jh.rest) > 0) { str_parse_int(ps) } else { 22 };
    Str target = target_host(verb, o);
    if (str_len(target) == 0) { return usage(); }
    // --allow-no-strict is for the target named on the command line only:
    // a jump host always needs strict key exchange.
    Opts jo = Opts {.port = jport, .no_strict = false, .no_obfuscate = o.no_obfuscate, .no_cmd = false, .force = false, .jump = "", .pylond = "", .pflags = o.pflags, .fwds = [], .rest = [], .err = ""};
    Authed ja = login(uh[0], jh.host, jo, -1);
    Str scope = if (o.no_strict && str_contains(ja.why, "strict key exchange")) { "\n       (--allow-no-strict applies only to the target host, never to a jump host)" } else { "" };
    if (!ja.ok) { eprintln("pylon: jump host " + jh.host + ": " + ja.why + scope); return 1; }
    Pipe p = pipe_pair();
    if (str_len(p.err) > 0) { eprintln("pylon: " + p.err); return 1; }
    Conn jc = ja.c;
    Int pa = p.a;
    Int tport = o.port;
    Result(Int, RegionError) r = spawn (network, declassify, clock(readonly)) { return relay(jc, pa, target, tport); };
    Int rc = dispatch(verb, o, p.b);
    _ = resid_tcp_shutdown(p.b);
    _ = resid_tcp_close(p.b);
    Int rr = match r { Ok(v) => v, Err(e) => 1 };
    return if (rc != 0) { rc } else { rr };
}

@requires(args, network, filesystem, environment, declassify, terminal, clock)
Int main() {
    Str verb = if (args.count() > 1) { args.get(1) } else { "" };
    Bool sub = verb == "pylond-check" || verb == "pin" || verb == "authorize" || verb == "share" || verb == "get" || verb == "put" || verb == "sftp" || verb == "history" || verb == "ca" || verb == "pins" || verb == "sshfp";
    Opts o = parse(if (sub) { 2 } else { 1 }, Opts {.port = 22, .no_strict = false, .no_obfuscate = false, .no_cmd = false, .force = false, .jump = "", .pylond = "", .pflags = [], .fwds = [], .rest = [], .err = ""});
    if (str_len(o.err) > 0) { eprintln("pylon: " + o.err); return usage(); }
    if (verb == "history") { return cmd_history(o); }
    if (verb == "ca") { return cmd_ca(o); }
    if (verb == "pylond-check") { return cmd_pylond_check(o); }
    if (verb == "pins") { _ = print_lines(pin_lines(), 0); return 0; }
    if (verb == "sshfp") { return cmd_sshfp(o); }
    if (verb == "share") { return cmd_share(o); }
    if (str_len(o.jump) > 0) { return via_jump(verb, o); }
    return dispatch(verb, o, -1);
}

// Whether pylond listed session `id`.
Bool listed(List(List(Int)) items, Int id, Int i) {
    if (i >= items.len()) { return false; }
    return items[i][0] == id || listed(items, id, i + 1);
}

Bool has_flag(List(Str) fs, Str f) {
    if (fs.len() == 0) { return false; }
    return fs[0] == f || has_flag(fs[1..fs.len()], f);
}
