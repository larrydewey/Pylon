// pylond: the Pylon protocol's server end (SPEC 8, 9, 10). EXPERIMENTAL.
//
//   pylond serve --run DIR [--idle SECONDS] [--keep SECONDS] [--ephemeral]
//                [--allow-unconfined]
//
// Started by `pylon` over a verified SSH channel, as the principal. It
// reads the bootstrap hello on standard input and writes the bootstrap
// reply on standard output, then never writes to the SSH channel again.
//
// One session daemon per principal (SPEC 10.3). The first `pylond serve`
// becomes it: it binds UDP on the address the SSH connection arrived on
// (SSH_CONNECTION; never the wildcard address) and listens on a Unix
// socket in DIR, which must be the principal's own 0700 directory (the
// runtime checks), accepting only the same user. A later `pylond serve` (a new SSH login: the principal signed for
// it) hands its hello to the daemon over that socket, passes the reply
// back, and exits; the daemon then serves that client too. So re-attaching
// from any device always takes a fresh login, and with it a fresh
// signature (SPEC 10.4).
//
// The daemon answers only handshakes that carry a valid mac1 (keyed by
// one of its clients' bootstrap secrets) and a timestamp newer than that
// client's last one; every other datagram is dropped without a reply.
//
// Terminals: a SHELL request starts the principal's login shell ($SHELL
// -l, TERM=xterm-256color) on a new pseudo-terminal; ATTACH joins a kept
// one, its screen repainted from the emulator's model; LIST answers with
// the sessions. A client silent for 15 minutes is dropped and its
// terminals detach, still running. The daemon exits (hanging up any
// terminals) once no client has been heard from for --keep seconds
// (default 7 days) while terminals run, or --idle seconds (default 600)
// when none do; with --ephemeral, 60 seconds after its last client went.
//
// Confinement (SPEC 8.4): before it reads a single datagram the daemon
// forks a PTY broker (the only process that can start the login shell, a
// fixed command; it hands back masters), starts the file helper
// (`pylond xfer`, the only process that touches files: beneath $HOME,
// never a hidden name, on the daemon's request over a socket) and
// confines itself: Landlock leaves no file writable or creatable anywhere
// and only /etc readable, and a seccomp filter leaves only the system
// calls of its event loop, so it can execute nothing. On a kernel without
// Landlock it refuses to serve unless --allow-unconfined (the client's
// per-host exception) is given. The shells themselves run outside the
// confinement, as a login shell should; what that leaves a compromised
// daemon is in SPEC 8.4.
//
//   pylond xfer SOCKET                 the file helper (started by serve)
//   pylond check-confinement FILE      applies the daemon's confinement to
//                                      itself, then tries FILE (tests)

import "crypto.resid";
import "../core/wire.resid";
import "../core/cipher.resid";
import "../core/proto.resid";
import "../core/link.resid";
import "../core/term.resid";
import "../core/files.resid";
import "../core/addr.resid";

@requires(network)
List(Int) read_stdin(Int n, List(Int) acc) {
    if (acc.len() >= n) { return acc; }
    List(Int) more = resid_read_some(n - acc.len());
    if (more.len() == 0) { return acc; }
    return read_stdin(n, acc.concat(more));
}

// The principal's shell: $SHELL when it is an absolute path of plain
// characters (it is split on spaces to run, never given to a shell),
// else /bin/sh.
@requires(environment)
Str login_shell() {
    Str sh = environment.get("SHELL");
    Bool plain = str_starts_with(sh, "/") && !str_contains(sh, " ") && str_len(sh) < 256;
    return if (plain) { sh } else { "/bin/sh" };
}

// The server's address on the SSH connection, from SSH_CONNECTION
// ("client_ip client_port server_ip server_port"); "" when absent.
@requires(environment)
Str server_addr() {
    List(Str) p = str_split(str_trim(environment.get("SSH_CONNECTION")), " ");
    return if (p.len() == 4) { p[2] } else { "" };
}

// The daemon's control socket, per server address (a daemon serves the
// address it bound) and protocol version.
Str ctl_path(Str dir, Str addr) { return dir + "/ctl-v1-" + str_replace(addr, ":", "_") + ".sock"; }

Int peer_ns() { return 900000000000; }          // 15 minutes
Int ephemeral_ns() { return 60000000000; }

// A client: its bootstrap, mac1 key, link once it shook hands, last
// handshake timestamp, an id for the terminals it holds, and the loopback
// ports it asked pylond to listen on ([port, listening socket]).
type Peer = { Int id; Boot b; List(Int) mk; Bool linked; Link l; List(Int) stamp; Int born; List(List(Int)) lsn; };

// A terminal: id, the client and stream it is attached to (-1 when
// detached), the pseudo-terminal's master, the shell's pid, the screen as
// the emulator sees it (to repaint a client that attaches), and when it
// was last attached.
type Tty = { Int id; Int peer; Int sid; Int fd; Int pid; Term t; Int seen; };

// A file transfer (core/files.resid): the client and stream, get (0) or
// put (1), the path as the client named it, the stage (0 starting, 1 moving bytes, 2 ending), the
// bytes to send and how many are sent; for a put, the size of the file as
// it was (for --resume), where the new bytes start, the size and hash promised, how
// many bytes were written, and the first error.
type Xf = { Int peer; Int sid; Int op; Str path; Int stage; List(Int) out; Int sent; Int have; Int start; Int size; List(Int) hash; Int wrote; Str err; };

// Load (SPEC 9.4): the cookie secret and the one before it (replaced
// every two minutes), and how many handshakes were answered in the
// current one-second window. Past 8 a second (or always, with the test
// hook) an init must carry a valid mac2 or gets a cookie instead.
type Ck = { List(Int) cur; List(Int) prev; Int rotated; Int win; Int count; Bool always; };

@requires(declassify)
Ck ck_new(Bool always, Int now) { return Ck {.cur = random_bytes(32), .prev = random_bytes(32), .rotated = now, .win = now, .count = 0, .always = always}; }

@requires(declassify)
Ck ck_tick(Ck c, Int now) {
    Bool rot = now - c.rotated > 120000000000;
    Bool fresh = now - c.win > 1000000000;
    return Ck {.cur = if (rot) { random_bytes(32) } else { c.cur }, .prev = if (rot) { c.cur } else { c.prev }, .rotated = if (rot) { now } else { c.rotated },
        .win = if (fresh) { now } else { c.win }, .count = if (fresh) { 0 } else { c.count }, .always = c.always};
}

Ck ck_count(Ck c) { return Ck {.cur = c.cur, .prev = c.prev, .rotated = c.rotated, .win = c.win, .count = c.count + 1, .always = c.always}; }

type Srv = { Static s; Int udp; Int port; Int ctl; List(Peer) peers; List(Tty) ttys; Int next_id; Int broker;
    Int idle_ns; Int keep_ns; Bool ephemeral; Int last_client; Int xfer; List(Xf) xfs; Ck ck; };

Srv sv_peers(Srv v, List(Peer) ps) {
    return Srv {.s = v.s, .udp = v.udp, .port = v.port, .ctl = v.ctl, .peers = ps, .ttys = v.ttys, .next_id = v.next_id, .broker = v.broker,
        .idle_ns = v.idle_ns, .keep_ns = v.keep_ns, .ephemeral = v.ephemeral, .last_client = v.last_client, .xfer = v.xfer, .xfs = v.xfs, .ck = v.ck};
}

Srv sv_ttys(Srv v, List(Tty) ts) {
    return Srv {.s = v.s, .udp = v.udp, .port = v.port, .ctl = v.ctl, .peers = v.peers, .ttys = ts, .next_id = v.next_id, .broker = v.broker,
        .idle_ns = v.idle_ns, .keep_ns = v.keep_ns, .ephemeral = v.ephemeral, .last_client = v.last_client, .xfer = v.xfer, .xfs = v.xfs, .ck = v.ck};
}

Srv sv_next(Srv v, Int next_id) {
    return Srv {.s = v.s, .udp = v.udp, .port = v.port, .ctl = v.ctl, .peers = v.peers, .ttys = v.ttys, .next_id = next_id, .broker = v.broker,
        .idle_ns = v.idle_ns, .keep_ns = v.keep_ns, .ephemeral = v.ephemeral, .last_client = v.last_client, .xfer = v.xfer, .xfs = v.xfs, .ck = v.ck};
}

Srv sv_xfs(Srv v, List(Xf) xs) {
    return Srv {.s = v.s, .udp = v.udp, .port = v.port, .ctl = v.ctl, .peers = v.peers, .ttys = v.ttys, .next_id = v.next_id, .broker = v.broker,
        .idle_ns = v.idle_ns, .keep_ns = v.keep_ns, .ephemeral = v.ephemeral, .last_client = v.last_client, .xfer = v.xfer, .xfs = xs, .ck = v.ck};
}

Srv sv_ck(Srv v, Ck c) {
    return Srv {.s = v.s, .udp = v.udp, .port = v.port, .ctl = v.ctl, .peers = v.peers, .ttys = v.ttys, .next_id = v.next_id, .broker = v.broker,
        .idle_ns = v.idle_ns, .keep_ns = v.keep_ns, .ephemeral = v.ephemeral, .last_client = v.last_client, .xfer = v.xfer, .xfs = v.xfs, .ck = c};
}

Srv sv_seen(Srv v, Int t) {
    return Srv {.s = v.s, .udp = v.udp, .port = v.port, .ctl = v.ctl, .peers = v.peers, .ttys = v.ttys, .next_id = v.next_id, .broker = v.broker,
        .idle_ns = v.idle_ns, .keep_ns = v.keep_ns, .ephemeral = v.ephemeral, .last_client = t, .xfer = v.xfer, .xfs = v.xfs, .ck = v.ck};
}

Peer pr_link(Peer p, Link l) { return Peer {.id = p.id, .b = p.b, .mk = p.mk, .linked = p.linked, .l = l, .stamp = p.stamp, .born = p.born, .lsn = p.lsn}; }
Peer pr_lsn(Peer p, List(List(Int)) lsn) { return Peer {.id = p.id, .b = p.b, .mk = p.mk, .linked = p.linked, .l = p.l, .stamp = p.stamp, .born = p.born, .lsn = lsn}; }

Tty ty_attach(Tty t, Int peer, Int sid, Int now) { return Tty {.id = t.id, .peer = peer, .sid = sid, .fd = t.fd, .pid = t.pid, .t = t.t, .seen = now}; }
Tty ty_term(Tty t, Term m) { return Tty {.id = t.id, .peer = t.peer, .sid = t.sid, .fd = t.fd, .pid = t.pid, .t = m, .seen = t.seen}; }

Int peer_at(List(Peer) ps, Int id, Int i) {
    if (i >= ps.len()) { return -1; }
    if (ps[i].id == id) { return i; }
    return peer_at(ps, id, i + 1);
}

Int tty_at(List(Tty) ts, Int id, Int i) {
    if (i >= ts.len()) { return -1; }
    if (ts[i].id == id) { return i; }
    return tty_at(ts, id, i + 1);
}

Int tty_of(List(Tty) ts, Int peer, Int sid, Int i) {
    if (i >= ts.len()) { return -1; }
    if (ts[i].peer == peer && ts[i].sid == sid) { return i; }
    return tty_of(ts, peer, sid, i + 1);
}

List(Peer) put_peer(List(Peer) ps, Int i, Peer p) { return ps[0..i].concat([p]).concat(ps[i + 1..ps.len()]); }
List(Tty) put_tty(List(Tty) ts, Int i, Tty t) { return ts[0..i].concat([t]).concat(ts[i + 1..ts.len()]); }

// Is stamp a newer than b (big-endian, same length)?
Bool newer(List(Int) a, List(Int) b, Int i) {
    if (b.len() == 0) { return true; }
    if (i >= a.len()) { return false; }
    if (a[i] != b[i]) { return a[i] > b[i]; }
    return newer(a, b, i + 1);
}

// ============================================================================
// Clients joining: bootstrap over the control socket, handshakes over UDP
// ============================================================================

@requires(declassify)
Srv add_peer(Srv v, Boot b, Int now) {
    List(Secret(UInt(8))) none = [];
    SessionKeys k0 = SessionKeys {.ok = false, .tx = none, .rx = none, .my_idx = -1, .their_idx = 0};
    Peer p = Peer {.id = v.next_id, .b = b, .mk = mac1_key(b.s_pub, b.psk), .linked = false, .l = link_new(true, v.udp, [0, 0, 0, 0], 0, k0, now), .stamp = [], .born = now, .lsn = []};
    return sv_next(sv_peers(v, v.peers.concat([p])), v.next_id + 1);
}

// The control socket: a hello from a later `pylond serve` of the same user.
@requires(network, declassify)
Srv control(Srv v, Bool ready, Int now) {
    if (!ready) { return v; }
    Int c = resid_unix_accept_now(v.ctl);
    if (c < 0) { return v; }
    _ = resid_unix_deadline(c, 3000);
    List(Int) hello = recv_n(c, boot_hello_len(), []);
    BootS served = boot_serve(hello, v.s, v.port);
    _ = if (served.boot.ok) { resid_unix_send(c, served.reply) } else { false };
    _ = resid_unix_close(c);
    return if (served.boot.ok) { add_peer(v, served.boot, now) } else { v };
}

@requires(network)
List(Int) recv_n(Int fd, Int n, List(Int) acc) {
    if (acc.len() >= n) { return acc; }
    List(Int) more = resid_unix_recv_some(fd, n - acc.len());
    if (more.len() == 0) { return acc; }
    return recv_n(fd, n, acc.concat(more));
}

// A handshake initiation: answered for the client whose mac1 key it
// carries, when its timestamp is newer than that client's last; that
// client's link then uses the new keys (its streams carry on).
@requires(network, declassify)
Srv handshake(Srv v, List(Int) d, Int now) {
    List(Int) pkt = dg_body(d);
    if (pkt.len() != init_len() || pkt[0] != 1) { return v; }
    Int i = mac1_peer(v.peers, pkt, 0);
    if (i < 0) { return v; }
    Peer p = v.peers[i];
    // Under load: no asymmetric work without a cookie for this source.
    Ck c = ck_tick(v.ck, now);
    List(Int) src = dg_src(d);
    Bool load = c.always || c.count >= 8;
    Bool ok2 = mac2_ok(cookie_of(c.cur, src), pkt) || mac2_ok(cookie_of(c.prev, src), pkt);
    if (load && !ok2) {
        _ = resid_udp_send_to(v.udp, dg_addr(d), dg_port(d), cookie_reply(cookie_key(p.b.s_pub, p.b.psk), pkt, cookie_of(c.cur, src)));
        return sv_ck(v, c);
    }
    Answered a = hs_respond(p.b, v.s, pkt);
    if (!a.keys.ok || !newer(a.stamp, p.stamp, 0)) { return sv_ck(v, ck_count(c)); }
    Int port = dg_port(d);
    _ = resid_udp_send_to(v.udp, dg_addr(d), port, a.resp);
    Peer p2 = Peer {.id = p.id, .b = p.b, .mk = p.mk, .linked = true, .l = link_rekeyed(p.l, dg_addr(d), port, a.keys, now), .stamp = a.stamp, .born = p.born, .lsn = p.lsn};
    return sv_ck(sv_seen(sv_peers(v, put_peer(v.peers, i, p2)), now), ck_count(c));
}

Int mac1_peer(List(Peer) ps, List(Int) pkt, Int i) {
    if (i >= ps.len()) { return -1; }
    if (mac1_ok(ps[i].mk, pkt)) { return i; }
    return mac1_peer(ps, pkt, i + 1);
}

// Every waiting datagram: to the client whose keys it is for, or a handshake.
@requires(network, declassify)
Srv datagrams(Srv v, Int now, Int budget) {
    if (budget <= 0) { return v; }
    List(Int) d = resid_udp_recv_from(v.udp, 2048);
    if (d.len() == 0) { return v; }
    if (!dg_ok(d)) { return datagrams(v, now, budget - 1); }
    Int i = link_peer(v.peers, d, 0);
    Srv n = if (i >= 0) { sv_seen(sv_peers(v, put_peer(v.peers, i, pr_link(v.peers[i], link_input(v.peers[i].l, d, now)))), now) } else { handshake(v, d, now) };
    return datagrams(n, now, budget - 1);
}

Int link_peer(List(Peer) ps, List(Int) d, Int i) {
    if (i >= ps.len()) { return -1; }
    if (ps[i].linked && for_link(ps[i].l, d)) { return i; }
    return link_peer(ps, d, i + 1);
}

// ============================================================================
// Terminals
// ============================================================================

// Each client's events: terminals asked for, attaches, resizes, lists.
@requires(network, declassify, process, clock(readonly))
Srv on_events(Srv v, Int i, Int now) {
    if (i >= v.peers.len()) { return v; }
    Peer p = v.peers[i];
    Ev e = events(p.l);
    Srv a = sv_peers(v, put_peer(v.peers, i, pr_link(p, events_taken(p.l))));
    Srv b = start_ttys(a, i, e.shells, 0, now);
    Srv c = attaches(b, i, e.attaches, 0, now);
    Srv d = resizes(c, p.id, e.resizes, 0);
    Srv f = lists(d, i, e.lists, 0, now);
    Srv g = listens(f, i, e.listens, 0, now);
    Srv h = files(g, i, e.files, 0, now);
    return on_events(h, i + 1, now);
}

// ============================================================================
// Files (core/files.resid)
// ============================================================================

// FILE: a get or put of a path the principal named. The daemon touches no
// file itself (its Landlock domain has none): the file helper (xfer_main)
// resolves the path, refuses one outside $HOME or hidden, and does the
// reads and writes. A put asks it at once for what is there (to resume).
@requires(network, declassify)
Srv files(Srv v, Int pi, List(List(Int)) req, Int i, Int now) {
    if (i >= req.len()) { return v; }
    Peer p = v.peers[pi];
    Int sid = req[i][0];
    List(Int) pb = req[i][3..req[i].len()];
    Bool ok = (req[i][1] == 0 || req[i][1] == 1) && path_ok(pb);
    if (!ok) { return files(sv_peers(v, put_peer(v.peers, pi, pr_link(p, refuse(p.l, sid, now)))), pi, req, i + 1, now); }
    Str path = ascii_text(pb);
    Bool put = req[i][1] == 1;
    List(Int) r = if (put) { xcall(v.xfer, xfer_req(2, path, [req[i][2] & 1])) } else { [0] };
    Bool lost = r.len() == 0;
    // A put-open answer: 0 | size (8) | count (4) | hashes; the client gets 0 | count | hashes.
    Bool good = !lost && r[0] == 0 && r.len() >= 13;
    List(Int) out = if (!put) { [] } else { if (good) { [0].concat(r[9..r.len()]) } else { if (lost) { refusal("the file helper is gone") } else { r } } };
    Xf x = Xf {.peer = p.id, .sid = sid, .op = req[i][1], .path = path, .stage = if (put && !good) { 2 } else { 0 }, .out = out, .sent = 0,
        .have = if (good) { be64_at(r, 1) } else { 0 }, .start = 0, .size = 0, .hash = [], .wrote = 0, .err = ""};
    Srv v0 = if (lost) { xfer_lost(v) } else { v };
    Srv v1 = sv_peers(v0, put_peer(v0.peers, pi, pr_link(p, confirm(p.l, sid, now))));
    return files(sv_xfs(v1, v1.xfs.concat([x])), pi, req, i + 1, now);
}

// The helper went away or stopped answering: its socket is closed, and
// every later transfer is refused.
@requires(network)
Srv xfer_lost(Srv v) {
    _ = if (v.xfer >= 0) { resid_unix_close(v.xfer) } else { false };
    return Srv {.s = v.s, .udp = v.udp, .port = v.port, .ctl = v.ctl, .peers = v.peers, .ttys = v.ttys, .next_id = v.next_id, .broker = v.broker,
        .idle_ns = v.idle_ns, .keep_ns = v.keep_ns, .ephemeral = v.ephemeral, .last_client = v.last_client, .xfer = -1, .xfs = v.xfs, .ck = v.ck};
}

// One request to the file helper and its answer; empty when the helper
// is gone or silent for two minutes (the caller then drops it).
@requires(network)
List(Int) xcall(Int fd, List(Int) req) {
    if (fd < 0) { return []; }
    if (!send_all(fd, u32_be(req.len()).concat(req), 0)) { return []; }
    List(Int) h = recv_full(fd, 4, [], 120000);
    if (h.len() != 4) { return []; }
    Int n = be32(h, 0);
    if (n < 1 || n > file_max() + 65536) { return []; }
    List(Int) b = recv_full(fd, n, [], 120000);
    return if (b.len() == n) { b } else { [] };
}

// All of b on a Unix socket, a megabyte at a time.
@requires(network)
Bool send_all(Int fd, List(Int) b, Int at) {
    if (at >= b.len()) { return true; }
    Int n = min(b.len() - at, 1048576);
    if (!resid_unix_send(fd, b[at..at + n])) { return false; }
    return send_all(fd, b, at + n);
}

// n bytes from a Unix socket, waiting at most ms for each piece; fewer at
// the end of the connection or on silence.
@requires(network)
List(Int) recv_full(Int fd, Int n, List(Int) acc, Int ms) {
    if (acc.len() >= n) { return acc; }
    List(Int) r = resid_tcp_poll([fd], [1], ms);
    if (r.len() == 0 || (r[0] & 1) == 0) { return acc; }
    List(Int) more = resid_unix_recv_some(fd, min(n - acc.len(), 1048576));
    if (more.len() == 0) { return acc; }
    return recv_full(fd, n, acc.concat(more), ms);
}

// An answer's message: "" for 0, else the refusal's text.
Str answer_err(List(Int) r) {
    if (r.len() == 0) { return "the file helper is gone"; }
    return if (r[0] == 0) { "" } else { ascii_text(r[1..r.len()]) };
}

Xf xf_out(Xf x, Int stage, List(Int) out, Int sent) {
    return Xf {.peer = x.peer, .sid = x.sid, .op = x.op, .path = x.path, .stage = stage, .out = out, .sent = sent, .have = x.have, .start = x.start, .size = x.size, .hash = x.hash, .wrote = x.wrote, .err = x.err};
}

Xf xf_put(Xf x, Int start, Int size, List(Int) hash, Int wrote, Str err) {
    return Xf {.peer = x.peer, .sid = x.sid, .op = x.op, .path = x.path, .stage = x.stage, .out = x.out, .sent = x.sent, .have = x.have, .start = start, .size = size, .hash = hash, .wrote = wrote, .err = err};
}

// Every transfer one step: requests read, bytes written or sent, ends
// sent. A transfer whose client or stream is gone is forgotten (a put
// leaves what it wrote: --resume continues it).
@requires(network, declassify)
Srv xfers(Srv v, Int i, Int now) {
    if (i >= v.xfs.len()) { return v; }
    Xf x = v.xfs[i];
    Int pi = peer_at(v.peers, x.peer, 0);
    if (pi < 0 || !open_sid(v.peers[pi].l, x.sid) || x.stage == 3) { return xfers(sv_xfs(v, v.xfs[0..i].concat(v.xfs[i + 1..v.xfs.len()])), i, now); }
    XL a = if (x.op == 0) { get_step(v.peers[pi].l, x, v.xfer, now) } else { put_step(v.peers[pi].l, x, v.xfer, false, now) };
    // What is due to the client, within the stream's window.
    Int n = min(min(room(a.l, x.sid), 65536), a.x.out.len() - a.x.sent);
    Link l1 = if (n > 0) { push_bytes(a.l, x.sid, a.x.out[a.x.sent..a.x.sent + n], now) } else { a.l };
    Bool end = a.x.stage == 2 && a.x.sent + n >= a.x.out.len();
    Link l2 = if (end) { push_eof(l1, x.sid, -1, now) } else { l1 };
    Xf x2 = xf_out(a.x, if (end) { 3 } else { a.x.stage }, a.x.out, a.x.sent + n);
    Srv v0 = if (a.lost) { xfer_lost(v) } else { v };
    Srv v1 = sv_peers(v0, put_peer(v0.peers, pi, pr_link(v0.peers[pi], l2)));
    return xfers(sv_xfs(v1, v1.xfs[0..i].concat([x2]).concat(v1.xfs[i + 1..v1.xfs.len()])), i + 1, now);
}

type XL = { Link l; Xf x; Bool lost; };

// get: once the client's hashes have all come (its FIN), the helper's answer.
@requires(network)
XL get_step(Link l, Xf x, Int fd, Int now) {
    if (x.stage != 0 || !peer_ended(l, x.sid)) { return XL {.l = l, .x = x, .lost = false}; }
    List(Int) hs = inbox(l, x.sid);
    Bool well = hs.len() % 32 == 0 && hs.len() <= 65536;
    List(Int) r = if (well) { xcall(fd, xfer_req(1, x.path, hs)) } else { refusal("malformed request") };
    List(Int) out = if (r.len() == 0) { refusal("the file helper is gone") } else { r };
    return XL {.l = take_inbox(l, x.sid, hs.len()), .x = xf_out(x, 2, out, 0), .lost = r.len() == 0};
}

// put: the client's header (start, size, hash), then its bytes appended
// to the file, then the check of the whole file against the hash (each
// done by the helper).
@requires(network)
XL put_step(Link l, Xf x, Int fd, Bool lost, Int now) {
    List(Int) in = inbox(l, x.sid);
    Bool ended = peer_ended(l, x.sid);
    if (x.stage == 2) { return XL {.l = take_inbox(l, x.sid, in.len()), .x = x, .lost = lost}; }
    if (x.stage == 0 && in.len() < 48) {
        return if (ended) { XL {.l = l, .x = xf_out(x, 2, x.out.concat(refusal("malformed request")), x.sent), .lost = lost} } else { XL {.l = l, .x = x, .lost = lost} };
    }
    if (x.stage == 0) {
        Int start = be64_at(in, 0);
        Int size = be64_at(in, 8);
        Bool fits = start % file_chunk() == 0 && start <= x.have && start <= size && size <= file_max();
        List(Int) r = if (fits) { xcall(fd, xfer_req(3, x.path, u64_be(start))) } else { [0] };
        Str err = if (!fits) { "malformed request" } else { answer_err(r) };
        Xf x1 = xf_out(xf_put(x, start, size, in[16..48], 0, err), 1, x.out, x.sent);
        return put_step(take_inbox(l, x.sid, 48), x1, if (r.len() == 0) { -1 } else { fd }, lost || r.len() == 0, now);
    }
    // Stage 1: bytes to the file (none past the size promised), 8 KiB or
    // the rest at a time, so the helper is asked once per few datagrams,
    // not once per datagram. Not more: every datagram that arrives while
    // the bytes wait is appended by copying those already held (a 64 KiB
    // batch copies about 2 MB per chunk). That costs time, not memory:
    // pylond stays near 20 MB through a 40 MB put at either size; the
    // memory a large put took was the client's (core/pyclient.resid,
    // put_head).
    if (!ended && in.len() < 8192) { return XL {.l = l, .x = x, .lost = lost}; }
    Bool over = x.start + x.wrote + in.len() > x.size;
    List(Int) r = if (in.len() == 0 || str_len(x.err) > 0 || over) { [0] } else { xcall(fd, xfer_req(4, x.path, in)) };
    Str err = if (str_len(x.err) > 0) { x.err } else { if (over) { "more bytes than promised" } else { answer_err(r) } };
    Bool lost1 = lost || r.len() == 0;
    Xf x1 = xf_put(x, x.start, x.size, x.hash, x.wrote + in.len(), err);
    Link l1 = take_inbox(l, x.sid, in.len());
    if (!ended || inbox(l1, x.sid).len() > 0) { return XL {.l = l1, .x = x1, .lost = lost1}; }
    List(Int) c = if (str_len(err) == 0) { xcall(fd, xfer_req(5, x.path, u64_be(x.size).concat(x.hash))) } else { refusal(err) };
    List(Int) verdict = if (c.len() == 0) { refusal("the file helper is gone") } else { c };
    return XL {.l = l1, .x = xf_out(x1, 2, x1.out.concat(verdict), x1.sent), .lost = lost1 || c.len() == 0};
}

// ============================================================================
// The file helper: `pylond xfer SOCKET`
// ============================================================================

// Started by the daemon (on a pseudo-terminal from resid_pty_spawn, the
// one way the runtime offers to start a process) before the daemon
// confines itself; it connects back to SOCKET, confines itself to $HOME
// (Landlock, every right but execute, and the same seccomp filter), and
// answers the daemon's requests (core/files.resid, xfer_answer) until the
// daemon goes. It never reads the network.
@requires(args, network, environment, filesystem)
Int xfer_main() {
    if (args.count() != 3) { return 2; }
    Int c = resid_unix_connect(args.get(2));
    if (c < 0) { return 1; }
    Str home = environment.get("HOME");
    List(Str) none = [];
    Int conf = resid_sandbox_confine(if (str_len(home) > 1) { [home] } else { none }, none);
    if (conf < 0) { return 1; }
    return xfer_loop(c, home);
}

@requires(network, filesystem)
Int xfer_loop(Int c, Str home) {
    // Wait for a request however long the daemon is quiet; then all of it.
    List(Int) r = resid_tcp_poll([c], [1], 3600000);
    if (r.len() == 0 || (r[0] & 1) == 0) { return xfer_loop(c, home); }
    List(Int) h = recv_full(c, 4, [], 30000);
    if (h.len() != 4) { return 0; }
    Int n = be32(h, 0);
    if (n < 3 || n > file_max() + 65536) { return 1; }
    List(Int) req = recv_full(c, n, [], 30000);
    if (req.len() != n) { return 0; }
    List(Int) a = xfer_answer(home, req);
    if (!send_all(c, u32_be(a.len()).concat(a), 0)) { return 0; }
    return xfer_loop(c, home);
}

// The helper, started and connected; -1 when it could not be. The daemon
// listens at path, starts `pylond xfer path` (the running binary, through
// /proc/self/exe), and takes the one connection that comes from that
// process; the socket file is gone again before the daemon confines itself.
@requires(network, process)
Int start_xfer(Str path) {
    Int l = resid_unix_listen(path);
    if (l < 0) { return -1; }
    List(Int) sp = resid_pty_spawn("/proc/self/exe xfer " + path, 24, 80);
    Int c = if (sp.len() == 2) { accept_from(l, sp[1], 50) } else { -1 };
    _ = resid_unix_close(l);
    return c;
}

// A connection on l from process pid, waiting up to n tenths of a second.
@requires(network)
Int accept_from(Int l, Int pid, Int n) {
    if (n <= 0) { return -1; }
    List(Int) r = resid_tcp_poll([l], [1], 100);
    Int c = if (r.len() == 1 && (r[0] & 1) != 0) { resid_unix_accept_now(l) } else { -2 };
    if (c < 0) { return accept_from(l, pid, n - 1); }
    List(Int) who = resid_unix_peer(c);
    if (who.len() == 3 && who[0] == pid) { return c; }
    _ = resid_unix_close(c);
    return accept_from(l, pid, n - 1);
}

// ============================================================================
// Remote forwards (-R)
// ============================================================================

// LISTEN: a socket on the server's loopback port (never another address).
// A port this client holds already is confirmed again (the answer was
// lost); one another client of the same principal holds moves to this
// one (that client went away without a word, as with ATTACH); at most 16
// per client.
@requires(network, declassify)
Srv listens(Srv v, Int pi, List(List(Int)) req, Int i, Int now) {
    if (i >= req.len()) { return v; }
    Int port = req[i][0];
    Peer p = v.peers[pi];
    Bool mine = lsn_at(p.lsn, port, 0) >= 0;
    Int other = holder(v.peers, port, 0);
    Srv v1 = if (!mine && other >= 0 && other != pi) { sv_peers(v, put_peer(v.peers, other, pr_lsn(v.peers[other], lsn_without(v.peers[other].lsn, port, 0, [])))) } else { v };
    Int moved = if (!mine && other >= 0 && other != pi) { v.peers[other].lsn[lsn_at(v.peers[other].lsn, port, 0)][1] } else { -1 };
    Bool can = port >= 1 && port <= 65535 && p.lsn.len() < 16;
    Int fd = if (mine || moved >= 0 || !can) { moved } else { resid_tcp_listen(port) };
    Bool ok = mine || fd >= 0;
    Peer p1 = v1.peers[pi];
    Peer p2 = pr_link(pr_lsn(p1, if (fd >= 0) { p1.lsn.concat([[port, fd]]) } else { p1.lsn }), answer_listen(p1.l, port, ok, now));
    return listens(sv_peers(v1, put_peer(v1.peers, pi, p2)), pi, req, i + 1, now);
}

Int lsn_at(List(List(Int)) ls, Int port, Int i) {
    if (i >= ls.len()) { return -1; }
    if (ls[i][0] == port) { return i; }
    return lsn_at(ls, port, i + 1);
}

List(List(Int)) lsn_without(List(List(Int)) ls, Int port, Int i, List(List(Int)) acc) {
    if (i >= ls.len()) { return acc; }
    return lsn_without(ls, port, i + 1, if (ls[i][0] == port) { acc } else { acc.concat([ls[i]]) });
}

// The client holding a port, or -1.
Int holder(List(Peer) ps, Int port, Int i) {
    if (i >= ps.len()) { return -1; }
    if (lsn_at(ps[i].lsn, port, 0) >= 0) { return i; }
    return holder(ps, port, i + 1);
}

// Every listening socket, as [fd, port] in poll order.
List(List(Int)) all_lsn(List(Peer) ps, Int i, List(List(Int)) acc) {
    if (i >= ps.len()) { return acc; }
    return all_lsn(ps, i + 1, acc.concat(swap(ps[i].lsn, 0, [])));
}

List(List(Int)) swap(List(List(Int)) ls, Int i, List(List(Int)) acc) {
    if (i >= ls.len()) { return acc; }
    return swap(ls, i + 1, acc.concat([[ls[i][1], ls[i][0]]]));
}

List(Int) firsts(List(List(Int)) ls, Int i, List(Int) acc) {
    if (i >= ls.len()) { return acc; }
    return firsts(ls, i + 1, acc.concat([ls[i][0]]));
}

// A connection on a listening socket that polled ready: a stream toward
// the client holding the port now (CONNECT), or closed when none does.
@requires(network, declassify)
Srv accepts(Srv v, List(List(Int)) ls, List(Int) ready, Int at, Int i, Int now) {
    if (i >= ls.len()) { return v; }
    Bool r = at + i < ready.len() && (ready[at + i] & 1) != 0;
    Int pi = if (r) { holder_fd(v.peers, ls[i][0], 0) } else { -1 };
    if (pi < 0 || !v.peers[pi].linked) { return accepts(v, ls, ready, at, i + 1, now); }
    Int fd = resid_tcp_accept_now(ls[i][0]);
    if (fd < 0) { return accepts(v, ls, ready, at, i + 1, now); }
    _ = resid_tcp_deadline(fd, 0);
    Peer p = v.peers[pi];
    return accepts(sv_peers(v, put_peer(v.peers, pi, pr_link(p, connect_back(p.l, fd, ls[i][1], now)))), ls, ready, at, i + 1, now);
}

Int holder_fd(List(Peer) ps, Int fd, Int i) {
    if (i >= ps.len()) { return -1; }
    if (has_fd(ps[i].lsn, fd, 0)) { return i; }
    return holder_fd(ps, fd, i + 1);
}

Bool has_fd(List(List(Int)) ls, Int fd, Int i) {
    if (i >= ls.len()) { return false; }
    return ls[i][1] == fd || has_fd(ls, fd, i + 1);
}

// A client dropped: its listening sockets closed.
@requires(network)
Bool close_lsn(List(List(Int)) ls, Int i) {
    if (i >= ls.len()) { return true; }
    _ = resid_tcp_close(ls[i][1]);
    return close_lsn(ls, i + 1);
}

@requires(network, declassify, process)
Srv start_ttys(Srv v, Int pi, List(List(Int)) req, Int i, Int now) {
    if (i >= req.len()) { return v; }
    Peer p = v.peers[pi];
    List(Int) sp = resid_pty_open(v.broker, req[i][1], req[i][2]);
    if (sp.len() != 2) { return start_ttys(sv_peers(v, put_peer(v.peers, pi, pr_link(p, refuse(p.l, req[i][0], now)))), pi, req, i + 1, now); }
    Tty t = Tty {.id = v.next_id, .peer = p.id, .sid = req[i][0], .fd = sp[0], .pid = sp[1], .t = term_new(req[i][1], req[i][2]), .seen = now};
    return start_ttys(sv_next(sv_ttys(v, v.ttys.concat([t])), v.next_id + 1), pi, req, i + 1, now);
}

// ATTACH: the terminal moves to this client (a client holding it loses
// it: its stream is reset), is resized, and its screen is repainted.
@requires(network, declassify, process)
Srv attaches(Srv v, Int pi, List(List(Int)) req, Int i, Int now) {
    if (i >= req.len()) { return v; }
    Peer p = v.peers[pi];
    Int sid = req[i][0];
    Int k = tty_at(v.ttys, req[i][1], 0);
    if (k < 0) { return attaches(sv_peers(v, put_peer(v.peers, pi, pr_link(p, refuse(p.l, sid, now)))), pi, req, i + 1, now); }
    Tty t = v.ttys[k];
    Srv v1 = release(v, t, now);
    Term m = term_resize(t.t, req[i][2], req[i][3]);
    _ = resid_pty_resize(t.fd, req[i][2], req[i][3]);
    Peer p1 = v1.peers[pi];
    Link l = push_bytes(p1.l, sid, repaint(m, 1000), now);
    Srv v2 = sv_peers(v1, put_peer(v1.peers, pi, pr_link(p1, l)));
    return attaches(sv_ttys(v2, put_tty(v2.ttys, k, ty_attach(ty_term(t, m), p.id, sid, now))), pi, req, i + 1, now);
}

// The client holding a terminal lets go of it (its stream reset).
@requires(network, declassify)
Srv release(Srv v, Tty t, Int now) {
    Int j = peer_at(v.peers, t.peer, 0);
    if (j < 0 || t.sid < 0) { return v; }
    return sv_peers(v, put_peer(v.peers, j, pr_link(v.peers[j], refuse(v.peers[j].l, t.sid, now))));
}

@requires(process)
Srv resizes(Srv v, Int peer, List(List(Int)) rs, Int i) {
    if (i >= rs.len()) { return v; }
    Int k = tty_of(v.ttys, peer, rs[i][0], 0);
    if (k < 0) { return resizes(v, peer, rs, i + 1); }
    _ = resid_pty_resize(v.ttys[k].fd, rs[i][1], rs[i][2]);
    return resizes(sv_ttys(v, put_tty(v.ttys, k, ty_term(v.ttys[k], term_resize(v.ttys[k].t, rs[i][1], rs[i][2])))), peer, rs, i + 1);
}

// SESSIONS for each LIST: the 12 most recently used terminals.
@requires(network, declassify, clock(readonly))
Srv lists(Srv v, Int pi, List(List(Int)) req, Int i, Int now) {
    if (i >= req.len()) { return v; }
    List(Int) body = sessions_body(v.ttys, 0, 0, [], now);
    Peer p = v.peers[pi];
    List(Int) f = [12].concat(u32_be(req[i][0])).concat([min(v.ttys.len(), 12)]).concat(body);
    return lists(sv_peers(v, put_peer(v.peers, pi, pr_link(p, send_frame(p.l, f, now)))), pi, req, i + 1, now);
}

List(Int) sessions_body(List(Tty) ts, Int i, Int n, List(Int) acc, Int now) {
    if (i >= ts.len() || n >= 12) { return acc; }
    Tty t = ts[ts.len() - 1 - i];
    List(Int) title0 = bytes_of(t.t.title);
    List(Int) title = if (title0.len() > 48) { title0[0..48] } else { title0 };
    Int idle = (now - t.seen) / 1000000000;
    List(Int) e = u32_be(t.id).concat([if (t.peer >= 0) { 1 } else { 0 }, (t.t.rows >> 8) & 255, t.t.rows & 255, (t.t.cols >> 8) & 255, t.t.cols & 255])
        .concat(u32_be(if (idle < 0) { 0 } else { idle })).concat([title.len()]).concat(title);
    return sessions_body(ts, i + 1, n + 1, acc.concat(e), now);
}

// Masters to poll.
List(Int) tty_fds(List(Tty) ts, Int i, List(Int) acc) {
    if (i >= ts.len()) { return acc; }
    return tty_fds(ts, i + 1, acc.concat([ts[i].fd]));
}

// Each terminal: its output into the emulator and, when attached, into
// its stream (or, once the shell has exited and its output is drained,
// the stream's end with the exit code); the stream's inbox into the
// terminal. A terminal whose stream its client reset is detached.
@requires(network, declassify, process)
Srv tty_io(Srv v, List(Int) ready, Int at, Int i, Int now) {
    if (i >= v.ttys.len()) { return v; }
    Tty t = v.ttys[i];
    Int pi = if (t.sid >= 0) { peer_at(v.peers, t.peer, 0) } else { -1 };
    Bool attached = pi >= 0 && open_sid(v.peers[pi].l, t.sid);
    Tty t0 = if (attached || t.sid < 0) { t } else { ty_attach(t, -1, -1, now) };
    Bool r = at + i < ready.len() && (ready[at + i] & 9) != 0;
    Int rm = if (attached) { room(v.peers[pi].l, t.sid) } else { 16384 };
    List(Int) out = if (r && rm > 0) { resid_pty_read(t.fd, if (rm < 16384) { rm } else { 16384 }) } else { [] };
    Int code = if (r && out.len() == 0) { resid_pty_status(v.broker, t.pid) } else { -1 };
    Tty t1 = if (out.len() > 0) { ty_term(t0, taken(term_feed(t0.t, out))) } else { t0 };
    if (!attached) {
        if (code >= 0) { _ = resid_pty_close(t.fd); return tty_io(sv_ttys(v, v.ttys[0..i].concat(v.ttys[i + 1..v.ttys.len()])), ready, at + 1, i, now); }
        return tty_io(sv_ttys(v, put_tty(v.ttys, i, t1)), ready, at, i + 1, now);
    }
    Link l1 = push_bytes(v.peers[pi].l, t.sid, out, now);
    List(Int) in = inbox(l1, t.sid);
    Int took = if (in.len() > 0) { resid_pty_write(t.fd, in) } else { 0 };
    Link l2 = take_inbox(l1, t.sid, took);
    Srv v1 = sv_peers(v, put_peer(v.peers, pi, pr_link(v.peers[pi], if (code >= 0) { push_eof(l2, t.sid, code, now) } else { l2 })));
    if (code >= 0) {
        _ = resid_pty_close(t.fd);
        return tty_io(sv_ttys(v1, v1.ttys[0..i].concat(v1.ttys[i + 1..v1.ttys.len()])), ready, at + 1, i, now);
    }
    return tty_io(sv_ttys(v1, put_tty(v1.ttys, i, ty_attach(t1, t1.peer, t1.sid, now))), ready, at, i + 1, now);
}

// ============================================================================
// The loop
// ============================================================================

// Forwards, retransmission and keepalives for every linked client;
// clients silent for 15 minutes dropped (their terminals detach).
@requires(network, declassify)
Srv links(Srv v, List(List(Int)) sfds, List(Int) ready, Int at, Int i, Int now) {
    if (i >= v.peers.len()) { return v; }
    Peer p = v.peers[i];
    Bool gone = now - (if (p.linked) { p.l.last_rx } else { p.born }) > peer_ns();
    _ = if (gone) { close_lsn(p.lsn, 0) } else { true };
    if (gone) { return links(sv_peers(v, v.peers[0..i].concat(v.peers[i + 1..v.peers.len()])), sfds[0..i].concat(sfds[i + 1..sfds.len()]), ready, at + sfds[i].len(), i, now); }
    Link l = if (p.linked) { keepalive(retransmit(read_streams(p.l, sfds[i], ready, at, 0, now), 0, now), now) } else { p.l };
    return links(sv_peers(v, put_peer(v.peers, i, pr_link(p, l))), sfds, ready, at + sfds[i].len(), i + 1, now);
}

List(List(Int)) peer_fds(List(Peer) ps, Int i, List(List(Int)) acc) {
    if (i >= ps.len()) { return acc; }
    return peer_fds(ps, i + 1, acc.concat([stream_fds(ps[i].l.streams, 0, [])]));
}

List(Int) flat(List(List(Int)) xs, Int i, List(Int) acc) {
    if (i >= xs.len()) { return acc; }
    return flat(xs, i + 1, acc.concat(xs[i]));
}

Bool any_linked(List(Peer) ps, Int i, Int now) {
    if (i >= ps.len()) { return false; }
    return (ps[i].linked && now - ps[i].l.last_rx < 30000000000) || any_linked(ps, i + 1, now);
}

@requires(network, declassify, clock(readonly), process)
Int serve_loop(Srv v0) {
    Int now = clock.monotonic_ns();
    Srv v = if (any_linked(v0.peers, 0, now)) { sv_seen(v0, now) } else { v0 };
    Int quiet = now - v.last_client;
    Bool done = if (v.ephemeral) { quiet > ephemeral_ns() } else { if (v.ttys.len() > 0) { quiet > v.keep_ns } else { quiet > v.idle_ns } };
    if (done) { _ = resid_unix_close(v.ctl); return hang_up(v.ttys, 0); }
    List(List(Int)) sfds = peer_fds(v.peers, 0, []);
    List(Int) all_s = flat(sfds, 0, []);
    List(Int) tfds = tty_fds(v.ttys, 0, []);
    List(List(Int)) ls = all_lsn(v.peers, 0, []);
    List(Int) fds = [v.udp, v.ctl].concat(all_s).concat(tfds).concat(firsts(ls, 0, []));
    List(Int) ready = resid_tcp_poll(fds, ones(fds.len(), []), 100);
    Srv a = datagrams(v, now, 64);
    Srv b = control(a, ready.len() > 1 && (ready[1] & 1) != 0, now);
    Srv c = on_events(b, 0, now);
    // Streams and terminals: the peer list may only have grown since the
    // poll (control appends), so the poll's slots still line up.
    Srv d = links(c, pad_fds(sfds, c.peers.len()), ready, 2, 0, now);
    Srv e = tty_io(d, ready, 2 + all_s.len(), 0, now);
    // Listening sockets are found again by fd: LISTEN may have moved one.
    Srv f = accepts(e, ls, ready, 2 + all_s.len() + tfds.len(), 0, now);
    return serve_loop(xfers(f, 0, now));
}

List(List(Int)) pad_fds(List(List(Int)) s, Int n) {
    if (s.len() >= n) { return s; }
    return pad_fds(s.concat([[]]), n);
}

List(Int) ones(Int n, List(Int) acc) { if (n <= 0) { return acc; } return ones(n - 1, acc.concat([1])); }

// Every terminal hung up (the daemon is exiting).
@requires(process)
Int hang_up(List(Tty) ts, Int i) {
    if (i >= ts.len()) { return 0; }
    _ = resid_pty_close(ts[i].fd);
    return hang_up(ts, i + 1);
}

// ============================================================================
// Start
// ============================================================================

type Args = { Str run; Int idle; Int keep; Bool ephemeral; Bool unconfined; Bool ok; Bool busy; };

@requires(args)
Args parse(Int i, Args a) {
    if (i >= args.count()) { return a; }
    Str f = args.get(i);
    Bool num = i + 1 < args.count() && str_is_int(args.get(i + 1)) && str_parse_int(args.get(i + 1)) > 0;
    if (f == "--ephemeral") { return parse(i + 1, Args {.run = a.run, .idle = a.idle, .keep = a.keep, .ephemeral = true, .unconfined = a.unconfined, .ok = a.ok, .busy = a.busy}); }
    if (f == "--run" && i + 1 < args.count()) { return parse(i + 2, Args {.run = args.get(i + 1), .idle = a.idle, .keep = a.keep, .ephemeral = a.ephemeral, .unconfined = a.unconfined, .ok = a.ok, .busy = a.busy}); }
    if (f == "--idle" && num) { return parse(i + 2, Args {.run = a.run, .idle = str_parse_int(args.get(i + 1)), .keep = a.keep, .ephemeral = a.ephemeral, .unconfined = a.unconfined, .ok = a.ok, .busy = a.busy}); }
    if (f == "--keep" && num) { return parse(i + 2, Args {.run = a.run, .idle = a.idle, .keep = str_parse_int(args.get(i + 1)), .ephemeral = a.ephemeral, .unconfined = a.unconfined, .ok = a.ok, .busy = a.busy}); }
    // A test hook: always under load, so every handshake needs a cookie.
    if (f == "--test-busy") { return parse(i + 1, Args {.run = a.run, .idle = a.idle, .keep = a.keep, .ephemeral = a.ephemeral, .unconfined = a.unconfined, .ok = a.ok, .busy = true}); }
    if (f == "--allow-unconfined") { return parse(i + 1, Args {.run = a.run, .idle = a.idle, .keep = a.keep, .ephemeral = a.ephemeral, .unconfined = true, .ok = a.ok, .busy = a.busy}); }
    return Args {.run = a.run, .idle = a.idle, .keep = a.keep, .ephemeral = a.ephemeral, .unconfined = a.unconfined, .ok = false, .busy = a.busy};
}

@requires(args, network, environment, declassify, clock(readonly), process, filesystem)
Int main() {
    if (args.count() >= 2 && args.get(1) == "xfer") { return xfer_main(); }
    if (args.count() == 3 && args.get(1) == "check-confinement") { return check_confinement(args.get(2)); }
    return serve_main();
}

// The daemon's confinement (SPEC 8.4): Landlock with no file writable or
// creatable anywhere and nothing readable but beneath /etc (the
// resolver's files), and the runtime's seccomp filter. Sockets and
// terminals already open stay usable. 1 confined, 0 no Landlock, -1 failed.
Int daemon_confine() {
    List(Str) nowhere = [];
    return resid_sandbox_confine(nowhere, ["/etc"]);
}

// `pylond check-confinement FILE`: the daemon's confinement applied to
// this process, which then tries to read FILE, append to it and create a
// file beside it, and says what happened (the test suite's view of what a
// compromised daemon could do; it only ever takes rights away).
@requires(filesystem)
Int check_confinement(Str file) {
    Int conf = daemon_confine();
    if (conf != 1) { println("not confined (" + f"{conf}" + ")"); return 1; }
    Bool read = filesystem.read_bytes(file).len() > 0;
    Bool append = filesystem.append_bytes(file, bytes_of("pylond was here\n"));
    Bool create = filesystem.write_bytes(file + ".new", bytes_of("pylond was here\n"));
    Bool etc = filesystem.read_bytes("/etc/hosts").len() > 0 || filesystem.read_bytes("/etc/resolv.conf").len() > 0;
    println("read " + allowed(read) + ", append " + allowed(append) + ", create " + allowed(create) + ", /etc " + allowed(etc));
    return 0;
}

Str allowed(Bool b) { return if (b) { "allowed" } else { "refused" }; }

@requires(args, network, environment, declassify, clock(readonly), process)
Int serve_main() {
    if (args.count() < 2 || args.get(1) != "serve") { eprintln("usage: pylond serve --run DIR [--idle SECONDS] [--keep SECONDS] [--ephemeral]"); return 2; }
    Args a = parse(2, Args {.run = "", .idle = 600, .keep = 604800, .ephemeral = false, .unconfined = false, .ok = true, .busy = false});
    if (!a.ok || str_len(a.run) == 0) { eprintln("usage: pylond serve --run DIR [--idle SECONDS] [--keep SECONDS] [--ephemeral]"); return 2; }
    Str addr = server_addr();
    if (str_len(addr) == 0) { eprintln("pylond: not started over SSH (no SSH_CONNECTION)"); return 2; }
    List(Int) hello = read_stdin(boot_hello_len(), []);
    Str path = ctl_path(a.run, addr);
    // A daemon already serving this address takes the new client.
    Int c = resid_unix_connect(path);
    if (c >= 0) {
        _ = resid_unix_deadline(c, 5000);
        _ = resid_unix_send(c, hello);
        List(Int) reply = recv_n(c, boot_reply_len(), []);
        _ = resid_unix_close(c);
        if (reply.len() != boot_reply_len()) { eprintln("pylond: the session daemon refused the bootstrap"); return 1; }
        _ = print_bytes(reply);
        return 0;
    }
    Int broker = resid_pty_broker("env TERM=xterm-256color " + login_shell() + " -l");
    if (broker < 0) { eprintln("pylond: cannot start the terminal broker"); return 1; }
    // The file helper, the only process of pylond's that can touch a file
    // (without it, terminals and forwards work and transfers are refused).
    Int xfer = start_xfer(a.run + "/xfer-v1-" + str_replace(addr, ":", "_") + ".sock");
    _ = if (xfer < 0) { eprintln("pylond: cannot start the file helper; file transfers are refused") } else { true };
    Int ctl = resid_unix_listen(path);
    if (ctl < 0) { eprintln("pylond: cannot listen on " + path); return 1; }
    Int udp = resid_udp_bind_at(addr, 0);
    if (udp < 0) { _ = resid_unix_close(ctl); eprintln("pylond: cannot bind UDP on " + addr); return 1; }
    // Confined before any datagram or control message is read.
    Int conf = daemon_confine();
    if (conf < 0) { _ = resid_unix_close(ctl); eprintln("pylond: confinement failed part-way; exiting"); return 1; }
    if (conf == 0 && !a.unconfined) { _ = resid_unix_close(ctl); eprintln("pylond: this kernel cannot confine pylond (no Landlock), so it will not serve; Pylon stays on SSH for this host (or allow an unconfined pylond for it)"); return 3; }
    Int now = clock.monotonic_ns();
    Srv v0 = Srv {.s = static_new(), .udp = udp, .port = resid_udp_port(udp), .ctl = ctl, .peers = [], .ttys = [], .next_id = 1, .broker = broker,
        .idle_ns = a.idle * 1000000000, .keep_ns = a.keep * 1000000000, .ephemeral = a.ephemeral, .last_client = now, .xfer = xfer, .xfs = [], .ck = ck_new(a.busy, now)};
    BootS served = boot_serve(hello, v0.s, v0.port);
    if (!served.boot.ok) { _ = resid_unix_close(ctl); eprintln("pylond: malformed bootstrap"); return 1; }
    _ = print_bytes(served.reply);
    // From here on nothing is written to the SSH channel.
    return serve_loop(add_peer(v0, served.boot, now));
}
