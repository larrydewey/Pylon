<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The active network's DNS servers (MainActivity.resolvConf). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Symbolon's agent service (SymbolonAgent) requires this. It is
         signature|knownSigner: Android grants it, at install, only to a Pylon
         signed with a certificate Symbolon names, and only when Symbolon was
         installed first. -->
    <uses-permission android:name="dev.symbolon.permission.SSH_SIGN" />
    <!-- ConnectionService: Android takes the network from an app that is not
         in front, so open connections need a foreground service, and its
         notification says they are open. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application
        android:label="Pylon"
        android:extractNativeLibs="true"
        android:allowBackup="false"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- The local shell (SPEC 13): an isolated process, under a UID of its
             own with no permissions, no storage and no network. Only this
             app can bind it. -->
        <service
            android:name=".LocalShellService"
            android:isolatedProcess="true"
            android:process=":local"
            android:exported="false" />
        <!-- The terminal emulator (SPEC 12): the parser of a hostile host's
             output, in an isolated process apart from the connection,
             Symbolon's binding and the local shell. MainActivity binds one
             instance per terminal (bindIsolatedService), each its own
             process and isolated UID. -->
        <service
            android:name=".TermService"
            android:isolatedProcess="true"
            android:process=":term"
            android:exported="false" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <service
            android:name=".ConnectionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the user's open SSH and Pylon terminal connections while another app is in front, such as the SSH agent's consent screen" />
        </service>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <!-- Symbolon, whose signer SymbolonAgent checks before it binds: an
             app is invisible to Pylon without this (Android 11 and later). -->
        <package android:name="dev.symbolon.app" />
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
