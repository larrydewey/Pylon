// The client end of the Pylon protocol (SPEC 8, 9): deliver pylond over
// the verified SSH connection, bootstrap through it, then run forwards
// over the UDP session. EXPERIMENTAL, as proto.resid.

import "crypto.resid";
import "hash.resid";
import "../core/wire.resid";
import "../core/cipher.resid";
import "../core/transport.resid";
import "../core/session.resid";
import "../core/proto.resid";
import "../core/link.resid";
import "../core/forward.resid";
import "../core/files.resid";

// The command that stores pylond: a 0700 cache directory, a temporary
// file checked against the hash, then renamed into place (SPEC 8.3). The
// hash is hex, so nothing from outside reaches the shell.
pub Str push_command(Str hash) {
    return "umask 077; d=\"$HOME/.cache/pylon\"; mkdir -p \"$d\" && chmod 700 \"$d\" && f=\"$d/pylond-" + hash + "\" && cat > \"$f.tmp\" && "
        + "test \"$(sha256sum \"$f.tmp\" | cut -c1-64)\" = " + hash + " && chmod 500 \"$f.tmp\" && mv -f \"$f.tmp\" \"$f\" && echo PYLOND-OK";
}

// The command that starts it: the hash checked again, then exec, with a
// 0700 per-user directory for the session daemon's control socket
// (pylond refuses one it does not own or that others can enter).
pub Str run_command(Str hash, Int idle, Bool ephemeral, Bool unconfined) {
    return "f=\"$HOME/.cache/pylon/pylond-" + hash + "\"; r=\"${XDG_RUNTIME_DIR:-/tmp}/pylon-$(id -u)\"; (umask 077; mkdir -p \"$r\") && "
        + "test \"$(sha256sum \"$f\" | cut -c1-64)\" = " + hash + " && exec \"$f\" serve --run \"$r\" --idle " + f"{idle}" + (if (ephemeral) { " --ephemeral" } else { "" }) + (if (unconfined) { " --allow-unconfined" } else { "" });
}

// The host's machine type (`uname -m`), for picking the pylond build:
// "x86_64" or "aarch64" (arm64 named so), else what it said.
pub type Arch = { Conn c; Str arch; Str err; };

@requires(network, declassify)
pub Arch host_arch(Conn c0) {
    Chan ch = open_session(c0);
    if (!chan_ok(ch)) { return Arch {.c = ch.c, .arch = "", .err = ch.err}; }
    Chan done = pump(send_eof(exec(capturing(ch), "uname -m")));
    if (!chan_ok(done)) { return Arch {.c = done.c, .arch = "", .err = done.err}; }
    Str a = str_trim(ascii_text(done.inbox));
    return Arch {.c = done.c, .arch = if (a == "arm64") { "aarch64" } else { a }, .err = ""};
}

pub type Pushed = { Conn c; Str err; };

@requires(network, declassify)
pub Pushed push_pylond(Conn c0, List(Int) bin, Str hash) {
    Chan ch = open_session(c0);
    if (!chan_ok(ch)) { return Pushed {.c = ch.c, .err = ch.err}; }
    Chan ex = exec(capturing(ch), push_command(hash));
    Chan sent = send_eof(send_data(ex, bin));
    Chan done = pump(sent);
    if (!chan_ok(done)) { return Pushed {.c = done.c, .err = done.err}; }
    Bool ok = str_contains(ascii_text(done.inbox), "PYLOND-OK");
    return Pushed {.c = done.c, .err = if (ok) { "" } else { "the host did not store pylond with the expected hash" }};
}

pub type Started = { Conn c; Boot b; BootC bc; Str err; };

@requires(network, declassify)
pub Started start_pylond(Conn c0, Str hash, Int idle, Bool ephemeral, Bool unconfined) {
    BootC bc = boot_client_new();
    Chan ch = open_session(c0);
    if (!chan_ok(ch)) { return Started {.c = ch.c, .b = boot_finish(bc, []), .bc = bc, .err = ch.err}; }
    Chan ex = exec(capturing(ch), run_command(hash, idle, ephemeral, unconfined));
    Chan sent = send_data(ex, boot_hello(bc));
    Chan got = await_bytes(sent, boot_reply_len());
    if (!chan_ok(got) || got.inbox.len() < boot_reply_len()) { return Started {.c = got.c, .b = boot_finish(bc, []), .bc = bc, .err = "pylond did not answer the bootstrap"}; }
    Boot b = boot_finish(bc, got.inbox[0..boot_reply_len()]);
    return Started {.c = got.c, .b = b, .bc = bc, .err = if (b.ok) { "" } else { "pylond sent a malformed bootstrap reply" }};
}

// The handshake over UDP to addr:port, a few tries one second apart.
@requires(network, declassify, clock)
pub SessionKeys connect_udp(Int udp, List(Int) addr, Int port, Boot b, Static c, Int tries) {
    if (tries <= 0) { List(Secret(UInt(8))) e = []; return SessionKeys {.ok = false, .tx = e, .rx = e, .my_idx = 0, .their_idx = 0}; }
    Pending p = hs_init(b, c, clock.now_ns());
    _ = resid_udp_send_to(udp, addr, port, p.pkt);
    List(Int) ready = resid_tcp_poll([udp], [1], 1000);
    List(Int) d = resid_udp_recv_from(udp, 2048);
    SessionKeys k = if (d.len() == 6 + resp_len()) { hs_finish(b, c, p, d[6..d.len()]) } else { connect_udp(udp, addr, port, b, c, 0) };
    if (k.ok) { return k; }
    return connect_udp(udp, addr, port, b, c, tries - 1);
}

// Four decimal bytes, or [] when s is not an IPv4 literal.
pub List(Int) ipv4(Str s) {
    List(Str) p = str_split(s, ".");
    if (p.len() != 4) { return []; }
    return ipv4_at(p, 0, []);
}

List(Int) ipv4_at(List(Str) p, Int i, List(Int) acc) {
    if (i >= 4) { return acc; }
    if (!str_is_int(p[i]) || str_parse_int(p[i]) < 0 || str_parse_int(p[i]) > 255) { return []; }
    return ipv4_at(p, i + 1, acc.concat([str_parse_int(p[i])]));
}

// The forwarding loop over the link. `rebind_after` > 0 (a test hook,
// PYLON_TEST_REBIND_AFTER) moves the client to a new UDP socket after that
// many packets, as a change of network would.
@requires(network, declassify, clock)
pub Link pylon_forwards(Link l, List(Fwd) fs, Int rebind_after, Rk rk) {
    if (str_len(l.err) > 0) { return l; }
    Int now = clock.monotonic_ns();
    Link lc = serve_connects(events_taken(l), fs, events(l).connects, 0, now);
    List(Int) lfd = listen_fds(fs, 0, []);
    List(Int) sfds = stream_fds(lc.streams, 0, []);
    List(Int) fds = [lc.udp].concat(lfd).concat(sfds);
    List(Int) ready = resid_tcp_poll(fds, ones(fds.len(), []), 100);
    Drained g0 = drain(lc, now, 64, []);
    Rekeyed rr = rekey_step(g0.l, rk, g0.other, now);
    Link a = accept_into(rr.l, fs, ready, 1, 0, now);
    Link b = retransmit(read_streams(a, sfds, ready, 1 + fs.len(), 0, now), 0, now);
    Link c = keepalive(b, now);
    Bool move = rebind_after > 0 && c.tx_ctr >= rebind_after;
    Link d = if (move) { rebind(c) } else { c };
    return pylon_forwards(d, fs, if (move) { 0 } else { rebind_after }, rr.rk);
}

// A new local UDP socket (a new source address and port); the server
// follows on the next authenticated packet.
@requires(network)
pub Link rebind(Link l) {
    Int u = resid_udp_open();
    if (u < 0) { return l; }
    _ = resid_tcp_close(l.udp);
    eprintln("pylon: moved to a new UDP socket (test hook)\r");
    return link_moved(l, u);
}

List(Int) listen_fds(List(Fwd) fs, Int i, List(Int) acc) {
    if (i >= fs.len()) { return acc; }
    return listen_fds(fs, i + 1, acc.concat([fs[i].lfd]));
}

List(Int) ones(Int n, List(Int) acc) { if (n <= 0) { return acc; } return ones(n - 1, acc.concat([1])); }

@requires(network, declassify)
Link accept_into(Link l, List(Fwd) fs, List(Int) ready, Int at, Int i, Int now) {
    if (i >= fs.len()) { return l; }
    Bool r = at + i < ready.len() && (ready[at + i] & 1) != 0;
    Int fd = if (r && fs[i].kind != 2) { resid_tcp_accept_now(fs[i].lfd) } else { -1 };
    Link n = if (fd < 0) { l } else { if (fs[i].kind == 1) { socks_open(l, fd, now) } else { open_stream(l, fd, fs[i].host, fs[i].hport, now) } };
    return accept_into(n, fs, ready, at, i + 1, now);
}

// -D: the SOCKS5 handshake runs here (forward.resid: CONNECT only, host
// names checked); the address asked for goes to pylond in OPEN, and the
// client hears success once pylond has connected.
@requires(network, declassify)
Link socks_open(Link l, Int fd, Int now) {
    Target t = socks_request(fd);
    if (t.refuse != 0) {
        _ = if (t.refuse > 0) { resid_tcp_send_bin(fd, socks_reply(t.refuse)) } else { true };
        _ = resid_tcp_close(fd);
        return l;
    }
    return open_stream_as(l, fd, t.host, t.port, true, now);
}

// Local listeners for -L and -D over the Pylon protocol (a -R forward has
// none here: its slot is -1, which poll skips).
@requires(network)
pub List(Fwd) listen_local(List(Fwd) fs, Int i, List(Fwd) acc) {
    if (i >= fs.len()) { return acc; }
    Int l = if (fs[i].kind == 2) { -1 } else { resid_tcp_listen(fs[i].lport) };
    if (l < 0 && fs[i].kind != 2) { return []; }
    return listen_local(fs, i + 1, acc.concat([Fwd {.kind = fs[i].kind, .lport = fs[i].lport, .host = fs[i].host, .hport = fs[i].hport, .lfd = l}]));
}

// -R: pylond asked to listen on each remote port (its loopback only),
// LISTEN sent until it answers (ten tries, 300 ms apart). The link with
// err set when a port was refused or never answered.
@requires(network, declassify, clock(readonly))
pub Link listen_remote(Link l, List(Fwd) fs, Int i, Int tries) {
    if (i >= fs.len()) { return l; }
    if (fs[i].kind != 2) { return listen_remote(l, fs, i + 1, 0); }
    if (tries >= 10) { return link_err(l, "pylond did not answer the request to listen on its port " + f"{fs[i].lport}"); }
    Link l1 = ask_listen(l, fs[i].lport, clock.monotonic_ns());
    _ = resid_tcp_poll([l1.udp], [1], 300);
    Drained g = drain(l1, clock.monotonic_ns(), 64, []);
    List(Int) got = answer(events(g.l).listening, fs[i].lport, 0);
    Link l2 = events_taken(g.l);
    if (got.len() == 0) { return listen_remote(l2, fs, i, tries + 1); }
    if (got[0] != 1) { return link_err(l2, "pylond cannot listen on its port " + f"{fs[i].lport}" + " (it may be in use)"); }
    return listen_remote(l2, fs, i + 1, 0);
}

// -R: each CONNECT pylond sent (a connection to one of our remote ports)
// goes to that port's destination here; any other port is reset.
@requires(network, declassify)
pub Link serve_connects(Link l, List(Fwd) fs, List(List(Int)) cs, Int i, Int now) {
    if (i >= cs.len()) { return l; }
    Int sid = cs[i][0];
    Int k = remote_at(fs, cs[i][1], 0);
    if (open_sid(l, sid)) { return serve_connects(l, fs, cs, i + 1, now); }
    Int fd = if (k >= 0) { resid_tcp_connect(fs[k].host, fs[k].hport) } else { -1 };
    Link n = if (fd >= 0) { accept_connect(l, sid, fd, now) } else { refuse(l, sid, now) };
    return serve_connects(n, fs, cs, i + 1, now);
}

Int remote_at(List(Fwd) fs, Int port, Int i) {
    if (i >= fs.len()) { return -1; }
    if (fs[i].kind == 2 && fs[i].lport == port) { return i; }
    return remote_at(fs, port, i + 1);
}

// ============================================================================
// A terminal over the Pylon protocol
// ============================================================================

// The interactive loop for the terminal on stream `sid`, with any -L
// forwards beside it. Keystrokes are batched on 20 ms ticks with chaff of
// the same sealed size as a one-key frame, as over SSH (SPEC 5, 9.4); the
// terminal's size is checked every pass and sent when it changed. Returns
// the shell's exit code (255 when the stream was reset).
pub type Sh = { Link l; Int sid; Int rows; Int cols; Bool in_eof; Keys k; Int rebind; Rk rk; App app; };

@requires(network, declassify, terminal, clock(readonly))
pub Int pylon_shell(Sh h, List(Fwd) fs) {
    if (str_len(h.l.err) > 0) { return 255; }
    Int now = clock.monotonic_ns();
    // The peer's bytes to the screen, then its end.
    List(Int) show = inbox(h.l, h.sid);
    _ = if (show.len() > 0) { print_bytes(if (h.app.on) { app_frame(1, show) } else { show }) } else { true };
    Ev e = events(h.l);
    Int code = exit_of(e.exits, h.sid, 0);
    if (code != -2) { return if (code >= 0) { code } else { 255 }; }
    if (!open_sid(h.l, h.sid)) { return 255; }
    Link l0 = serve_connects(events_taken(take_inbox(h.l, h.sid, show.len())), fs, e.connects, 0, now);
    List(Int) lfd = listen_fds(fs, 0, []);
    List(Int) sfds = stream_fds(l0.streams, 0, []);
    List(Int) kb = if (h.in_eof) { [] } else { [0] };
    List(Int) fds = [l0.udp].concat(kb).concat(lfd).concat(sfds);
    List(Int) ready = resid_tcp_poll(fds, ones(fds.len(), []), wait_ms(h.k, now));
    Int t = clock.monotonic_ns();
    Drained g1 = drain(l0, t, 64, []);
    Rekeyed rr = rekey_step(g1.l, h.rk, g1.other, t);
    Drained g = Drained {.l = rr.l, .other = []};
    Bool key = !h.in_eof && ready.len() > 1 && (ready[1] & 1) != 0;
    Int rm = room(g.l, h.sid);
    List(Int) raw_in = if (key && rm > 0) { resid_read_some(if (rm < 4096) { rm } else { 4096 }) } else { [] };
    AppIn ai = if (h.app.on) { app_parse(h.app.buf.concat(raw_in), [], 0, 0) } else { AppIn {.keys = raw_in, .rows = 0, .cols = 0, .rest = []} };
    List(Int) got = ai.keys;
    Bool now_eof = h.in_eof || (key && rm > 0 && raw_in.len() == 0);
    // Keys: at once, or on the next tick.
    Link l1 = if (!h.k.on && got.len() > 0) { push_bytes(g.l, h.sid, got, t) } else { g.l };
    Bool idle = h.k.pending.len() == 0 && t >= h.k.until;
    Keys k1 = if (h.k.on && got.len() > 0) {
        Keys {.on = true, .next = if (idle) { t + tick_ns() } else { h.k.next }, .until = t + 1000000000 + (random_bytes(1)[0] * 4000000), .pending = h.k.pending.concat(got)}
    } else { h.k };
    Bool due = k1.on && (k1.pending.len() > 0 || t < k1.until) && t >= k1.next;
    Link l2 = if (due && k1.pending.len() > 0) { push_bytes(l1, h.sid, k1.pending, t) } else {
        if (due) { send_frame(l1, [6].concat(random_bytes(13)), t) } else { l1 } };
    Int nxt = if (t - k1.next > 5 * tick_ns()) { t + tick_ns() } else { k1.next + tick_ns() };
    Keys k2 = if (due) { Keys {.on = true, .next = nxt, .until = k1.until, .pending = []} } else { k1 };
    Link l3 = if (now_eof && !h.in_eof) { push_eof(push_bytes(l2, h.sid, k2.pending, t), h.sid, -1, t) } else { l2 };
    Keys k3 = if (now_eof && !h.in_eof) { keys_new(false) } else { k2 };
    // Forwards beside the terminal.
    Int at = 1 + kb.len();
    Link l4 = retransmit(read_streams(accept_into(l3, fs, ready, at, 0, t), sfds, ready, at + fs.len(), 0, t), 0, t);
    Int nc = if (h.app.on) { if (ai.cols > 0) { ai.cols } else { h.cols } } else { resid_term_cols() };
    Int nr = if (h.app.on) { if (ai.rows > 0) { ai.rows } else { h.rows } } else { resid_term_rows() };
    Bool changed = nc > 0 && nr > 0 && (nc != h.cols || nr != h.rows);
    Link l5 = keepalive(if (changed) { resize(l4, h.sid, nr, nc, t) } else { l4 }, t);
    Bool move = h.rebind > 0 && l5.tx_ctr >= h.rebind;
    Link l6 = if (move) { rebind(l5) } else { l5 };
    return pylon_shell(Sh {.l = l6, .sid = h.sid, .rows = if (changed) { nr } else { h.rows }, .cols = if (changed) { nc } else { h.cols },
        .in_eof = now_eof, .k = k3, .rebind = if (move) { 0 } else { h.rebind }, .rk = rr.rk, .app = App {.on = h.app.on, .buf = ai.rest}}, fs);
}

// The exit code reported for sid: -2 when none, -1 when the stream was reset.
Int exit_of(List(List(Int)) xs, Int sid, Int i) {
    if (i >= xs.len()) { return -2; }
    if (xs[i][0] == sid) { return xs[i][1]; }
    return exit_of(xs, sid, i + 1);
}

// ============================================================================
// Sessions pylond keeps
// ============================================================================

// Each item: [id, attached, rows, cols, idle seconds, title bytes...].
pub type Listed = { Link l; Bool ok; List(List(Int)) items; };

// LIST until a SESSIONS answer for the nonce arrives (ten tries, 300 ms apart).
@requires(network, declassify, clock(readonly))
pub Listed list_sessions(Link l, Int tries, Int now) {
    if (tries >= 10) { return Listed {.l = l, .ok = false, .items = []}; }
    Int nonce = 1000 + tries;
    Link l1 = ask_sessions(l, nonce, now);
    List(Int) ready = resid_tcp_poll([l1.udp], [1], 300);
    Drained g = drain(l1, clock.monotonic_ns(), 64, []);
    List(Int) got = answer(events(g.l).sessions, nonce, 0);
    if (got.len() > 0) { return Listed {.l = events_taken(g.l), .ok = true, .items = items_of(got, 1, got[0], [])}; }
    return list_sessions(g.l, tries + 1, clock.monotonic_ns());
}

List(Int) answer(List(List(Int)) xs, Int nonce, Int i) {
    if (i >= xs.len()) { return []; }
    if (xs[i].len() >= 2 && xs[i][0] == nonce) { return xs[i][1..xs[i].len()]; }
    return answer(xs, nonce, i + 1);
}

List(List(Int)) items_of(List(Int) b, Int at, Int n, List(List(Int)) acc) {
    if (n <= 0 || at + 14 > b.len()) { return acc; }
    Int tl = b[at + 13];
    if (at + 14 + tl > b.len()) { return acc; }
    List(Int) it = [be32(b, at), b[at + 4], b[at + 5] * 256 + b[at + 6], b[at + 7] * 256 + b[at + 8], be32(b, at + 9)].concat(b[at + 14..at + 14 + tl]);
    return items_of(b, at + 14 + tl, n - 1, acc.concat([it]));
}

// The most recently used detached session, else the most recently used
// one (its client may be gone without a word: it is taken over), or -1.
pub Int detached(List(List(Int)) items, Int i) {
    if (i >= items.len()) { return if (items.len() > 0) { items[0][0] } else { -1 }; }
    if (items[i][1] == 0) { return items[i][0]; }
    return detached(items, i + 1);
}

pub Bool print_sessions(List(List(Int)) items, Int i) {
    if (i == 0) { println(if (items.len() == 0) { "no sessions" } else { "ID      STATE     SIZE      IDLE  TITLE" }); }
    if (i >= items.len()) { return true; }
    List(Int) it = items[i];
    Str state = if (it[1] == 1) { "attached" } else { "detached" };
    println(pad(f"{it[0]}", 8) + pad(state, 10) + pad(f"{it[3]}x{it[2]}", 10) + pad(f"{it[4]}s", 6) + display_text(it[5..it.len()]));
    return print_sessions(items, i + 1);
}

Str pad(Str s, Int n) { return if (str_len(s) >= n) { s + " " } else { pad(s + " ", n) }; }

// ============================================================================
// Rekeying (SPEC 9.5)
// ============================================================================

// A new handshake every `every` ns (2 minutes; pylond refuses keys older
// than 3): a fresh ephemeral X25519 and ML-KEM key, so each period's keys
// are forward-secret on their own. pylond switches to the new keys when
// it answers; streams carry on (what is lost in between is resent).
pub type Rk = { Boot b; Static c; Bool waiting; Pending p; Int sent; Int every; };
pub type Rekeyed = { Link l; Rk rk; };

@requires(declassify)
pub Rk rk_new(Boot b, Static c, Int every) { return Rk {.b = b, .c = c, .waiting = false, .p = Pending {.pkt = [], .ck = [], .h = [], .e = c, .kem = mlkem768_keygen(), .idx = 0}, .sent = 0, .every = every}; }

@requires(network, declassify, clock(readonly))
pub Rekeyed rekey_step(Link l, Rk r, List(List(Int)) others, Int now) {
    // An answer to our initiation.
    List(Int) resp = if (r.waiting) { response(others, 0) } else { [] };
    SessionKeys k = if (resp.len() > 0) { hs_finish(r.b, r.c, r.p, resp) } else { SessionKeys {.ok = false, .tx = [], .rx = [], .my_idx = 0, .their_idx = 0} };
    _ = if (k.ok && r.every < 120000000000) { eprintln("pylon: new session keys (test hook)\r") } else { true };
    if (k.ok) { return Rekeyed {.l = link_rekeyed(l, l.addr, l.port, k, now), .rk = Rk {.b = r.b, .c = r.c, .waiting = false, .p = r.p, .sent = r.sent, .every = r.every}}; }
    // Time for new keys, or an initiation unanswered for a second.
    Bool due = (!r.waiting && now - l.keyed >= r.every) || (r.waiting && now - r.sent > 1000000000);
    if (!due) { return Rekeyed {.l = l, .rk = r}; }
    Pending p = hs_init(r.b, r.c, clock.now_ns());
    _ = resid_udp_send_to(l.udp, l.addr, l.port, p.pkt);
    return Rekeyed {.l = l, .rk = Rk {.b = r.b, .c = r.c, .waiting = true, .p = p, .sent = now, .every = r.every}};
}

List(Int) response(List(List(Int)) xs, Int i) {
    if (i >= xs.len()) { return []; }
    List(Int) d = xs[i];
    if (d.len() == 6 + resp_len() && d[6] == 2) { return d[6..d.len()]; }
    return response(xs, i + 1);
}

// ============================================================================
// Files (core/files.resid)
// ============================================================================

// A transfer in the client: the stream, get (0) or put (1), the local
// file, the stage (0 waiting for pylond's header, 1 moving bytes, 2
// waiting for the end), the local file's bytes (a put's whole file, or a
// resumed get's part), bytes from pylond not yet parsed, what to send and
// how much is sent, the size, start and hash pylond announced (get), the
// bytes written, a test hook that stops after that many bytes (as an
// interruption would), and the outcome ("" while running).
pub type Fx = { Link l; Rk rk; Int sid; Int op; Str local; Int stage; List(Int) data; List(Int) buf; List(Int) out; Int sent;
    Int size; Int start; List(Int) hash; Int wrote; Int stop; Str err; Bool done; };

Fx fx_l(Fx x, Link l, Rk rk) {
    return Fx {.l = l, .rk = rk, .sid = x.sid, .op = x.op, .local = x.local, .stage = x.stage, .data = x.data, .buf = x.buf, .out = x.out, .sent = x.sent,
        .size = x.size, .start = x.start, .hash = x.hash, .wrote = x.wrote, .stop = x.stop, .err = x.err, .done = x.done};
}

Fx fx_end(Fx x, Str err) {
    return Fx {.l = x.l, .rk = x.rk, .sid = x.sid, .op = x.op, .local = x.local, .stage = x.stage, .data = x.data, .buf = x.buf, .out = x.out, .sent = x.sent,
        .size = x.size, .start = x.start, .hash = x.hash, .wrote = x.wrote, .stop = x.stop, .err = err, .done = true};
}

Fx fx_buf(Fx x, Int stage, List(Int) buf, List(Int) out, Int sent, Int wrote) {
    return Fx {.l = x.l, .rk = x.rk, .sid = x.sid, .op = x.op, .local = x.local, .stage = stage, .data = x.data, .buf = buf, .out = out, .sent = sent,
        .size = x.size, .start = x.start, .hash = x.hash, .wrote = wrote, .stop = x.stop, .err = x.err, .done = x.done};
}

Fx fx_head(Fx x, Int size, Int start, List(Int) hash, List(Int) data) {
    return Fx {.l = x.l, .rk = x.rk, .sid = x.sid, .op = x.op, .local = x.local, .stage = 1, .data = data, .buf = x.buf, .out = x.out, .sent = x.sent,
        .size = size, .start = start, .hash = hash, .wrote = 0, .stop = x.stop, .err = x.err, .done = x.done};
}

// Start a get or put: FILE, then (a get) the hashes of what we have and
// our end of the stream. data: the local file (put), or the part of it
// kept for --resume (get).
@requires(network, declassify)
pub Fx file_start(Link l, Rk rk, Int op, Bool resume, Str remote, Str local, List(Int) data, Int stop, Int now) {
    Link l1 = open_file(l, op, if (resume) { 1 } else { 0 }, bytes_of(remote), now);
    Int sid = l1.next_sid - 2;
    Link l2 = if (op == 0) { push_eof(push_bytes(l1, sid, if (resume) { chunk_hashes(data, 0, []) } else { [] }, now), sid, -1, now) } else { l1 };
    return Fx {.l = l2, .rk = rk, .sid = sid, .op = op, .local = local, .stage = 0, .data = data, .buf = [], .out = [], .sent = 0,
        .size = 0, .start = 0, .hash = [], .wrote = 0, .stop = stop, .err = "", .done = false};
}

// The transfer's loop: until it ends (err "" on success).
@requires(network, declassify, clock(readonly), filesystem)
pub Fx pylon_file(Fx x0) {
    if (x0.done) { return x0; }
    if (str_len(x0.l.err) > 0) { return fx_end(x0, x0.l.err); }
    Int now = clock.monotonic_ns();
    List(Int) ready = resid_tcp_poll([x0.l.udp], [1], 100);
    Drained g = drain(x0.l, now, 64, []);
    Rekeyed rr = rekey_step(g.l, x0.rk, g.other, now);
    Link l1 = keepalive(retransmit(rr.l, 0, now), now);
    List(Int) in = inbox(l1, x0.sid);
    Bool gone = !open_sid(l1, x0.sid);
    Bool ended = peer_ended(l1, x0.sid);
    Fx x1 = fx_l(fx_buf(x0, x0.stage, x0.buf.concat(in), x0.out, x0.sent, x0.wrote), take_inbox(l1, x0.sid, in.len()), rr.rk);
    Fx x2 = if (x1.op == 0) { get_bytes(x1, ended) } else { put_bytes(x1, ended) };
    if (x2.done) { return x2; }
    if (gone && !ended) { return fx_end(x2, "pylond reset the transfer"); }
    // What is due to pylond, within the stream's window.
    Int n = min(min(room(x2.l, x2.sid), 65536), x2.out.len() - x2.sent);
    Link l3 = if (n > 0) { push_bytes(x2.l, x2.sid, x2.out[x2.sent..x2.sent + n], now) } else { x2.l };
    Bool last = x2.op == 1 && x2.stage == 1 && x2.sent + n >= x2.out.len();
    Link l4 = if (last) { push_eof(l3, x2.sid, -1, now) } else { l3 };
    Fx x3 = fx_l(fx_buf(x2, if (last) { 2 } else { x2.stage }, x2.buf, x2.out, x2.sent + n, x2.wrote), l4, x2.rk);
    // The test hook: stop once that many bytes are written (get) or acknowledged (put).
    Bool stop = x3.stop > 0 && (if (x3.op == 0) { x3.wrote >= x3.stop } else { x3.sent >= x3.stop && unsent(x3.l, x3.sid) == 0 });
    if (stop) { return fx_end(x3, "stopped (test hook)"); }
    return pylon_file(x3);
}

// A refusal from pylond (1 | message, then its end), shown escaped.
Fx refused(Fx x, Bool ended) {
    if (!ended) { return x; }
    return fx_end(x, "pylond: " + display_text(x.buf[1..x.buf.len()]));
}

// get: the header, then bytes appended to the local file, then the check.
@requires(filesystem)
Fx get_bytes(Fx x, Bool ended) {
    if (x.stage == 0) {
        if (x.buf.len() == 0) { return if (ended) { fx_end(x, "pylond ended the transfer") } else { x }; }
        if (x.buf[0] != 0) { return refused(x, ended); }
        if (x.buf.len() < 49) { return if (ended) { fx_end(x, "pylond sent a malformed answer") } else { x }; }
        Int size = be64_at(x.buf, 1);
        Int start = be64_at(x.buf, 9);
        Bool fits = start % file_chunk() == 0 && start <= x.data.len() && start <= size && size <= file_max();
        if (!fits) { return fx_end(x, "pylond sent a malformed answer"); }
        // The local file cut back to the chunks pylond has too (or emptied).
        Bool ready = if (x.data.len() == start && start > 0) { true } else { filesystem.write_bytes(x.local, x.data[0..start]) };
        if (!ready) { return fx_end(x, "cannot write " + x.local); }
        Fx h = fx_head(x, size, start, x.buf[17..49], []);
        return get_bytes(fx_buf(h, 1, x.buf[49..x.buf.len()], h.out, h.sent, 0), ended);
    }
    Bool over = x.start + x.wrote + x.buf.len() > x.size;
    if (over) { return fx_end(x, "pylond sent more bytes than it announced"); }
    Bool ok = x.buf.len() == 0 || filesystem.append_bytes(x.local, x.buf);
    if (!ok) { return fx_end(x, "cannot write " + x.local); }
    Fx x1 = fx_buf(x, 1, [], x.out, x.sent, x.wrote + x.buf.len());
    if (!ended) { return x1; }
    List(Int) got = filesystem.read_bytes(x.local);
    Bool good = got.len() == x.size && same_bytes(sha256_bytes(got), x.hash);
    return fx_end(x1, if (good) { "" } else { "the file does not match pylond's (size or hash)" });
}

// put: pylond's hashes, then our bytes from the first chunk it lacks,
// then its verdict.
Fx put_bytes(Fx x, Bool ended) {
    if (x.buf.len() == 0) { return if (ended) { fx_end(x, "pylond ended the transfer") } else { x }; }
    if (x.buf[0] != 0) { return refused(x, ended); }
    if (x.stage == 0) {
        if (x.buf.len() < 5) { return x; }
        Int n = be32(x.buf, 1);
        if (n > file_max() / file_chunk() + 1) { return fx_end(x, "pylond sent a malformed answer"); }
        if (x.buf.len() < 5 + n * 32) { return x; }
        List(Int) body = put_body(x.data, x.buf[5..5 + n * 32]);
        Fx h = fx_head(x, x.data.len(), be64_at(body, 0), [], x.data);
        return fx_buf(h, 1, x.buf[5 + n * 32..x.buf.len()], body, 0, 0);
    }
    // After our end: 0, or a refusal, then pylond's end.
    if (x.stage == 2 && ended) { return fx_end(x, if (x.buf.len() == 1) { "" } else { "pylond: " + display_text(x.buf[1..x.buf.len()]) }); }
    return x;
}
