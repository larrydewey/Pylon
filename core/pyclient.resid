// The client end of the Pylon protocol (SPEC 8, 9): deliver pylond over
// the verified SSH connection, bootstrap through it, then run forwards
// over the UDP session. EXPERIMENTAL, as proto.resid.

import "crypto.resid";
import "hash.resid";
import "../core/wire.resid";
import "../core/cipher.resid";
import "../core/transport.resid";
import "../core/session.resid";
import "../core/proto.resid";
import "../core/link.resid";
import "../core/forward.resid";

// The command that stores pylond: a 0700 cache directory, a temporary
// file checked against the hash, then renamed into place (SPEC 8.3). The
// hash is hex, so nothing from outside reaches the shell.
pub Str push_command(Str hash) {
    return "umask 077; d=\"$HOME/.cache/pylon\"; mkdir -p \"$d\" && chmod 700 \"$d\" && f=\"$d/pylond-" + hash + "\" && cat > \"$f.tmp\" && "
        + "test \"$(sha256sum \"$f.tmp\" | cut -c1-64)\" = " + hash + " && chmod 500 \"$f.tmp\" && mv -f \"$f.tmp\" \"$f\" && echo PYLOND-OK";
}

// The command that starts it: the hash checked again, then exec, with a
// 0700 per-user directory for the session daemon's control socket
// (pylond refuses one it does not own or that others can enter).
pub Str run_command(Str hash, Int idle, Bool ephemeral) {
    return "f=\"$HOME/.cache/pylon/pylond-" + hash + "\"; r=\"${XDG_RUNTIME_DIR:-/tmp}/pylon-$(id -u)\"; (umask 077; mkdir -p \"$r\") && "
        + "test \"$(sha256sum \"$f\" | cut -c1-64)\" = " + hash + " && exec \"$f\" serve --run \"$r\" --idle " + f"{idle}" + if (ephemeral) { " --ephemeral" } else { "" };
}

pub type Pushed = { Conn c; Str err; };

@requires(network, declassify)
pub Pushed push_pylond(Conn c0, List(Int) bin, Str hash) {
    Chan ch = open_session(c0);
    if (!chan_ok(ch)) { return Pushed {.c = ch.c, .err = ch.err}; }
    Chan ex = exec(capturing(ch), push_command(hash));
    Chan sent = send_eof(send_data(ex, bin));
    Chan done = pump(sent);
    if (!chan_ok(done)) { return Pushed {.c = done.c, .err = done.err}; }
    Bool ok = str_contains(ascii_text(done.inbox), "PYLOND-OK");
    return Pushed {.c = done.c, .err = if (ok) { "" } else { "the host did not store pylond with the expected hash" }};
}

pub type Started = { Conn c; Boot b; BootC bc; Str err; };

@requires(network, declassify)
pub Started start_pylond(Conn c0, Str hash, Int idle, Bool ephemeral) {
    BootC bc = boot_client_new();
    Chan ch = open_session(c0);
    if (!chan_ok(ch)) { return Started {.c = ch.c, .b = boot_finish(bc, []), .bc = bc, .err = ch.err}; }
    Chan ex = exec(capturing(ch), run_command(hash, idle, ephemeral));
    Chan sent = send_data(ex, boot_hello(bc));
    Chan got = await_bytes(sent, boot_reply_len());
    if (!chan_ok(got) || got.inbox.len() < boot_reply_len()) { return Started {.c = got.c, .b = boot_finish(bc, []), .bc = bc, .err = "pylond did not answer the bootstrap"}; }
    Boot b = boot_finish(bc, got.inbox[0..boot_reply_len()]);
    return Started {.c = got.c, .b = b, .bc = bc, .err = if (b.ok) { "" } else { "pylond sent a malformed bootstrap reply" }};
}

// The handshake over UDP to addr:port, a few tries one second apart.
@requires(network, declassify, clock)
pub SessionKeys connect_udp(Int udp, List(Int) addr, Int port, Boot b, Static c, Int tries) {
    if (tries <= 0) { List(Secret(UInt(8))) e = []; return SessionKeys {.ok = false, .tx = e, .rx = e, .my_idx = 0, .their_idx = 0}; }
    Pending p = hs_init(b, c, clock.now_ns());
    _ = resid_udp_send_to(udp, addr, port, p.pkt);
    List(Int) ready = resid_tcp_poll([udp], [1], 1000);
    List(Int) d = resid_udp_recv_from(udp, 2048);
    SessionKeys k = if (d.len() == 6 + resp_len()) { hs_finish(b, c, p, d[6..d.len()]) } else { connect_udp(udp, addr, port, b, c, 0) };
    if (k.ok) { return k; }
    return connect_udp(udp, addr, port, b, c, tries - 1);
}

// Four decimal bytes, or [] when s is not an IPv4 literal.
pub List(Int) ipv4(Str s) {
    List(Str) p = str_split(s, ".");
    if (p.len() != 4) { return []; }
    return ipv4_at(p, 0, []);
}

List(Int) ipv4_at(List(Str) p, Int i, List(Int) acc) {
    if (i >= 4) { return acc; }
    if (!str_is_int(p[i]) || str_parse_int(p[i]) < 0 || str_parse_int(p[i]) > 255) { return []; }
    return ipv4_at(p, i + 1, acc.concat([str_parse_int(p[i])]));
}

// The forwarding loop over the link. `rebind_after` > 0 (a test hook,
// PYLON_TEST_REBIND_AFTER) moves the client to a new UDP socket after that
// many packets, as a change of network would.
@requires(network, declassify, clock)
pub Link pylon_forwards(Link l, List(Fwd) fs, Int rebind_after) {
    if (str_len(l.err) > 0) { return l; }
    Int now = clock.monotonic_ns();
    List(Int) lfd = listen_fds(fs, 0, []);
    List(Int) sfds = stream_fds(l.streams, 0, []);
    List(Int) fds = [l.udp].concat(lfd).concat(sfds);
    List(Int) ready = resid_tcp_poll(fds, ones(fds.len(), []), 100);
    Drained g = drain(l, now, 64, []);
    Link a = accept_into(g.l, fs, ready, 1, 0, now);
    Link b = retransmit(read_streams(a, sfds, ready, 1 + fs.len(), 0, now), 0, now);
    Link c = keepalive(b, now);
    Bool move = rebind_after > 0 && c.tx_ctr >= rebind_after;
    Link d = if (move) { rebind(c) } else { c };
    return pylon_forwards(d, fs, if (move) { 0 } else { rebind_after });
}

// A new local UDP socket (a new source address and port); the server
// follows on the next authenticated packet.
@requires(network)
pub Link rebind(Link l) {
    Int u = resid_udp_open();
    if (u < 0) { return l; }
    _ = resid_tcp_close(l.udp);
    eprintln("pylon: moved to a new UDP socket (test hook)\r");
    return link_moved(l, u);
}

List(Int) listen_fds(List(Fwd) fs, Int i, List(Int) acc) {
    if (i >= fs.len()) { return acc; }
    return listen_fds(fs, i + 1, acc.concat([fs[i].lfd]));
}

List(Int) ones(Int n, List(Int) acc) { if (n <= 0) { return acc; } return ones(n - 1, acc.concat([1])); }

@requires(network, declassify)
Link accept_into(Link l, List(Fwd) fs, List(Int) ready, Int at, Int i, Int now) {
    if (i >= fs.len()) { return l; }
    Bool r = at + i < ready.len() && (ready[at + i] & 1) != 0;
    Int fd = if (r) { resid_tcp_accept_now(fs[i].lfd) } else { -1 };
    Link n = if (fd >= 0) { open_stream(l, fd, fs[i].host, fs[i].hport, now) } else { l };
    return accept_into(n, fs, ready, at, i + 1, now);
}

// Local listeners for -L over the Pylon protocol.
@requires(network)
pub List(Fwd) listen_local(List(Fwd) fs, Int i, List(Fwd) acc) {
    if (i >= fs.len()) { return acc; }
    Int l = resid_tcp_listen(fs[i].lport);
    if (l < 0) { return []; }
    return listen_local(fs, i + 1, acc.concat([Fwd {.kind = 0, .lport = fs[i].lport, .host = fs[i].host, .hport = fs[i].hport, .lfd = l}]));
}

// ============================================================================
// A terminal over the Pylon protocol
// ============================================================================

// The interactive loop for the terminal on stream `sid`, with any -L
// forwards beside it. Keystrokes are batched on 20 ms ticks with chaff of
// the same sealed size as a one-key frame, as over SSH (SPEC 5, 9.4); the
// terminal's size is checked every pass and sent when it changed. Returns
// the shell's exit code (255 when the stream was reset).
pub type Sh = { Link l; Int sid; Int rows; Int cols; Bool in_eof; Keys k; Int rebind; };

@requires(network, declassify, terminal, clock(readonly))
pub Int pylon_shell(Sh h, List(Fwd) fs) {
    if (str_len(h.l.err) > 0) { return 255; }
    Int now = clock.monotonic_ns();
    // The peer's bytes to the screen, then its end.
    List(Int) show = inbox(h.l, h.sid);
    _ = if (show.len() > 0) { print_bytes(show) } else { true };
    Ev e = events(h.l);
    Int code = exit_of(e.exits, h.sid, 0);
    if (code != -2) { return if (code >= 0) { code } else { 255 }; }
    if (!open_sid(h.l, h.sid)) { return 255; }
    Link l0 = events_taken(take_inbox(h.l, h.sid, show.len()));
    List(Int) lfd = listen_fds(fs, 0, []);
    List(Int) sfds = stream_fds(l0.streams, 0, []);
    List(Int) kb = if (h.in_eof) { [] } else { [0] };
    List(Int) fds = [l0.udp].concat(kb).concat(lfd).concat(sfds);
    List(Int) ready = resid_tcp_poll(fds, ones(fds.len(), []), wait_ms(h.k, now));
    Int t = clock.monotonic_ns();
    Drained g = drain(l0, t, 64, []);
    Bool key = !h.in_eof && ready.len() > 1 && (ready[1] & 1) != 0;
    Int rm = room(g.l, h.sid);
    List(Int) got = if (key && rm > 0) { resid_read_some(if (rm < 4096) { rm } else { 4096 }) } else { [] };
    Bool now_eof = h.in_eof || (key && rm > 0 && got.len() == 0);
    // Keys: at once, or on the next tick.
    Link l1 = if (!h.k.on && got.len() > 0) { push_bytes(g.l, h.sid, got, t) } else { g.l };
    Bool idle = h.k.pending.len() == 0 && t >= h.k.until;
    Keys k1 = if (h.k.on && got.len() > 0) {
        Keys {.on = true, .next = if (idle) { t + tick_ns() } else { h.k.next }, .until = t + 1000000000 + (random_bytes(1)[0] * 4000000), .pending = h.k.pending.concat(got)}
    } else { h.k };
    Bool due = k1.on && (k1.pending.len() > 0 || t < k1.until) && t >= k1.next;
    Link l2 = if (due && k1.pending.len() > 0) { push_bytes(l1, h.sid, k1.pending, t) } else {
        if (due) { send_frame(l1, [6].concat(random_bytes(13)), t) } else { l1 } };
    Int nxt = if (t - k1.next > 5 * tick_ns()) { t + tick_ns() } else { k1.next + tick_ns() };
    Keys k2 = if (due) { Keys {.on = true, .next = nxt, .until = k1.until, .pending = []} } else { k1 };
    Link l3 = if (now_eof && !h.in_eof) { push_eof(push_bytes(l2, h.sid, k2.pending, t), h.sid, -1, t) } else { l2 };
    Keys k3 = if (now_eof && !h.in_eof) { keys_new(false) } else { k2 };
    // Forwards beside the terminal.
    Int at = 1 + kb.len();
    Link l4 = retransmit(read_streams(accept_into(l3, fs, ready, at, 0, t), sfds, ready, at + fs.len(), 0, t), 0, t);
    Int nc = resid_term_cols();
    Int nr = resid_term_rows();
    Bool changed = nc > 0 && nr > 0 && (nc != h.cols || nr != h.rows);
    Link l5 = keepalive(if (changed) { resize(l4, h.sid, nr, nc, t) } else { l4 }, t);
    Bool move = h.rebind > 0 && l5.tx_ctr >= h.rebind;
    Link l6 = if (move) { rebind(l5) } else { l5 };
    return pylon_shell(Sh {.l = l6, .sid = h.sid, .rows = if (changed) { nr } else { h.rows }, .cols = if (changed) { nc } else { h.cols },
        .in_eof = now_eof, .k = k3, .rebind = if (move) { 0 } else { h.rebind }}, fs);
}

// The exit code reported for sid: -2 when none, -1 when the stream was reset.
Int exit_of(List(List(Int)) xs, Int sid, Int i) {
    if (i >= xs.len()) { return -2; }
    if (xs[i][0] == sid) { return xs[i][1]; }
    return exit_of(xs, sid, i + 1);
}

// ============================================================================
// Sessions pylond keeps
// ============================================================================

// Each item: [id, attached, rows, cols, idle seconds, title bytes...].
pub type Listed = { Link l; Bool ok; List(List(Int)) items; };

// LIST until a SESSIONS answer for the nonce arrives (ten tries, 300 ms apart).
@requires(network, declassify, clock(readonly))
pub Listed list_sessions(Link l, Int tries, Int now) {
    if (tries >= 10) { return Listed {.l = l, .ok = false, .items = []}; }
    Int nonce = 1000 + tries;
    Link l1 = ask_sessions(l, nonce, now);
    List(Int) ready = resid_tcp_poll([l1.udp], [1], 300);
    Drained g = drain(l1, clock.monotonic_ns(), 64, []);
    List(Int) got = answer(events(g.l).sessions, nonce, 0);
    if (got.len() > 0) { return Listed {.l = events_taken(g.l), .ok = true, .items = items_of(got, 1, got[0], [])}; }
    return list_sessions(g.l, tries + 1, clock.monotonic_ns());
}

List(Int) answer(List(List(Int)) xs, Int nonce, Int i) {
    if (i >= xs.len()) { return []; }
    if (xs[i].len() >= 2 && xs[i][0] == nonce) { return xs[i][1..xs[i].len()]; }
    return answer(xs, nonce, i + 1);
}

List(List(Int)) items_of(List(Int) b, Int at, Int n, List(List(Int)) acc) {
    if (n <= 0 || at + 14 > b.len()) { return acc; }
    Int tl = b[at + 13];
    if (at + 14 + tl > b.len()) { return acc; }
    List(Int) it = [be32(b, at), b[at + 4], b[at + 5] * 256 + b[at + 6], b[at + 7] * 256 + b[at + 8], be32(b, at + 9)].concat(b[at + 14..at + 14 + tl]);
    return items_of(b, at + 14 + tl, n - 1, acc.concat([it]));
}

// The most recently used detached session, else the most recently used
// one (its client may be gone without a word: it is taken over), or -1.
pub Int detached(List(List(Int)) items, Int i) {
    if (i >= items.len()) { return if (items.len() > 0) { items[0][0] } else { -1 }; }
    if (items[i][1] == 0) { return items[i][0]; }
    return detached(items, i + 1);
}

pub Bool print_sessions(List(List(Int)) items, Int i) {
    if (i == 0) { println(if (items.len() == 0) { "no sessions" } else { "ID      STATE     SIZE      IDLE  TITLE" }); }
    if (i >= items.len()) { return true; }
    List(Int) it = items[i];
    Str state = if (it[1] == 1) { "attached" } else { "detached" };
    println(pad(f"{it[0]}", 8) + pad(state, 10) + pad(f"{it[3]}x{it[2]}", 10) + pad(f"{it[4]}s", 6) + display_text(it[5..it.len()]));
    return print_sessions(items, i + 1);
}

Str pad(Str s, Int n) { return if (str_len(s) >= n) { s + " " } else { pad(s + " ", n) }; }
