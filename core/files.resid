// Resumable file transfer over the Pylon protocol (SPEC 11 "Files",
// 9.7): what both ends share. EXPERIMENTAL, as proto.resid.
//
// A transfer is one stream, opened by the client with
//   FILE 16 | sid (4) | op (1: 0 get, 1 put) | flags (1: bit 0 resume) | path
// The path is the one the principal typed (printable ASCII in v1; a
// relative one is taken under the principal's home). The file is cut into
// 64 KiB chunks; a side that holds part of it sends the SHA-256 of each
// whole chunk it has, and the transfer starts after the longest run of
// leading chunks the other side has too. The whole file's SHA-256 travels
// with the bytes and is checked at the end, so a resumed file is the
// sender's file or an error.
//
//   get  client -> pylond  hashes of LOCAL's chunks (with --resume), FIN
//        pylond -> client  0 | size (8) | start (8) | sha256 (32) | bytes from start, FIN
//                          or 1 | message, FIN
//   put  pylond -> client  0 | count (4) | count x hash (with --resume; else count 0)
//                          or 1 | message, FIN
//        client -> pylond  start (8) | size (8) | sha256 (32) | bytes from start, FIN
//        pylond -> client  0 (the file is complete and its hash matches), FIN
//                          or 1 | message, FIN
//
// Files are held in memory whole, so v1 carries files of up to 64 MiB.

import "crypto.resid";
import "hash.resid";
import "wire.resid";
import "sha256g.resid";

pub Int file_chunk() { return 65536; }
pub Int file_max() { return 67108864; }

// The SHA-256 of each whole chunk of data, concatenated.
pub List(Int) chunk_hashes(List(Int) data, Int i, List(Int) acc) {
    Int at = i * file_chunk();
    if (at + file_chunk() > data.len()) { return acc; }
    return chunk_hashes(data, i + 1, acc.concat(sha256_bytes(data[at..at + file_chunk()])));
}

// How many leading whole chunks of data the hashes (32 bytes each) match.
pub Int matching(List(Int) data, List(Int) hashes, Int k) {
    Int at = k * file_chunk();
    if ((k + 1) * 32 > hashes.len() || at + file_chunk() > data.len()) { return k; }
    if (!same_bytes(sha256_bytes(data[at..at + file_chunk()]), hashes[k * 32..(k + 1) * 32])) { return k; }
    return matching(data, hashes, k + 1);
}

// A path the principal may name in v1: printable ASCII, 1 to 4096 bytes.
pub Bool path_ok(List(Int) p) { return p.len() >= 1 && p.len() <= 4096 && printable(p, 0); }

Bool printable(List(Int) p, Int i) {
    if (i >= p.len()) { return true; }
    return p[i] >= 32 && p[i] < 127 && printable(p, i + 1);
}

// An eight-byte big-endian number at i.
pub Int be64_at(List(Int) b, Int i) { return (be32(b, i) << 32) | be32(b, i + 4); }

// A refusal: 1 | message.
pub List(Int) refusal(Str why) { return [1].concat(bytes_of(why)); }

// pylond's answer to a get: the file at path from the first chunk the
// client's hashes do not cover.
@requires(filesystem(readonly))
// Packed, one byte to a byte: the file is the bulk of it, and as List(Int)
// it would take eight bytes for each of its bytes.
pub List(UInt(8)) get_reply(Str path, List(Int) hashes) {
    if (!filesystem.exists(path)) { return bytes_u8(refusal("no such file")); }
    if (filesystem.is_dir(path)) { return bytes_u8(refusal("is a directory")); }
    List(UInt(8)) data = filesystem.read_bytes_u8(path);
    if (data.len() > file_max()) { return bytes_u8(refusal("larger than 64 MiB (the Pylon protocol v1 limit)")); }
    Int start = matching_u8(data, hashes, 0) * file_chunk();
    List(Int) head = [0].concat(u64_be(data.len())).concat(u64_be(start)).concat(bytes_int(sha256g(data)));
    return bytes_u8(head).concat(data[start..data.len()]);
}

// The client's side holds a file packed, a byte a byte
// (filesystem.read_bytes_u8): as List(Int) it would hold eight.

// chunk_hashes of a packed file.
pub List(Int) chunk_hashes_u8(List(UInt(8)) data, Int i, List(Int) acc) {
    Int at = i * file_chunk();
    if (at + file_chunk() > data.len()) { return acc; }
    return chunk_hashes_u8(data, i + 1, acc.concat(bytes_int(sha256g(data[at..at + file_chunk()]))));
}

// matching for a packed file.
pub Int matching_u8(List(UInt(8)) data, List(Int) hashes, Int k) {
    Int at = k * file_chunk();
    if ((k + 1) * 32 > hashes.len() || at + file_chunk() > data.len()) { return k; }
    if (!same_bytes(bytes_int(sha256g(data[at..at + file_chunk()])), hashes[k * 32..(k + 1) * 32])) { return k; }
    return matching_u8(data, hashes, k + 1);
}

// The head of what a put sends (start, size, hash); the file from start
// follows. The client sends the file's bytes from data itself rather
// than from a copy: a copy made inside the transfer's loop lives in the
// loop's region, and compactions of that region would carry it too.
pub List(Int) put_head(List(UInt(8)) data, List(Int) hashes) {
    Int start = matching_u8(data, hashes, 0) * file_chunk();
    return u64_be(start).concat(u64_be(data.len())).concat(bytes_int(sha256g(data)));
}

// ============================================================================
// pylond's file helper (SPEC 8.4)
// ============================================================================
//
// pylond's network-facing daemon has no filesystem access of its own: a
// helper process, started before the daemon confines itself, does every
// read and write of a transfer, on the daemon's request over a Unix
// socket. The helper decides for itself which paths a transfer may touch,
// so a compromised daemon can ask it for no more than this:
//
//   - only beneath $HOME (and the helper's Landlock domain is $HOME alone);
//   - no hidden name anywhere beneath $HOME (a component starting with a
//     dot: ~/.ssh, ~/.bashrc, ~/.profile, ~/.config, ~/.local, .git, ...),
//     where the files that log in, start or configure programs live;
//   - no "." or ".." component.
//
// Requests, each framed as length (4) | body, answered the same way:
//
//   op (1) | path length (2) | path | arguments
//   1 get        hashes of the client's chunks   -> get_reply's answer
//   2 put-open   resume (1)                     -> 0 | size (8) | count (4) | count x hash, or 1 | message
//   3 put-start  start (8)                      -> 0, or 1 | message (the file cut back to start)
//   4 append     bytes                          -> 0, or 1 | message
//   5 check      size (8) | sha256 (32)         -> 0, or 1 | message
//
// The path is the one the principal typed (path_ok); a relative one, or
// one starting with "~/", is taken under $HOME.

// A path a transfer may use, or why not (path "").
pub type XPath = { Str path; Str why; };

pub XPath xfer_path(Str home, Str typed) {
    List(Str) hc = path_parts(str_split(home, "/"), 0, []);
    Bool home_ok = str_starts_with(home, "/") && hc.len() > 0 && !odd_part(hc, 0);
    if (!home_ok) { return XPath {.path = "", .why = "the principal has no usable $HOME"}; }
    Str full = if (str_starts_with(typed, "/")) { typed } else { if (typed == "~") { home } else { if (str_starts_with(typed, "~/")) { home + str_slice(typed, 1, str_len(typed)) } else { home + "/" + typed } } };
    List(Str) pc = path_parts(str_split(full, "/"), 0, []);
    if (odd_part(pc, 0)) { return XPath {.path = "", .why = "the path has a . or .. in it"}; }
    if (pc.len() < hc.len() || !same_parts(pc, hc, 0)) { return XPath {.path = "", .why = "it is outside $HOME"}; }
    if (hidden_part(pc, hc.len())) { return XPath {.path = "", .why = "pylond does not touch hidden files or directories (names starting with a dot); use SSH (without --pylond) for those"}; }
    return XPath {.path = "/" + str_join(pc, "/"), .why = ""};
}

// The non-empty components of a split path.
List(Str) path_parts(List(Str) p, Int i, List(Str) acc) {
    if (i >= p.len()) { return acc; }
    return path_parts(p, i + 1, if (str_len(p[i]) == 0) { acc } else { acc.concat([p[i]]) });
}

Bool odd_part(List(Str) p, Int i) {
    if (i >= p.len()) { return false; }
    return p[i] == "." || p[i] == ".." || odd_part(p, i + 1);
}

Bool same_parts(List(Str) p, List(Str) prefix, Int i) {
    if (i >= prefix.len()) { return true; }
    return p[i] == prefix[i] && same_parts(p, prefix, i + 1);
}

Bool hidden_part(List(Str) p, Int i) {
    if (i >= p.len()) { return false; }
    return str_starts_with(p[i], ".") || hidden_part(p, i + 1);
}

// A request to the helper (its body, unframed).
pub List(Int) xfer_req(Int op, Str path, List(Int) args) {
    List(Int) pb = bytes_of(path);
    return [op, (pb.len() >> 8) & 255, pb.len() & 255].concat(pb).concat(args);
}

// The helper's answer to one request (the body, unframed): the whole of
// what the helper does for the daemon.
@requires(filesystem)
pub List(Int) xfer_answer(Str home, List(Int) req) { return bytes_int(xfer_answer_u8(home, req)); }

// xfer_answer packed, as the helper sends it (a get's answer holds the file).
@requires(filesystem)
pub List(UInt(8)) xfer_answer_u8(Str home, List(Int) req) {
    if (req.len() < 3) { return bytes_u8(refusal("malformed request")); }
    Int op = req[0];
    Int n = (req[1] << 8) | req[2];
    if (op < 1 || op > 5 || req.len() < 3 + n || !path_ok(req[3..3 + n])) { return bytes_u8(refusal("malformed request")); }
    List(Int) a = req[3 + n..req.len()];
    XPath p = xfer_path(home, ascii_text(req[3..3 + n]));
    if (str_len(p.path) == 0) { return bytes_u8(refusal(if (op == 1) { "cannot read the file: " + p.why } else { "cannot write the file: " + p.why })); }
    if (op == 1) { return if (a.len() % 32 == 0 && a.len() <= 65536) { get_reply(p.path, a) } else { bytes_u8(refusal("malformed request")) }; }
    List(Int) r = if (op == 2) { if (a.len() == 1) { put_open(p.path, a[0] == 1) } else { refusal("malformed request") } }
        else { if (op == 3) { if (a.len() == 8) { put_start(p.path, be64_at(a, 0)) } else { refusal("malformed request") } }
        else { if (op == 4) { if (a.len() == 0 || filesystem.append_bytes(p.path, a)) { [0] } else { refusal("cannot write the file") } }
        else { if (a.len() == 40) { put_check(p.path, be64_at(a, 0), a[8..40]) } else { refusal("malformed request") } } } };
    return bytes_u8(r);
}

// put-open: the size of what is there and (to resume) its chunk hashes.
@requires(filesystem(readonly))
List(Int) put_open(Str path, Bool resume) {
    if (filesystem.is_dir(path)) { return refusal("is a directory"); }
    Bool keep = resume && filesystem.exists(path);
    List(UInt(8)) old = if (keep) { filesystem.read_bytes_u8(path) } else { [] };
    List(Int) hs = if (old.len() <= file_max()) { chunk_hashes_u8(old, 0, []) } else { [] };
    return [0].concat(u64_be(old.len())).concat(u32_be(hs.len() / 32)).concat(hs);
}

// put-start: the file cut back to the chunks both sides share (or emptied).
@requires(filesystem)
List(Int) put_start(Str path, Int start) {
    if (start == 0) { return if (filesystem.write_bytes(path, [])) { [0] } else { refusal("cannot write the file") }; }
    List(UInt(8)) old = if (filesystem.exists(path) && !filesystem.is_dir(path)) { filesystem.read_bytes_u8(path) } else { [] };
    if (old.len() < start) { return refusal("the file changed during the transfer"); }
    if (old.len() == start) { return [0]; }
    return if (filesystem.write_bytes(path, old[0..start])) { [0] } else { refusal("cannot write the file") };
}

// check: the whole file against the size and hash the client promised.
@requires(filesystem(readonly))
List(Int) put_check(Str path, Int size, List(Int) hash) {
    List(UInt(8)) got = filesystem.read_bytes_u8(path);
    return if (got.len() == size && same_bytes(bytes_int(sha256g(got)), hash)) { [0] } else { refusal("the file does not match what was sent") };
}
