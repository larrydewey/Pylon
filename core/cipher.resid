// The binary packet protocol (RFC 4253 6) under the profile's AEAD
// ciphers only (SPEC 5):
//
//   chacha20-poly1305@openssh.com  (PROTOCOL.chacha20poly1305)
//   aes256-gcm@openssh.com, aes128-gcm@openssh.com  (RFC 5647)
//
// and "none" for the cleartext packets before the first NEWKEYS. There is
// no MAC-and-cipher composition and no CBC/CTR mode in this file, by
// design: what is not here cannot be negotiated.
//
// A direction's state is a value: sealing or opening a packet returns the
// new state (sequence number, GCM invocation counter).
//
// Keys are Secret(UInt(8)) bytes and every cipher runs on the generic
// (secret-typed) implementations, so the compiler checks that no branch,
// index or output depends on a key. Values leave the secret domain only
// at the declassify points below, each naming what is published: the
// sealed bytes, a received packet's length (needed to frame it, as in
// every SSH implementation), and a payload after its tag verified.

import "crypto.resid";
import "word.resid";
import "random.resid";
import "chachag.resid";
import "aesgcmg.resid";
import "wire.resid";

// Public bytes lifted into secret computation (they claim no secrecy).
pub List(Secret(UInt(8))) lift(List(Int) b) { return lift_acc(b, 0, ListBuf()); }

List(Secret(UInt(8))) lift_acc(List(Int) b, Int i, ListBuf(Secret(UInt(8))) acc) {
    if (i >= b.len()) { return acc.finish(); }
    return lift_acc(b, i + 1, acc.push(classify(wrapping_u8(b[i]))));
}

// Packed public bytes lifted the same way. Secret bytes are packed bytes
// at run time (secret_split and classify erase), so this is no copy: the
// packet path keeps its bytes packed, one byte a byte, from the socket
// through the cipher and back.
pub List(Secret(UInt(8))) lift_u8(List(UInt(8)) b) { return secret_split(classify(b)); }

pub List(Int) ints_of(List(UInt(8)) b) { return ints_acc(b, 0, ListBuf()); }

List(Int) ints_acc(List(UInt(8)) b, Int i, ListBuf(Int) acc) {
    if (i >= b.len()) { return acc.finish(); }
    return ints_acc(b, i + 1, acc.push((Int) b[i]));
}

// Bytes [from, to) of b as Ints, without slicing them out first.
pub List(Int) ints_range(List(UInt(8)) b, Int from, Int to) { return ints_range_acc(b, from, to, ListBuf()); }

List(Int) ints_range_acc(List(UInt(8)) b, Int i, Int to, ListBuf(Int) acc) {
    if (i >= to) { return acc.finish(); }
    return ints_range_acc(b, i + 1, to, acc.push((Int) b[i]));
}

@robust_exempt(reason = "a network protocol: which packets arrive decides when sealed bytes are sent and authenticated payloads are opened; only ciphertext, tags, frame lengths and verified plaintext are published")
@requires(declassify)
pub List(UInt(8)) sealed_bytes(List(Secret(UInt(8))) s) { return declassify(secret_join(s), "sealed packet bytes are sent on the wire"); }

@robust_exempt(reason = "a network protocol: which packets arrive decides when sealed bytes are sent and authenticated payloads are opened; only ciphertext, tags, frame lengths and verified plaintext are published")
@requires(declassify)
pub List(Int) pub_sealed(List(Secret(UInt(8))) s) { return ints_of(sealed_bytes(s)); }

@robust_exempt(reason = "a network protocol: which packets arrive decides when sealed bytes are sent and authenticated payloads are opened; only ciphertext, tags, frame lengths and verified plaintext are published")
@requires(declassify)
List(Int) pub_length(List(Secret(UInt(8))) s) { return ints_of(declassify(secret_join(s), "packet length, needed to frame the packet before its tag is checked")); }

@robust_exempt(reason = "a network protocol: which packets arrive decides when sealed bytes are sent and authenticated payloads are opened; only ciphertext, tags, frame lengths and verified plaintext are published")
@requires(declassify)
pub List(UInt(8)) plain_bytes(List(Secret(UInt(8))) s) { return declassify(secret_join(s), "packet payload after its tag verified"); }

@robust_exempt(reason = "a network protocol: which packets arrive decides when sealed bytes are sent and authenticated payloads are opened; only ciphertext, tags, frame lengths and verified plaintext are published")
@requires(declassify)
pub List(Int) pub_plain(List(Secret(UInt(8))) s) { return ints_of(plain_bytes(s)); }

// kind: 0 none, 1 chacha20-poly1305@openssh.com, 2 AES-GCM. The GCM IV
// is not secret (RFC 5647 7.1). gk: the AES key schedule and GHASH key,
// expanded once when the keys are made rather than for every packet; a
// direction that is not AES-GCM gets one from an unrelated random key,
// never used.
pub type Dir = { Int kind; List(Secret(UInt(8))) key; AesGcmKeyG(Secret(UInt(128)), Secret(UInt(32))) gk; List(Int) iv; Int seq; };

// Before the first NEWKEYS nothing is encrypted and the key is never
// used; it is random rather than empty so that no constant can ever flow
// into a cipher call (the compiler's key-entropy check, E0270, sees one
// Dir type for both states).
pub Dir dir_none() { return Dir {.kind = 0, .key = random_secret(64), .gk = aes_gcmg_key(random_secret(32)), .iv = [], .seq = 0}; }

pub Int cipher_key_len(Str name) {
    if (name == "chacha20-poly1305@openssh.com") { return 64; }
    if (name == "aes256-gcm@openssh.com") { return 32; }
    if (name == "aes128-gcm@openssh.com") { return 16; }
    return 0;
}

pub Int cipher_iv_len(Str name) { return if (str_ends_with(name, "-gcm@openssh.com")) { 12 } else { 0 }; }

pub Dir dir_new(Str name, List(Secret(UInt(8))) key, List(Int) iv, Int seq) {
    Int k = if (name == "chacha20-poly1305@openssh.com") { 1 } else { if (str_ends_with(name, "-gcm@openssh.com")) { 2 } else { 0 } };
    return Dir {.kind = k, .key = key, .gk = aes_gcmg_key(if (k == 2) { key } else { random_secret(32) }), .iv = iv, .seq = seq};
}

// The same keys with the sequence number set (strict kex resets it to 0
// at every NEWKEYS).
pub Dir dir_seq(Dir d, Int seq) { return Dir {.kind = d.kind, .key = d.key, .gk = d.gk, .iv = d.iv, .seq = seq}; }

// Sequence numbers are uint32 and wrap (RFC 4253 6.4). The sequence
// number is chacha20-poly1305's nonce, so a wrap under one key would
// repeat one: the transport rekeys long before (2^31 packets, which under
// strict kex resets the number to 0) and ends the connection rather than
// seal or open a packet with a direction whose number is spent.
Int next_seq(Int s) { return (s + 1) & 4294967295; }

// The last sequence number: using it would make the next one wrap to 0.
pub Bool seq_spent(Dir d) { return d.seq >= 4294967295; }

Int block_of(Dir d) { return if (d.kind == 2) { 16 } else { 8 }; }

// ============================================================================
// Sealing
// ============================================================================

// Padding (RFC 4253 6): at least 4 random bytes, so that the padded part
// is a multiple of the block size. Under AEAD the length field is not
// part of that (it is the AAD or encrypted on its own).
//
// The payload is `head` then `data`: a message's fields, and the bulk
// bytes it carries, packed (a channel's data). The two are framed
// together, so channel data is never first copied into a payload list of
// its own. body: the padding length, the payload and the padding, which
// is what the cipher seals after the length field len4.
pub type Framed = { List(Int) len4; List(UInt(8)) body; };

pub Framed frame(Dir d, List(Int) head, List(UInt(8)) data) {
    Int bs = block_of(d);
    Int n = head.len() + data.len();
    Int counted = if (d.kind == 0) { 5 + n } else { 1 + n };
    Int pad0 = bs - (counted % bs);
    Int pad = if (pad0 < 4) { pad0 + bs } else { pad0 };
    List(UInt(8)) body = bytes_u8([pad].concat(head)).concat(data).concat(bytes_u8(random_bytes(pad)));
    return Framed {.len4 = u32_be(1 + n + pad), .body = body};
}

pub type Sealed = { Dir d; List(UInt(8)) out; };

@requires(declassify)
pub Sealed seal(Dir d, List(Int) head, List(UInt(8)) data) {
    Framed f = frame(d, head, data);
    if (d.kind == 0) { return Sealed {.d = dir_seq(d, next_seq(d.seq)), .out = bytes_u8(f.len4).concat(f.body)}; }
    if (d.kind == 1) { return Sealed {.d = dir_seq(d, next_seq(d.seq)), .out = cc_seal(d.key, d.seq, f)}; }
    List(UInt(8)) ct = sealed_bytes(aes_gcmg_seal_k(d.gk, d.iv, lift_u8(f.body), bytes_u8(f.len4)));
    Dir nd = Dir {.kind = 2, .key = d.key, .gk = d.gk, .iv = gcm_next_iv(d.iv), .seq = next_seq(d.seq)};
    return Sealed {.d = nd, .out = bytes_u8(f.len4).concat(ct)};
}

// ============================================================================
// chacha20-poly1305@openssh.com
// ============================================================================
//
// The 64-byte key is K_2 (bytes 0..32, the payload and MAC key) then K_1
// (32..64, the length key). The nonce is the sequence number as a uint64;
// OpenSSH uses the original 64-bit-counter ChaCha20, which for counters
// below 2^32 is the RFC 8439 function with the nonce 0^4 || seq_be64.

List(Int) cc_nonce(Int seq) { return [0, 0, 0, 0].concat(u64_be(seq)); }

// The ciphertext stays secret-typed until the whole packet (length,
// body, tag) is published at once.
@requires(declassify)
List(UInt(8)) cc_seal(List(Secret(UInt(8))) key, Int seq, Framed f) {
    List(Secret(UInt(8))) k2 = key[0..32];
    List(Secret(UInt(8))) k1 = key[32..64];
    List(Int) n = cc_nonce(seq);
    List(Secret(UInt(8))) ct = chachag_xor(k1, 0, n, lift(f.len4)).concat(chachag_xor(k2, 1, n, lift_u8(f.body)));
    List(Secret(UInt(8))) poly_key = chachag_block(k2, 0, n)[0..32];
    return sealed_bytes(ct.concat(poly1305g(poly_key, ct)));
}

// The packet length from the first four received bytes, decrypted with
// K_1. It is used before the MAC is checked, only to know how many bytes
// to wait for, and is bounded by the caller.
@requires(declassify)
pub Int cc_length(List(Secret(UInt(8))) key, Int seq, List(Int) first4) {
    List(Secret(UInt(8))) k1 = key[32..64];
    return be32(pub_length(chachag_xor(k1, 0, cc_nonce(seq), lift(first4))), 0);
}

// ============================================================================
// AES-GCM (RFC 5647)
// ============================================================================

// The IV is a 4-byte fixed field and an 8-byte invocation counter,
// incremented (mod 2^64) after each packet.
List(Int) gcm_next_iv(List(Int) iv) { return iv[0..4].concat(inc_be(iv[4..12], 7)); }

List(Int) inc_be(List(Int) b, Int i) {
    if (i < 0) { return b; }
    Int v = (b[i] + 1) & 255;
    List(Int) nb = b[0..i].concat([v]).concat(b[i + 1..b.len()]);
    return if (v == 0) { inc_be(nb, i - 1) } else { nb };
}

// ============================================================================
// Opening
// ============================================================================

// How many bytes a packet needs after its first 4 (the length field):
// the packet body plus the tag, or -1 when the length is impossible. The
// profile's limit is 256 KiB (SPEC 5).
@requires(declassify)
pub Int need_after_len(Dir d, List(Int) first4) {
    Int n = if (d.kind == 1) { cc_length(d.key, d.seq, first4) } else { be32(first4, 0) };
    if (n < 5 || n > 262144) { return -1; }
    Int bs = block_of(d);
    // AEAD: the padded part is aligned; cleartext: length field included.
    Bool aligned = if (d.kind == 0) { (n + 4) % bs == 0 } else { n % bs == 0 };
    if (!aligned) { return -1; }
    Int tag = if (d.kind == 0) { 0 } else { 16 };
    return n + tag;
}

// A packet opened: body is the decrypted padding length, payload and
// padding, and the payload is body[from..to] (bounds, so the payload is
// not copied out of the body here; the transport takes what it needs).
pub type Opened = { Dir d; Bool ok; List(UInt(8)) body; Int from; Int to; };

Opened open_bad(Dir d) { return Opened {.d = d, .ok = false, .body = [], .from = 0, .to = 0}; }

// The packet is bytes [at, at + len) of buf, as received: length field,
// body, tag. It is read where it lies in the receive buffer.
@requires(declassify)
pub Opened open(Dir d, List(UInt(8)) buf, Int at, Int len) {
    if (len < 4 || at < 0 || at + len > buf.len()) { return open_bad(d); }
    Int end = at + len;
    if (d.kind == 0) { return unpad(dir_seq(d, next_seq(d.seq)), buf[at + 4..end]); }
    if (len < 4 + 16) { return open_bad(d); }
    if (d.kind == 1) {
        List(Secret(UInt(8))) k2 = d.key[0..32];
        List(Int) n = cc_nonce(d.seq);
        Int tag_at = end - 16;
        List(Secret(UInt(8))) poly_key = chachag_block(k2, 0, n)[0..32];
        List(Secret(UInt(8))) want = poly1305g(poly_key, lift_u8(buf[at..tag_at]));
        // The MAC is checked (publishing one bit) before anything is decrypted.
        if (!ct_same(want, lift_u8(buf[tag_at..end]))) { return open_bad(d); }
        List(UInt(8)) body = plain_bytes(chachag_xor(k2, 1, n, lift_u8(buf[at + 4..tag_at])));
        return unpad(dir_seq(d, next_seq(d.seq)), body);
    }
    // The received bytes go in packed, as they lie in the buffer.
    Option(List(Secret(UInt(8)))) pt = aes_gcmg_decrypt_k(d.gk, d.iv, buf[at + 4..end], buf[at..at + 4]);
    Dir nd = Dir {.kind = 2, .key = d.key, .gk = d.gk, .iv = gcm_next_iv(d.iv), .seq = next_seq(d.seq)};
    return match pt {
        None => open_bad(d),
        Some(body) => unpad(nd, plain_bytes(body)),
    };
}

Opened unpad(Dir nd, List(UInt(8)) body) {
    if (body.len() < 1) { return open_bad(nd); }
    Int pad = (Int) body[0];
    if (pad < 4 || 1 + pad > body.len()) { return open_bad(nd); }
    return Opened {.d = nd, .ok = true, .body = body, .from = 1, .to = body.len() - pad};
}
