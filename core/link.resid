// A Pylon protocol link (SPEC 9, 11): reliable streams over the UDP
// session that core/proto.resid sets up, for both ends. EXPERIMENTAL, as
// proto.resid. It carries port forwards and terminal sessions; rekeying is
// not implemented yet.
//
// One frame per datagram, inside an authenticated data packet:
//   OPEN   1 | sid (4) | port (2) | host length (1) | host   client -> pylond
//   DATA   2 | sid (4) | offset (8) | bytes
//   ACK    3 | sid (4) | offset (8)  every byte below offset arrived
//   FIN    4 | sid (4) | offset (8) [| exit code (1)]
//                                    the stream ends at offset (FIN takes
//                                    that offset, acknowledged as offset + 1);
//                                    a terminal's FIN carries its exit code
//   RST    5 | sid (4)
//   PING   6
//   SHELL  7 | sid (4) | rows (2) | cols (2)                 client -> pylond
//   RESIZE 9 | sid (4) | rows (2) | cols (2)                 client -> pylond
//   ATTACH 10 | sid (4) | session (4) | rows (2) | cols (2)  client -> pylond
//   LIST   11 | nonce (4)                                    client -> pylond
//   SESSIONS 12 | nonce (4) | count (1) | count x            pylond -> client
//            (session (4) | attached (1) | rows (2) | cols (2) | idle s (4) |
//             title length (1) | title)
//   LISTEN 13 | port (4)                                     client -> pylond
//   LISTENING 14 | port (4) | ok (1)                         pylond -> client
//   CONNECT 15 | sid (4) | port (2)                          pylond -> client
//   FILE   16 | sid (4) | op (1) | flags (1) | path          client -> pylond
// LIST and SESSIONS, LISTEN and LISTENING are not acknowledged: the client
// asks again until it has an answer for its nonce (port).
// OPEN, CONNECT and FILE are confirmed by the peer's ACK (offset 0) or by
// any frame of the stream, and sent again every rto until then; a repeat
// of one for a stream the peer has is confirmed again.
// Reliability is go-back-N: a sender keeps its unacknowledged bytes and,
// after 300 ms without progress, sends them again from the first one; a
// receiver takes only the next byte it expects. The window is 256 KiB.
//
// Two kinds of stream. A forward's local end is a TCP socket the link
// reads and writes itself. A terminal's ends (a pseudo-terminal in pylond,
// the user's terminal in the client) are "external": the link queues what
// arrives in the stream's inbox and the program around it moves bytes in
// and out (take_inbox, push_bytes, push_eof). So this file needs only the
// network, and the client never holds the right to start processes.
//
// Roaming: pylond answers to the address of the latest packet that
// authenticated, so a client that moves (Wi-Fi to cellular, a NAT that
// rebinds) continues without a new handshake.

import "crypto.resid";
import "wire.resid";
import "cipher.resid";
import "proto.resid";
import "addr.resid";

Int window_bytes() { return 262144; }
Int chunk_bytes() { return 1100; }
Int rto_ns() { return 300000000; }
pub Int key_life_ns() { return 180000000000; }

// A stream: id, local TCP socket (-1 for an external stream), the first
// unacknowledged offset and those bytes, the next offset to send, the
// next offset expected, whether the local side ended (and at what offset),
// whether the peer's FIN arrived, when progress was last made; for an
// external stream the bytes received and not yet taken, and the exit code
// to put in (or taken from) the FIN, -1 when none.
pub type St = { Int id; Int fd; Int acked; List(Int) unacked; Int next; Int recv; Bool eof; Int fin_at; Bool fin_in; Int progress;
    Bool ext; List(Int) inbox; Int code; List(Int) opening; Bool socks; };

// What happened that the program must act on: terminals asked for
// ([sid, rows, cols]), resizes ([sid, rows, cols]), terminal exits
// ([sid, code]), attaches ([sid, session, rows, cols]), session lists
// asked for ([nonce]) and received ([nonce, payload...]).
pub type Ev = { List(List(Int)) shells; List(List(Int)) resizes; List(List(Int)) exits; List(List(Int)) attaches; List(List(Int)) lists; List(List(Int)) sessions;
    List(List(Int)) connects; List(List(Int)) listens; List(List(Int)) listening; List(List(Int)) files; };

pub type Link = {
    Bool server; Int udp; List(Int) addr; Int port; SessionKeys k; Int tx_ctr; Window win;
    List(St) streams; Int next_sid; Int last_rx; Int last_tx; Str err; Ev ev; Int keyed;
};

Ev ev_none() { return Ev {.shells = [], .resizes = [], .exits = [], .attaches = [], .lists = [], .sessions = [], .connects = [], .listens = [], .listening = [], .files = []}; }

// One event added: kind 0 shell, 1 resize, 2 exit, 3 attach, 4 list, 5 sessions,
// 6 connect, 7 listen, 8 listening, 9 file.
Link ev_add(Link l, Int kind, List(Int) v) {
    Ev e = l.ev;
    Ev n = Ev {.shells = if (kind == 0) { e.shells.concat([v]) } else { e.shells }, .resizes = if (kind == 1) { e.resizes.concat([v]) } else { e.resizes },
        .exits = if (kind == 2) { e.exits.concat([v]) } else { e.exits }, .attaches = if (kind == 3) { e.attaches.concat([v]) } else { e.attaches },
        .lists = if (kind == 4 && e.lists.len() < 4) { e.lists.concat([v]) } else { e.lists }, .sessions = if (kind == 5) { e.sessions.concat([v]) } else { e.sessions },
        .connects = if (kind == 6) { e.connects.concat([v]) } else { e.connects }, .listens = if (kind == 7 && e.listens.len() < 16) { e.listens.concat([v]) } else { e.listens },
        .listening = if (kind == 8) { e.listening.concat([v]) } else { e.listening }, .files = if (kind == 9) { e.files.concat([v]) } else { e.files }};
    return with_ev(l, n);
}

pub Link link_new(Bool server, Int udp, List(Int) addr, Int port, SessionKeys k, Int now) {
    return Link {.server = server, .udp = udp, .addr = addr, .port = port, .k = k, .tx_ctr = 0, .win = window_new(),
        .streams = [], .next_sid = if (server) { 2 } else { 1 }, .last_rx = now, .last_tx = now, .err = "", .ev = ev_none(), .keyed = now};
}

Link with_streams(Link l, List(St) ss) {
    return Link {.server = l.server, .udp = l.udp, .addr = l.addr, .port = l.port, .k = l.k, .tx_ctr = l.tx_ctr, .win = l.win,
        .streams = ss, .next_sid = l.next_sid, .last_rx = l.last_rx, .last_tx = l.last_tx, .err = l.err, .ev = l.ev, .keyed = l.keyed};
}

Link with_ev(Link l, Ev e) {
    return Link {.server = l.server, .udp = l.udp, .addr = l.addr, .port = l.port, .k = l.k, .tx_ctr = l.tx_ctr, .win = l.win,
        .streams = l.streams, .next_sid = l.next_sid, .last_rx = l.last_rx, .last_tx = l.last_tx, .err = l.err, .ev = e, .keyed = l.keyed};
}

pub Link link_err(Link l, Str e) {
    return Link {.server = l.server, .udp = l.udp, .addr = l.addr, .port = l.port, .k = l.k, .tx_ctr = l.tx_ctr, .win = l.win,
        .streams = l.streams, .next_sid = l.next_sid, .last_rx = l.last_rx, .last_tx = l.last_tx, .err = e, .ev = l.ev, .keyed = l.keyed};
}

// The same streams over a new local socket (the client moved).
pub Link link_moved(Link l, Int udp) {
    return Link {.server = l.server, .udp = udp, .addr = l.addr, .port = l.port, .k = l.k, .tx_ctr = l.tx_ctr, .win = l.win,
        .streams = l.streams, .next_sid = l.next_sid, .last_rx = l.last_rx, .last_tx = l.last_tx, .err = l.err, .ev = l.ev, .keyed = l.keyed};
}

// The same streams under keys from a new handshake, to the peer at addr:port.
pub Link link_rekeyed(Link l, List(Int) addr, Int port, SessionKeys k, Int now) {
    return Link {.server = l.server, .udp = l.udp, .addr = addr, .port = port, .k = k, .tx_ctr = 0, .win = window_new(),
        .streams = l.streams, .next_sid = l.next_sid, .last_rx = now, .last_tx = now, .err = "", .ev = l.ev, .keyed = now};
}

// The events, handed to the program once.
pub Ev events(Link l) { return l.ev; }
pub Link events_taken(Link l) { return with_ev(l, ev_none()); }

// ============================================================================
// Sending
// ============================================================================

@requires(network, declassify)
pub Link send_frame(Link l, List(Int) frame, Int now) {
    List(Int) pkt = data_seal(l.k, l.tx_ctr, frame);
    _ = resid_udp_send_to(l.udp, l.addr, l.port, pkt);
    return Link {.server = l.server, .udp = l.udp, .addr = l.addr, .port = l.port, .k = l.k, .tx_ctr = l.tx_ctr + 1, .win = l.win,
        .streams = l.streams, .next_sid = l.next_sid, .last_rx = l.last_rx, .last_tx = now, .err = l.err, .ev = l.ev, .keyed = l.keyed};
}

List(Int) u16(Int v) { return [(v >> 8) & 255, v & 255]; }

List(Int) f_open(Int sid, Str host, Int port) { return [1].concat(u32_be(sid)).concat(u16(port)).concat([str_len(host)]).concat(bytes_of(host)); }
List(Int) f_data(Int sid, Int off, List(Int) b) { return [2].concat(u32_be(sid)).concat(u64_be(off)).concat(b); }
List(Int) f_ack(Int sid, Int off) { return [3].concat(u32_be(sid)).concat(u64_be(off)); }
List(Int) f_fin(Int sid, Int off, Int code) { return [4].concat(u32_be(sid)).concat(u64_be(off)).concat(if (code >= 0) { [code & 255] } else { [] }); }
List(Int) f_rst(Int sid) { return [5].concat(u32_be(sid)); }
List(Int) f_shell(Int sid, Int rows, Int cols) { return [7].concat(u32_be(sid)).concat(u16(rows)).concat(u16(cols)); }
List(Int) f_resize(Int sid, Int rows, Int cols) { return [9].concat(u32_be(sid)).concat(u16(rows)).concat(u16(cols)); }

Int be64(List(Int) b, Int i) { return (be32(b, i) << 32) | be32(b, i + 4); }

pub Int find(List(St) ss, Int id, Int i) {
    if (i >= ss.len()) { return -1; }
    if (ss[i].id == id) { return i; }
    return find(ss, id, i + 1);
}

List(St) put(List(St) ss, Int i, St v) { return ss[0..i].concat([v]).concat(ss[i + 1..ss.len()]); }
List(St) drop(List(St) ss, Int i) { return ss[0..i].concat(ss[i + 1..ss.len()]); }

pub St st_new(Int id, Int fd, Int now) {
    return St {.id = id, .fd = fd, .acked = 0, .unacked = [], .next = 0, .recv = 0, .eof = false, .fin_at = -1, .fin_in = false, .progress = now,
        .ext = fd < 0, .inbox = [], .code = -1, .opening = [], .socks = false};
}

// Copies of a stream with one part changed.
St st_sent(St s, List(Int) unacked, Int next, Int progress) {
    return St {.id = s.id, .fd = s.fd, .acked = s.acked, .unacked = unacked, .next = next, .recv = s.recv, .eof = s.eof, .fin_at = s.fin_at, .fin_in = s.fin_in, .progress = progress,
        .ext = s.ext, .inbox = s.inbox, .code = s.code, .opening = s.opening, .socks = s.socks};
}

St st_ended(St s, Int at, Int code, Int now) {
    return St {.id = s.id, .fd = s.fd, .acked = s.acked, .unacked = s.unacked, .next = s.next, .recv = s.recv, .eof = true, .fin_at = at, .fin_in = s.fin_in, .progress = now,
        .ext = s.ext, .inbox = s.inbox, .code = code, .opening = s.opening, .socks = s.socks};
}

St st_progress(St s, Int now) {
    return St {.id = s.id, .fd = s.fd, .acked = s.acked, .unacked = s.unacked, .next = s.next, .recv = s.recv, .eof = s.eof, .fin_at = s.fin_at, .fin_in = s.fin_in, .progress = now,
        .ext = s.ext, .inbox = s.inbox, .code = s.code, .opening = s.opening, .socks = s.socks};
}

St st_recv(St s, Int recv, List(Int) inbox) {
    return St {.id = s.id, .fd = s.fd, .acked = s.acked, .unacked = s.unacked, .next = s.next, .recv = recv, .eof = s.eof, .fin_at = s.fin_at, .fin_in = s.fin_in, .progress = s.progress,
        .ext = s.ext, .inbox = inbox, .code = s.code, .opening = s.opening, .socks = s.socks};
}

St st_acked(St s, Int d, Int fin_at, Int now) {
    return St {.id = s.id, .fd = s.fd, .acked = s.acked + d, .unacked = s.unacked[d..s.unacked.len()], .next = s.next, .recv = s.recv, .eof = s.eof, .fin_at = fin_at, .fin_in = s.fin_in, .progress = now,
        .ext = s.ext, .inbox = s.inbox, .code = s.code, .opening = s.opening, .socks = s.socks};
}

St st_fin_in(St s, Bool fin_in, Int code) {
    return St {.id = s.id, .fd = s.fd, .acked = s.acked, .unacked = s.unacked, .next = s.next, .recv = s.recv, .eof = s.eof, .fin_at = s.fin_at, .fin_in = fin_in, .progress = s.progress,
        .ext = s.ext, .inbox = s.inbox, .code = if (code >= 0) { code } else { s.code }, .opening = s.opening, .socks = s.socks};
}

// A stream that waits for its peer's confirmation (an ACK or DATA): its
// opening frame is sent again every rto until then.
St st_opening(St s, List(Int) f, Bool socks) {
    return St {.id = s.id, .fd = s.fd, .acked = s.acked, .unacked = s.unacked, .next = s.next, .recv = s.recv, .eof = s.eof, .fin_at = s.fin_at, .fin_in = s.fin_in, .progress = s.progress,
        .ext = s.ext, .inbox = s.inbox, .code = s.code, .opening = f, .socks = socks};
}

// A SOCKS5 reply with an unspecified bound address (RFC 1928 6).
pub List(Int) socks_reply(Int code) { return [5, code, 0, 1, 0, 0, 0, 0, 0, 0]; }

// A new outgoing stream (the client's -L, -D): OPEN, then the stream.
@requires(network, declassify)
pub Link open_stream(Link l, Int fd, Str host, Int port, Int now) { return open_stream_as(l, fd, host, port, false, now); }

// The same for a SOCKS client (-D), which waits for its reply: success
// once pylond confirms the stream, failure when it resets it.
@requires(network, declassify)
pub Link open_stream_as(Link l, Int fd, Str host, Int port, Bool socks, Int now) {
    Int sid = l.next_sid;
    List(Int) f = f_open(sid, host, port);
    Link l2 = send_frame(l, f, now);
    Link l3 = with_streams(l2, l2.streams.concat([st_opening(st_new(sid, fd, now), f, socks)]));
    return Link {.server = l3.server, .udp = l3.udp, .addr = l3.addr, .port = l3.port, .k = l3.k, .tx_ctr = l3.tx_ctr, .win = l3.win,
        .streams = l3.streams, .next_sid = sid + 2, .last_rx = l3.last_rx, .last_tx = l3.last_tx, .err = l3.err, .ev = l3.ev, .keyed = l3.keyed};
}

// A terminal on pylond (the client): SHELL, then an external stream.
// Returns the link; the new stream's id is the old next_sid.
@requires(network, declassify)
pub Link open_shell(Link l, Int rows, Int cols, Int now) {
    Int sid = l.next_sid;
    Link l2 = send_frame(l, f_shell(sid, rows, cols), now);
    Link l3 = with_streams(l2, l2.streams.concat([st_new(sid, -1, now)]));
    return Link {.server = l3.server, .udp = l3.udp, .addr = l3.addr, .port = l3.port, .k = l3.k, .tx_ctr = l3.tx_ctr, .win = l3.win,
        .streams = l3.streams, .next_sid = sid + 2, .last_rx = l3.last_rx, .last_tx = l3.last_tx, .err = l3.err, .ev = l3.ev, .keyed = l3.keyed};
}

// Attach to a session pylond keeps (the client): ATTACH, then an
// external stream whose first bytes repaint the session's screen.
@requires(network, declassify)
pub Link attach(Link l, Int session, Int rows, Int cols, Int now) {
    Int sid = l.next_sid;
    List(Int) f = [10].concat(u32_be(sid)).concat(u32_be(session)).concat(u16(rows)).concat(u16(cols));
    Link l2 = send_frame(l, f, now);
    Link l3 = with_streams(l2, l2.streams.concat([st_new(sid, -1, now)]));
    return Link {.server = l3.server, .udp = l3.udp, .addr = l3.addr, .port = l3.port, .k = l3.k, .tx_ctr = l3.tx_ctr, .win = l3.win,
        .streams = l3.streams, .next_sid = sid + 2, .last_rx = l3.last_rx, .last_tx = l3.last_tx, .err = l3.err, .ev = l3.ev, .keyed = l3.keyed};
}

// Ask pylond for its sessions (answered with SESSIONS for this nonce).
@requires(network, declassify)
pub Link ask_sessions(Link l, Int nonce, Int now) { return send_frame(l, [11].concat(u32_be(nonce)), now); }

// Ask pylond to listen on its loopback port (-R; answered with LISTENING).
@requires(network, declassify)
pub Link ask_listen(Link l, Int port, Int now) { return send_frame(l, [13].concat(u32_be(port)), now); }

// pylond's answer to LISTEN.
@requires(network, declassify)
pub Link answer_listen(Link l, Int port, Bool ok, Int now) { return send_frame(l, [14].concat(u32_be(port)).concat([if (ok) { 1 } else { 0 }]), now); }

// pylond: a connection accepted on a client's -R port becomes a stream
// toward the client (CONNECT, sent again until the client confirms).
@requires(network, declassify)
pub Link connect_back(Link l, Int fd, Int port, Int now) {
    Int sid = l.next_sid;
    List(Int) f = [15].concat(u32_be(sid)).concat(u16(port));
    Link l2 = send_frame(l, f, now);
    Link l3 = with_streams(l2, l2.streams.concat([st_opening(st_new(sid, fd, now), f, false)]));
    return Link {.server = l3.server, .udp = l3.udp, .addr = l3.addr, .port = l3.port, .k = l3.k, .tx_ctr = l3.tx_ctr, .win = l3.win,
        .streams = l3.streams, .next_sid = sid + 2, .last_rx = l3.last_rx, .last_tx = l3.last_tx, .err = l3.err, .ev = l3.ev, .keyed = l3.keyed};
}

// The client: a CONNECT it accepted (fd connected to the -R forward's
// destination), confirmed with an ACK.
@requires(network, declassify)
pub Link accept_connect(Link l, Int sid, Int fd, Int now) {
    if (open_sid(l, sid)) { return l; }
    _ = resid_tcp_deadline(fd, 0);
    return send_frame(with_streams(l, l.streams.concat([st_new(sid, fd, now)])), f_ack(sid, 0), now);
}

// A file transfer (the client): FILE, then an external stream carrying
// the transfer (core/files.resid). op 0 get, 1 put; flags bit 0 resume.
@requires(network, declassify)
pub Link open_file(Link l, Int op, Int flags, List(Int) path, Int now) {
    Int sid = l.next_sid;
    List(Int) f = [16].concat(u32_be(sid)).concat([op, flags]).concat(path);
    Link l2 = send_frame(l, f, now);
    Link l3 = with_streams(l2, l2.streams.concat([st_opening(st_new(sid, -1, now), f, false)]));
    return Link {.server = l3.server, .udp = l3.udp, .addr = l3.addr, .port = l3.port, .k = l3.k, .tx_ctr = l3.tx_ctr, .win = l3.win,
        .streams = l3.streams, .next_sid = sid + 2, .last_rx = l3.last_rx, .last_tx = l3.last_tx, .err = l3.err, .ev = l3.ev, .keyed = l3.keyed};
}

// pylond: a FILE request it took on (the stream is confirmed).
@requires(network, declassify)
pub Link confirm(Link l, Int sid, Int now) { return send_frame(l, f_ack(sid, 0), now); }

// The client's terminal changed size. Sent twice: it is not acknowledged,
// and the latest size is sent again with every keepalive (resend_size).
@requires(network, declassify)
pub Link resize(Link l, Int sid, Int rows, Int cols, Int now) {
    return send_frame(send_frame(l, f_resize(sid, rows, cols), now), f_resize(sid, rows, cols), now);
}

// Send what the window allows from position `from` of the unacked bytes.
@requires(network, declassify)
Link send_from(Link l, St s, Int from, Int budget, Int now) {
    if (budget <= 0 || from >= s.unacked.len()) { return l; }
    Int n = if (s.unacked.len() - from < chunk_bytes()) { s.unacked.len() - from } else { chunk_bytes() };
    Link l2 = send_frame(l, f_data(s.id, s.acked + from, s.unacked[from..from + n]), now);
    return send_from(l2, s, from + n, budget - 1, now);
}

// Room in stream i's window, 0 when it ended or is unknown.
pub Int room(Link l, Int sid) {
    Int i = find(l.streams, sid, 0);
    if (i < 0 || l.streams[i].eof) { return 0; }
    return window_bytes() - l.streams[i].unacked.len();
}

// Bytes from a stream's local end into its window, and sent.
@requires(network, declassify)
Link push_at(Link l, Int i, List(Int) d, Int now) {
    St s = l.streams[i];
    Int start = s.unacked.len();
    St s2 = st_sent(s, s.unacked.concat(d), s.acked + start + d.len(), if (start == 0) { now } else { s.progress });
    return send_from(with_streams(l, put(l.streams, i, s2)), s2, start, 64, now);
}

// The local end ended (code: a terminal's exit code, or -1).
@requires(network, declassify)
Link eof_at(Link l, Int i, Int code, Int now) {
    St s = l.streams[i];
    if (s.eof) { return l; }
    Int at = s.acked + s.unacked.len();
    return send_frame(with_streams(l, put(l.streams, i, st_ended(s, at, code, now))), f_fin(s.id, at, code), now);
}

// An external stream's local end: bytes that arrived there (at most room())...
@requires(network, declassify)
pub Link push_bytes(Link l, Int sid, List(Int) d, Int now) {
    Int i = find(l.streams, sid, 0);
    if (i < 0 || d.len() == 0 || l.streams[i].eof) { return l; }
    return push_at(l, i, d, now);
}

// ... and its end, with a terminal's exit code (or -1).
@requires(network, declassify)
pub Link push_eof(Link l, Int sid, Int code, Int now) {
    Int i = find(l.streams, sid, 0);
    if (i < 0) { return l; }
    return finish(eof_at(l, i, code, now), find(l.streams, sid, 0));
}

// What the peer sent on an external stream, not yet taken.
pub List(Int) inbox(Link l, Int sid) {
    Int i = find(l.streams, sid, 0);
    return if (i < 0) { [] } else { l.streams[i].inbox };
}

// The first n inbox bytes were written out locally.
@requires(network)
pub Link take_inbox(Link l, Int sid, Int n) {
    Int i = find(l.streams, sid, 0);
    if (i < 0 || n <= 0) { return l; }
    St s = l.streams[i];
    Int k = if (n > s.inbox.len()) { s.inbox.len() } else { n };
    return finish(with_streams(l, put(l.streams, i, st_recv(s, s.recv, s.inbox[k..s.inbox.len()]))), i);
}

// Bytes sent on a stream and not yet acknowledged (0 when unknown).
pub Int unsent(Link l, Int sid) {
    Int i = find(l.streams, sid, 0);
    return if (i < 0) { 0 } else { l.streams[i].unacked.len() };
}

// Whether a stream is still open (its id is known).
pub Bool open_sid(Link l, Int sid) { return find(l.streams, sid, 0) >= 0; }

// Whether the peer ended the stream (all its bytes are in the inbox).
pub Bool peer_ended(Link l, Int sid) {
    Int i = find(l.streams, sid, 0);
    return i < 0 || l.streams[i].fin_in;
}

// Local bytes from a forward's socket into the window.
@requires(network, declassify)
Link read_local(Link l, Int i, Int now) {
    St s = l.streams[i];
    Int rm = window_bytes() - s.unacked.len();
    if (rm <= 0 || s.eof || s.ext) { return l; }
    List(Int) d = resid_tcp_recv_some(s.fd, if (rm < 16384) { rm } else { 16384 });
    if (d.len() == 0) { return eof_at(l, i, -1, now); }
    return push_at(l, i, d, now);
}

// Go-back-N: after rto without progress, everything unacknowledged again.
@requires(network, declassify)
pub Link retransmit(Link l, Int i, Int now) {
    if (i >= l.streams.len()) { return l; }
    St s = l.streams[i];
    Bool waiting = s.unacked.len() > 0 || (s.fin_at >= 0 && s.acked <= s.fin_at) || s.opening.len() > 0;
    if (!waiting || now - s.progress < rto_ns()) { return retransmit(l, i + 1, now); }
    St s2 = st_progress(s, now);
    Link l0 = if (s.opening.len() > 0) { send_frame(l, s.opening, now) } else { l };
    Link l1 = send_from(with_streams(l0, put(l0.streams, i, s2)), s2, 0, 64, now);
    Link l2 = if (s.fin_at >= 0 && s.unacked.len() == 0) { send_frame(l1, f_fin(s.id, s.fin_at, s.code), now) } else { l1 };
    return retransmit(l2, i + 1, now);
}

// ============================================================================
// Receiving
// ============================================================================

// One authenticated datagram's frame. Only pylond accepts OPEN, SHELL,
// RESIZE, ATTACH, LIST, LISTEN and FILE; only the client CONNECT,
// SESSIONS and LISTENING. A repeated OPEN or CONNECT (its confirmation
// was lost) is confirmed again.
@requires(network, declassify)
pub Link on_frame(Link l, List(Int) f, Int now) {
    if (f.len() == 0) { return l; }
    Int t = f[0];
    if (t == 6) { return l; }
    if (f.len() < 5) { return l; }
    Int sid = be32(f, 1);
    Int i = find(l.streams, sid, 0);
    if (t == 1 || t == 15) {
        Bool mine = if (t == 1) { l.server } else { !l.server };
        if (!mine) { return l; }
        if (i >= 0) { return send_frame(l, f_ack(sid, l.streams[i].recv), now); }
        if (t == 1) { return on_open(l, sid, f, now); }
        return if (f.len() == 7 && sid % 2 == 0) { ev_add(l, 6, [sid, f[5] * 256 + f[6]]) } else { l };
    }
    if (t == 13) { return if (l.server && f.len() == 5) { ev_add(l, 7, [sid]) } else { l }; }
    if (t == 14) { return if (!l.server && f.len() == 6) { ev_add(l, 8, [sid, f[5]]) } else { l }; }
    if (t == 16) {
        if (!l.server || sid % 2 != 1 || f.len() < 8 || f.len() > 4096 + 7) { return l; }
        if (i >= 0) { return send_frame(l, f_ack(sid, l.streams[i].recv), now); }
        return ev_add(with_streams(l, l.streams.concat([st_new(sid, -1, now)])), 9, [sid, f[5], f[6]].concat(f[7..f.len()]));
    }
    if (t == 7) { return if (l.server && i < 0 && f.len() == 9 && sid % 2 == 1) { on_shell(l, sid, f, now) } else { l }; }
    if (t == 9) {
        Bool ok = l.server && i >= 0 && f.len() == 9 && l.streams[i].ext;
        return if (ok) { ev_add(l, 1, [sid, f[5] * 256 + f[6], f[7] * 256 + f[8]]) } else { l };
    }
    if (t == 10) {
        Bool ok = l.server && i < 0 && f.len() == 13 && sid % 2 == 1;
        return if (ok) { ev_add(with_streams(l, l.streams.concat([st_new(sid, -1, now)])), 3, [sid, be32(f, 5), f[9] * 256 + f[10], f[11] * 256 + f[12]]) } else { l };
    }
    if (t == 11) { return if (l.server && f.len() == 5) { ev_add(l, 4, [sid]) } else { l }; }
    if (t == 12) { return if (!l.server) { ev_add(l, 5, [sid].concat(f[5..f.len()])) } else { l }; }
    // A stream unknown here is reset, unless the program has yet to take
    // up its CONNECT (its bytes come again once it has).
    if (i < 0) { return if ((t == 2 || t == 4) && !pending(l.ev.connects, sid, 0)) { send_frame(l, f_rst(sid), now) } else { l }; }
    St s0 = l.streams[i];
    if (t == 5) {
        _ = if (s0.socks && s0.opening.len() > 0) { resid_tcp_send_bin(s0.fd, socks_reply(5)) } else { true };
        _ = if (s0.ext) { true } else { resid_tcp_close(s0.fd) };
        Link gone = with_streams(l, drop(l.streams, i));
        return if (s0.ext) { ev_add(gone, 2, [sid, -1]) } else { gone };
    }
    if (f.len() < 13) { return l; }
    // The peer has the stream: it is confirmed (a SOCKS client gets its
    // success reply now).
    Bool confirmed = s0.opening.len() > 0 && (t == 2 || t == 3 || t == 4);
    _ = if (confirmed && s0.socks) { resid_tcp_send_bin(s0.fd, socks_reply(0)) } else { true };
    St s = if (confirmed) { st_opening(s0, [], false) } else { s0 };
    return on_stream(if (confirmed) { with_streams(l, put(l.streams, i, s)) } else { l }, t, sid, i, s, f, now);
}

Bool pending(List(List(Int)) cs, Int sid, Int i) {
    if (i >= cs.len()) { return false; }
    return cs[i][0] == sid || pending(cs, sid, i + 1);
}

// DATA, ACK and FIN for stream i (s).
@requires(network, declassify)
Link on_stream(Link l, Int t, Int sid, Int i, St s, List(Int) f, Int now) {
    Int off = be64(f, 5);
    if (t == 2) {
        List(Int) b = f[13..f.len()];
        // An external stream's inbox is bounded by the window: past it,
        // nothing is taken (and not acknowledged) until the program drains it.
        Bool fits = !s.ext || s.inbox.len() + b.len() <= window_bytes();
        Bool next = off == s.recv && !s.fin_in && fits;
        _ = if (next && !s.ext) { resid_tcp_send_bin(s.fd, b) } else { true };
        Int recv = if (next) { s.recv + b.len() } else { s.recv };
        St s2 = st_recv(s, recv, if (next && s.ext) { s.inbox.concat(b) } else { s.inbox });
        return send_frame(with_streams(l, put(l.streams, i, s2)), f_ack(sid, recv), now);
    }
    if (t == 3) {
        Int got = if (off > s.acked + s.unacked.len()) { s.acked + s.unacked.len() } else { off };
        Int done = got - s.acked;
        Bool fin_acked = s.fin_at >= 0 && off == s.fin_at + 1;
        if (done <= 0 && !fin_acked) { return l; }
        Int d = if (done > 0) { done } else { 0 };
        St s2 = st_acked(s, d, if (fin_acked) { -2 } else { s.fin_at }, now);
        return finish(with_streams(l, put(l.streams, i, s2)), i);
    }
    if (t == 4) {
        Bool here = off == s.recv;
        Int code = if (f.len() == 14) { f[13] } else { -1 };
        _ = if (here && !s.fin_in && !s.ext) { resid_tcp_shutdown(s.fd) } else { true };
        Bool first = here && !s.fin_in;
        St s2 = st_fin_in(s, s.fin_in || here, code);
        Link l1 = if (here || s.fin_in) { send_frame(with_streams(l, put(l.streams, i, s2)), f_ack(sid, off + 1), now) } else { l };
        Link l2 = if (first && s.ext && !l.server) { ev_add(l1, 2, [sid, code]) } else { l1 };
        return finish(l2, i);
    }
    return l;
}

// A stream both of whose sides have ended (our FIN acknowledged: fin_at
// -2) is closed and forgotten; an external one once its inbox is taken.
@requires(network)
Link finish(Link l, Int i) {
    if (i < 0 || i >= l.streams.len()) { return l; }
    St s = l.streams[i];
    if (s.fin_at != -2 || !s.fin_in || s.inbox.len() > 0) { return l; }
    _ = if (s.ext) { true } else { resid_tcp_close(s.fd) };
    return with_streams(l, drop(l.streams, i));
}

// pylond: OPEN connects to host:port as the server sees it.
@requires(network, declassify)
Link on_open(Link l, Int sid, List(Int) f, Int now) {
    if (f.len() < 8) { return l; }
    Int port = f[5] * 256 + f[6];
    Int hl = f[7];
    if (f.len() != 8 + hl || hl == 0) { return send_frame(l, f_rst(sid), now); }
    Str host = ascii_text(f[8..8 + hl]);
    Int fd = resid_tcp_connect(host, port);
    if (fd < 0) { return send_frame(l, f_rst(sid), now); }
    _ = resid_tcp_deadline(fd, 0);
    return send_frame(with_streams(l, l.streams.concat([st_new(sid, fd, now)])), f_ack(sid, 0), now);
}

// pylond: SHELL makes an external stream and asks the program for a
// terminal (it answers RST through refuse() when it cannot make one).
Link on_shell(Link l, Int sid, List(Int) f, Int now) {
    Int rows = f[5] * 256 + f[6];
    Int cols = f[7] * 256 + f[8];
    return ev_add(with_streams(l, l.streams.concat([st_new(sid, -1, now)])), 0, [sid, rows, cols]);
}

// The program could not serve an external stream: RST, and forget it.
@requires(network, declassify)
pub Link refuse(Link l, Int sid, Int now) {
    Int i = find(l.streams, sid, 0);
    Link l2 = if (i >= 0) { with_streams(l, drop(l.streams, i)) } else { l };
    return send_frame(l2, f_rst(sid), now);
}

// ============================================================================
// The loop
// ============================================================================

// Forward sockets with room in their window.
pub List(Int) stream_fds(List(St) ss, Int i, List(Int) acc) {
    if (i >= ss.len()) { return acc; }
    Bool want = !ss[i].ext && !ss[i].eof && ss[i].unacked.len() < window_bytes();
    return stream_fds(ss, i + 1, if (want) { acc.concat([ss[i].fd]) } else { acc });
}

Int st_of_fd(List(St) ss, Int fd, Int i) {
    if (i >= ss.len()) { return -1; }
    if (!ss[i].ext && ss[i].fd == fd) { return i; }
    return st_of_fd(ss, fd, i + 1);
}

@requires(network, declassify)
pub Link read_streams(Link l, List(Int) fds, List(Int) ready, Int at, Int i, Int now) {
    if (i >= fds.len()) { return l; }
    Bool r = at + i < ready.len() && (ready[at + i] & 1) != 0;
    Int k = st_of_fd(l.streams, fds[i], 0);
    Link n = if (r && k >= 0) { read_local(l, k, now) } else { l };
    return read_streams(n, fds, ready, at, i + 1, now);
}

// Every waiting datagram: authenticated data for this link is taken (and,
// on pylond, its source becomes the peer address); everything else is
// returned for the caller (pylond answers handshakes) or dropped.
pub type Drained = { Link l; List(List(Int)) other; };

@requires(network, declassify)
pub Drained drain(Link l, Int now, Int budget, List(List(Int)) other) {
    if (budget <= 0) { return Drained {.l = l, .other = other}; }
    List(Int) d = resid_udp_recv_from(l.udp, 2048);
    if (d.len() == 0) { return Drained {.l = l, .other = other}; }
    if (!dg_ok(d)) { return drain(l, now, budget - 1, other); }
    if (!for_link(l, d)) { return drain(l, now, budget - 1, other.concat([d])); }
    return drain(link_input(l, d, now), now, budget - 1, other);
}

// Whether a received datagram (core/addr.resid) is a data packet for this
// link's keys.
pub Bool for_link(Link l, List(Int) d) { return dg_len(d) > 0 && l.k.ok && data_idx(dg_body(d)) == l.k.my_idx; }

// One received datagram for this link: opened, checked against the replay
// window, and its frame handled; dropped silently when it fails.
@requires(network, declassify)
pub Link link_input(Link l, List(Int) d, Int now) {
    // Keys older than 3 minutes are refused (SPEC 9.5): a client rekeys
    // every 2 minutes.
    if (l.server && now - l.keyed > key_life_ns()) { return l; }
    DataIn o = data_open(l.k, dg_body(d));
    if (!o.ok) { return l; }
    Seen sn = window_take(l.win, o.ctr);
    if (!sn.fresh) { return l; }
    // Roaming: pylond follows the client to the address it now sends from.
    List(Int) addr = if (l.server) { dg_addr(d) } else { l.addr };
    Int port = if (l.server) { dg_port(d) } else { l.port };
    Link l2 = Link {.server = l.server, .udp = l.udp, .addr = addr, .port = port, .k = l.k, .tx_ctr = l.tx_ctr, .win = sn.w,
        .streams = l.streams, .next_sid = l.next_sid, .last_rx = now, .last_tx = l.last_tx, .err = l.err, .ev = l.ev, .keyed = l.keyed};
    return on_frame(l2, o.payload, now);
}

// Every stream's external end (pylond detaching a client: its terminals
// stay, their streams go).
pub List(Int) ext_sids(Link l) { return ext_acc(l.streams, 0, []); }
List(Int) ext_acc(List(St) ss, Int i, List(Int) acc) {
    if (i >= ss.len()) { return acc; }
    return ext_acc(ss, i + 1, if (ss[i].ext) { acc.concat([ss[i].id]) } else { acc });
}

// A keepalive after 10 s of sending nothing (keeps NAT bindings and the
// server's view of our address current).
@requires(network, declassify)
pub Link keepalive(Link l, Int now) {
    if (now - l.last_tx < 10000000000) { return l; }
    return send_frame(l, [6], now);
}
