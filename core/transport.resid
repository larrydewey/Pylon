// The SSH transport (RFC 4253) over a TCP socket: version exchange, the
// first key exchange under strict kex, host verification before any
// keyed packet is sent, server-initiated rekeying, and the packet loop's
// handling of transport-level messages.
//
// Phase 0 drives the socket directly and blocks on reads. The state is a
// value (Conn) threaded through every call, which is what lets the same
// functions become the sans-I/O core of SPEC 4 behind the app's own
// event loop.

import "crypto.resid";
import "wire.resid";
import "cipher.resid";
import "hostkey.resid";
import "kex.resid";
import "dnssec.resid";

pub Int msg_disconnect() { return 1; }
pub Int msg_ignore() { return 2; }
pub Int msg_unimplemented() { return 3; }
pub Int msg_debug() { return 4; }
pub Int msg_service_request() { return 5; }
pub Int msg_service_accept() { return 6; }
pub Int msg_ext_info() { return 7; }
pub Int msg_global_request() { return 80; }
pub Int msg_request_failure() { return 82; }

pub Str our_version() { return "SSH-2.0-Pylon_0.1"; }

// sid: the session identifier (H of the first exchange). host_blob and
// host_sig: the verified host key and its signature over sid, kept for
// session-bind. strict: strict kex was agreed. sig_algs / hostbound: what
// the server's EXT_INFO said. err: why the connection is unusable, or "".
pub type Conn = {
    Int fd; Dir tx; Dir rx; List(Int) buf; Bool eof; Str err;
    Str v_s; List(Int) sid; List(Int) host_blob; List(Int) host_sig; Str host_alg;
    Bool strict; List(Str) sig_algs; Bool hostbound; Bool ping;
};

pub Conn conn_err(Conn c, Str e) {
    return Conn {.fd = c.fd, .tx = c.tx, .rx = c.rx, .buf = c.buf, .eof = c.eof, .err = e,
        .v_s = c.v_s, .sid = c.sid, .host_blob = c.host_blob, .host_sig = c.host_sig, .host_alg = c.host_alg,
        .strict = c.strict, .sig_algs = c.sig_algs, .hostbound = c.hostbound, .ping = c.ping};
}

Conn with_io(Conn c, Dir tx, Dir rx, List(Int) buf, Bool eof) {
    return Conn {.fd = c.fd, .tx = tx, .rx = rx, .buf = buf, .eof = eof, .err = c.err,
        .v_s = c.v_s, .sid = c.sid, .host_blob = c.host_blob, .host_sig = c.host_sig, .host_alg = c.host_alg,
        .strict = c.strict, .sig_algs = c.sig_algs, .hostbound = c.hostbound, .ping = c.ping};
}

// The connection as it is, rebuilt field by field. Transport functions
// return this rather than their argument itself, so Resid's key-entropy
// check (E0270) keeps each field's origin apart instead of treating the
// whole record as one value (SPEC I6).
pub Conn same(Conn c) { return with_io(c, c.tx, c.rx, c.buf, c.eof); }

pub Conn conn_new(Int fd) {
    return Conn {.fd = fd, .tx = dir_none(), .rx = dir_none(), .buf = [], .eof = false, .err = "",
        .v_s = "", .sid = [], .host_blob = [], .host_sig = [], .host_alg = "",
        .strict = false, .sig_algs = [], .hostbound = false, .ping = false};
}

pub Bool conn_ok(Conn c) { return str_len(c.err) == 0; }

// ============================================================================
// Bytes
// ============================================================================

// Read until the buffer holds at least n bytes or the peer is done.
@requires(network, declassify)
Conn fill(Conn c, Int n) {
    if (c.buf.len() >= n || c.eof) { return same(c); }
    List(Int) more = resid_tcp_recv_some(c.fd, 65536);
    if (more.len() == 0) { return with_io(c, c.tx, c.rx, c.buf, true); }
    return fill(with_io(c, c.tx, c.rx, c.buf.concat(more), false), n);
}

@requires(network, declassify)
pub Conn send_raw(Conn c, List(Int) b) {
    if (!conn_ok(c)) { return same(c); }
    if (!resid_tcp_send_bin(c.fd, b)) { return conn_err(c, "the connection closed while sending"); }
    return same(c);
}

// ============================================================================
// Version exchange (RFC 4253 4.2)
// ============================================================================

// Lines before the version line are allowed (at most 1024, each at most
// 255 bytes); the version must be SSH-2.0 (or 1.99, which means 2.0).
@requires(network, declassify)
pub Conn version_exchange(Conn c0) {
    Conn c = send_raw(c0, bytes_of(our_version() + "\r\n"));
    return read_version(c, 0);
}

@requires(network, declassify)
Conn read_version(Conn c, Int lines) {
    if (!conn_ok(c)) { return same(c); }
    if (lines > 1024) { return conn_err(c, "the server sent no version line"); }
    Int nl = index_of_nl(c.buf, 0);
    if (nl < 0) {
        if (c.buf.len() > 255) { return conn_err(c, "the server's banner line is too long"); }
        if (c.eof) { return conn_err(c, "the server closed the connection before its version line"); }
        return read_version(fill(c, c.buf.len() + 1), lines);
    }
    if (nl > 255) { return conn_err(c, "the server's banner line is too long"); }
    Int end = if (nl > 0 && c.buf[nl - 1] == 13) { nl - 1 } else { nl };
    Str line = ascii_text(c.buf[0..end]);
    Conn rest = with_io(c, c.tx, c.rx, c.buf[nl + 1..c.buf.len()], c.eof);
    if (!str_starts_with(line, "SSH-")) { return read_version(rest, lines + 1); }
    if (!str_starts_with(line, "SSH-2.0-") && !str_starts_with(line, "SSH-1.99-")) { return conn_err(rest, "the server does not speak SSH 2.0"); }
    return Conn {.fd = rest.fd, .tx = rest.tx, .rx = rest.rx, .buf = rest.buf, .eof = rest.eof, .err = "",
        .v_s = line, .sid = [], .host_blob = [], .host_sig = [], .host_alg = "",
        .strict = false, .sig_algs = [], .hostbound = false, .ping = false};
}

Int index_of_nl(List(Int) b, Int i) {
    if (i >= b.len()) { return -1; }
    if (b[i] == 10) { return i; }
    return index_of_nl(b, i + 1);
}

// ============================================================================
// Packets
// ============================================================================

@requires(network, declassify)
pub Conn send_packet(Conn c, List(Int) payload) {
    if (!conn_ok(c)) { return same(c); }
    Sealed s = seal(c.tx, payload);
    Conn c2 = with_io(c, s.d, c.rx, c.buf, c.eof);
    return send_raw(c2, s.out);
}

pub type Pkt = { Conn c; List(Int) p; };

Pkt pkt_err(Conn c, Str e) { return Pkt {.c = conn_err(c, e), .p = []}; }

// The next packet's payload, whatever its type. Written with one success
// and one failure return (not one per check), which also keeps the
// compiler's key-entropy check precise about the connection's fields.
@requires(network, declassify)
pub Pkt recv_packet(Conn c0) {
    if (!conn_ok(c0)) { return Pkt {.c = same(c0), .p = []}; }
    Conn c = fill(c0, 4);
    Int need = if (c.buf.len() < 4) { -2 } else { need_after_len(c.rx, c.buf[0..4]) };
    Conn c2 = if (need >= 0) { fill(c, 4 + need) } else { same(c) };
    Bool whole = need >= 0 && c2.buf.len() >= 4 + need;
    Opened o = if (whole) { open(c2.rx, c2.buf[0..4 + need]) } else { Opened {.d = c2.rx, .ok = false, .payload = []} };
    Str err = if (need == -2) { "the server closed the connection" }
        else { if (need < 0) { "the server sent a malformed packet" }
        else { if (!whole) { "the server closed the connection mid-packet" }
        else { if (!o.ok) { "a packet from the server failed authentication" }
        else { if (o.payload.len() == 0) { "the server sent an empty packet" } else { "" } } } } };
    if (str_len(err) > 0) { return Pkt {.c = conn_err(c2, err), .p = []}; }
    return Pkt {.c = with_io(c2, c2.tx, o.d, c2.buf[4 + need..c2.buf.len()], c2.eof), .p = o.payload};
}

// The reason a DISCONNECT gives, made safe to print.
pub Str disconnect_reason(List(Int) p) {
    GotInt code = rd_u32(rd_at(p, 1));
    Got desc = rd_str(code.r);
    return "the server disconnected: " + display_text(desc.v) + " (code " + f"{code.v}" + ")";
}

// The next packet that is not a transport-level message: IGNORE, DEBUG
// and UNIMPLEMENTED are dropped, GLOBAL_REQUEST is refused (Pylon asks
// for no server features this way), EXT_INFO is recorded, a KEXINIT
// starts a rekey, and DISCONNECT ends the connection. It waits for as many
// packets as that takes: for request/reply steps.
@requires(network, declassify)
pub Pkt next_msg(Conn c0) {
    Pkt k = next_once(c0);
    if (!conn_ok(k.c) || k.p.len() > 0) { return Pkt {.c = same(k.c), .p = k.p}; }
    return next_msg(k.c);
}

// Exactly one packet: a connection-level message, or (handled here, with
// an empty payload returned) a transport-level one. Event loops use this,
// so one readable socket never makes them wait for a second packet that
// may not come (OpenSSH's host-keys announcement after login, keepalives).
@requires(network, declassify)
pub Pkt next_once(Conn c0) {
    Pkt k = recv_packet(c0);
    if (!conn_ok(k.c)) { return Pkt {.c = same(k.c), .p = k.p}; }
    Int t = k.p[0];
    if (t == msg_ignore() || t == msg_debug() || t == msg_unimplemented()) { return Pkt {.c = k.c, .p = []}; }
    if (t == msg_disconnect()) { return pkt_err(k.c, disconnect_reason(k.p)); }
    if (t == msg_ext_info()) { return Pkt {.c = ext_info(k.c, k.p), .p = []}; }
    if (t == msg_global_request()) {
        GotText name = rd_text(rd_at(k.p, 1));
        GotInt want = rd_bool(name.r);
        Conn c2 = if (want.v == 1) { send_packet(k.c, [msg_request_failure()]) } else { k.c };
        return Pkt {.c = c2, .p = []};
    }
    if (t == msg_kexinit()) { return Pkt {.c = rekey(k.c, k.p), .p = []}; }
    return k;
}

// EXT_INFO (RFC 8308): server-sig-algs and publickey-hostbound@openssh.com.
Conn ext_info(Conn c, List(Int) p) {
    GotInt n = rd_u32(rd_at(p, 1));
    if (!rd_ok(n.r) || n.v > 64) { return same(c); }
    return ext_acc(c, n.r, n.v);
}

Conn ext_acc(Conn c, Rd r, Int left) {
    if (left <= 0) { return same(c); }
    GotText name = rd_text(r);
    Got val = rd_str(name.r);
    if (!rd_ok(val.r)) { return same(c); }
    List(Str) algs = if (name.v == "server-sig-algs") { str_split(ascii_text(val.v), ",") } else { c.sig_algs };
    Bool hb = c.hostbound || name.v == "publickey-hostbound@openssh.com";
    Bool pg = c.ping || name.v == "ping@openssh.com";
    Conn nc = Conn {.fd = c.fd, .tx = c.tx, .rx = c.rx, .buf = c.buf, .eof = c.eof, .err = c.err,
        .v_s = c.v_s, .sid = c.sid, .host_blob = c.host_blob, .host_sig = c.host_sig, .host_alg = c.host_alg,
        .strict = c.strict, .sig_algs = algs, .hostbound = hb, .ping = pg};
    return ext_acc(nc, val.r, left - 1);
}

// ============================================================================
// Key exchange
// ============================================================================

// The host trust input (SPEC 6): the keys pinned for this host, already
// filtered by the caller's policy.
// `probe` runs the exchange only to learn and verify the host's key, and
// stops before NEWKEYS: `pylon pin` uses it to compare the key with a
// fingerprint the principal obtained out of band.
// `cas` are the CA keys the principal trusts for this host's name (SPEC
// 6.1.1), `name` the host name certificates must name, `now` the time in
// seconds since the epoch. `dns` is what DNSSEC-validated DNS says of the
// host's SSHFP records (SPEC 6.1.2; state "" when not asked): consulted
// only for a host with no pin, and only a secure match accepts a key.
pub type Trust = { List(List(Int)) pinned; Bool probe; List(List(Int)) cas; Str name; Int now; Verdict dns; };

pub Trust pinned_only(List(List(Int)) pinned) { return Trust {.pinned = pinned, .probe = false, .cas = [], .name = "", .now = 0, .dns = no_dns()}; }
pub Trust probing() { return Trust {.pinned = [], .probe = true, .cas = [], .name = "", .now = 0, .dns = no_dns()}; }

pub Str probe_done() { return "probe: host key verified"; }

// The plain key of a blob that may be a certificate.
pub List(Int) plain_key_blob(List(Int) blob) {
    GotText kind = rd_text(rd(blob));
    if (!is_cert_alg(kind.v)) { return blob; }
    Cert c = cert_of_blob(blob);
    return if (c.ok) { c.key.blob } else { blob };
}

// Why a host key is refused under `t`, or "".
pub Str trust_refusal(Trust t, List(Int) blob) {
    if (t.probe) { return probe_done(); }
    GotText kind = rd_text(rd(blob));
    if (is_cert_alg(kind.v)) {
        Cert c = cert_of_blob(blob);
        // A pinned key is trusted with or without its certificate.
        if (c.ok && pinned_has(t.pinned, c.key.blob, 0)) { return ""; }
        if (t.cas.len() == 0) {
            return trust_refusal(Trust {.pinned = t.pinned, .probe = false, .cas = [], .name = t.name, .now = t.now, .dns = t.dns}, c.key.blob);
        }
        Str cr = cert_refusal(c, t.name, t.now, t.cas);
        if (str_len(cr) > 0) { return cr; }
        // A valid certificate does not override a pin or a DNSSEC-signed
        // SSHFP record that names another key (SPEC 6.1, 6.2): a CA
        // trusted for the name vouches only for hosts with neither.
        if (t.pinned.len() > 0) { return changed_key(c.key.blob); }
        if (sshfp_match(t.dns, c.key.blob) == "mismatch") { return sshfp_mismatch(c.key.blob, t.dns); }
        return "";
    }
    if (t.pinned.len() == 0) {
        Str m = sshfp_match(t.dns, blob);
        if (m == "match") { return ""; }
        Str dl = if (str_len(t.dns.state) > 0) { verdict_line(t.dns) + "\n" } else { "" };
        if (m == "mismatch") { return sshfp_mismatch(blob, t.dns); }
        return "this host is not pinned, and Pylon does not trust a key on first use.\n"
            + dl
            + "Its key is " + fingerprint(blob) + ". Compare that with a value you get another way\n"
            + "(the host's console: ssh-keygen -lf /etc/ssh/ssh_host_*_key.pub), then run\n"
            + "  pylon pin HOST FINGERPRINT";
    }
    if (!pinned_has(t.pinned, blob, 0)) { return changed_key(blob); }
    return "";
}

// The refusal of a key other than the pinned one. The CLI recognizes it
// by its first words to record the refusal in the host's history.
Str changed_key(List(Int) blob) {
    return "THE HOST KEY HAS CHANGED. The connection was stopped before authenticating.\n"
        + "The host now presents " + fingerprint(blob) + ", which is not the pinned key.\n"
        + "This is what an interception looks like. If the change is expected, verify the\n"
        + "new key out of band and pin it again with: pylon pin HOST FINGERPRINT";
}

// The refusal of a key the host's secure SSHFP records do not name.
Str sshfp_mismatch(List(Int) blob, Verdict dns) {
    Str dl = if (str_len(dns.state) > 0) { verdict_line(dns) + "\n" } else { "" };
    return "THE HOST KEY DOES NOT MATCH THE HOST'S DNSSEC-SIGNED SSHFP RECORDS.\n"
        + "The connection was stopped before authenticating. The host presents\n"
        + fingerprint(blob) + "; " + dl
        + "Either the records are out of date or this is an interception. Compare the key\n"
        + "with a value you get another way before you pin it: pylon pin HOST FINGERPRINT";
}

Bool pinned_has(List(List(Int)) ps, List(Int) b, Int i) {
    if (i >= ps.len()) { return false; }
    if (same_bytes(ps[i], b)) { return true; }
    return pinned_has(ps, b, i + 1);
}

pub type Handshake = { Conn c; PubKey host; Str fingerprint; };

// The first key exchange. The host key is checked under `trust` after
// its signature over H verified and before NEWKEYS is sent, so nothing
// keyed is ever sent to an unverified host (SPEC G2). `allow_no_strict`
// is the per-host exception of SPEC 5.
@requires(network, declassify)
pub Handshake handshake(Conn c0, Trust trust, Bool allow_no_strict) {
    Conn c1 = version_exchange(c0);
    List(Str) host_algs = (if (trust.cas.len() > 0) { our_cert_algs() } else { [] }).concat(host_key_order(key_types(trust.pinned, 0, []).concat(if (trust.pinned.len() == 0) { sshfp_key_types(trust.dns) } else { [] })));
    List(Int) i_c = kexinit_payload(host_algs, true);
    Conn c2 = send_packet(c1, i_c);
    // Strict kex: the server's first packet must be its KEXINIT.
    Pkt k1 = recv_packet(c2);
    if (!conn_ok(k1.c)) { return Handshake {.c = k1.c, .host = no_key(), .fingerprint = ""}; }
    if (k1.p[0] != msg_kexinit()) { return Handshake {.c = conn_err(k1.c, "the server's first packet is not KEXINIT"), .host = no_key(), .fingerprint = ""}; }
    Chosen ch = choose(parse_kexinit(k1.p), host_algs, true);
    if (str_len(ch.err) > 0) { return Handshake {.c = conn_err(k1.c, ch.err), .host = no_key(), .fingerprint = ""}; }
    if (!ch.strict && !allow_no_strict) {
        return Handshake {.c = conn_err(k1.c, "the server does not support strict key exchange (the Terrapin fix); update it, or allow this host as an exception"), .host = no_key(), .fingerprint = ""};
    }
    Conn c3 = Conn {.fd = k1.c.fd, .tx = k1.c.tx, .rx = k1.c.rx, .buf = k1.c.buf, .eof = k1.c.eof, .err = "",
        .v_s = k1.c.v_s, .sid = [], .host_blob = [], .host_sig = [], .host_alg = ch.hostkey,
        .strict = ch.strict, .sig_algs = [], .hostbound = false, .ping = false};
    return run_kex(c3, ch, i_c, k1.p, trust);
}

@requires(network, declassify)
Handshake run_kex(Conn c, Chosen ch, List(Int) i_c, List(Int) i_s, Trust trust) {
    Bool hybrid = is_hybrid(ch.kex);
    Ecdh e = ecdh_new();
    Hybrid hy = if (hybrid) { hybrid_new() } else { Hybrid {.kem = MlkemKeys {.ek = [], .dk = []}, .x = e} };
    Conn c1 = send_packet(c, if (hybrid) { hybrid_init_payload(hy) } else { ecdh_init_payload(e) });
    Pkt r = kex_packet(c1);
    if (!conn_ok(r.c)) { return Handshake {.c = r.c, .host = no_key(), .fingerprint = ""}; }
    Reply rep = if (hybrid) { parse_hybrid_reply(r.p) } else { parse_ecdh_reply(r.p) };
    if (!rep.ok) { return Handshake {.c = conn_err(r.c, "malformed key exchange reply"), .host = no_key(), .fingerprint = ""}; }
    Exchanged x = if (hybrid) { finish_hybrid(hy, rep, our_version(), r.c.v_s, i_c, i_s, ch.hostkey, ch.c2s, ch.s2c, r.c.sid) }
        else { finish_ecdh(e, rep, our_version(), r.c.v_s, i_c, i_s, ch.hostkey, ch.c2s, ch.s2c, r.c.sid) };
    if (str_len(x.err) > 0) { return Handshake {.c = conn_err(r.c, x.err), .host = x.host, .fingerprint = ""}; }
    Str fp = fingerprint(if (x.host.kind != "") { x.host.blob } else { rep.host_blob });
    // On a rekey the host key must be the one verified at the start.
    Bool rekeying = r.c.sid.len() > 0;
    if (rekeying && !same_bytes(rep.host_blob, r.c.host_blob)) { return Handshake {.c = conn_err(r.c, "the host key changed during a rekey"), .host = x.host, .fingerprint = fp}; }
    Str refuse = if (rekeying) { "" } else { trust_refusal(trust, rep.host_blob) };
    if (str_len(refuse) > 0) { return Handshake {.c = conn_err(r.c, refuse), .host = x.host, .fingerprint = fp}; }
    List(Int) sid = if (rekeying) { r.c.sid } else { x.m.h };
    List(Int) hsig = if (rekeying) { r.c.host_sig } else { rep.sig };
    Conn c2 = send_packet(r.c, [msg_newkeys()]);
    Pkt nk = kex_packet(c2);
    if (!conn_ok(nk.c)) { return Handshake {.c = nk.c, .host = x.host, .fingerprint = fp}; }
    if (nk.p.len() != 1 || nk.p[0] != msg_newkeys()) { return Handshake {.c = conn_err(nk.c, "expected NEWKEYS"), .host = x.host, .fingerprint = fp}; }
    Keys ks = new_keys(ch, nk.c.strict, x.m, nk.c.tx.seq, nk.c.rx.seq);
    Conn done = Conn {.fd = nk.c.fd, .tx = ks.tx, .rx = ks.rx, .buf = nk.c.buf, .eof = nk.c.eof, .err = "",
        .v_s = nk.c.v_s, .sid = sid, .host_blob = rep.host_blob, .host_sig = hsig, .host_alg = nk.c.host_alg,
        .strict = nk.c.strict, .sig_algs = nk.c.sig_algs, .hostbound = nk.c.hostbound, .ping = nk.c.ping};
    return Handshake {.c = done, .host = x.host, .fingerprint = fp};
}

// A packet during the key exchange. Under strict kex anything but the
// expected kex message ends the connection (the Terrapin countermeasure);
// otherwise IGNORE and DEBUG are skipped.
List(Str) key_types(List(List(Int)) ps, Int i, List(Str) acc) {
    if (i >= ps.len()) { return acc; }
    GotText a = rd_text(rd(ps[i]));
    return key_types(ps, i + 1, acc.concat([a.v]));
}

@requires(network, declassify)
Pkt kex_packet(Conn c) {
    Pkt k = recv_packet(c);
    if (!conn_ok(k.c)) { return Pkt {.c = same(k.c), .p = k.p}; }
    Int t = k.p[0];
    if (t == msg_disconnect()) { return pkt_err(k.c, disconnect_reason(k.p)); }
    if (!k.c.strict && (t == msg_ignore() || t == msg_debug())) { return kex_packet(k.c); }
    if (t != msg_kex_ecdh_reply() && t != msg_newkeys()) { return pkt_err(k.c, "unexpected message during key exchange"); }
    return k;
}

// A rekey the server started with its KEXINIT `i_s`.
@requires(network, declassify)
Conn rekey(Conn c, List(Int) i_s) {
    List(Str) host_algs = [c.host_alg];
    List(Int) i_c = kexinit_payload(host_algs, false);
    Conn c1 = send_packet(c, i_c);
    Chosen ch = choose(parse_kexinit(i_s), host_algs, false);
    if (str_len(ch.err) > 0) { return conn_err(c1, ch.err); }
    Handshake h = run_kex(c1, ch, i_c, i_s, pinned_only([c.host_blob]));
    return h.c;
}

// ============================================================================
// Services
// ============================================================================

@requires(network, declassify)
pub Conn request_service(Conn c, Str name) {
    Conn c1 = send_packet(c, [msg_service_request()].concat(sstr(name)));
    Pkt k = next_msg(c1);
    if (!conn_ok(k.c)) { return k.c; }
    if (k.p[0] != msg_service_accept()) { return conn_err(k.c, "the server refused the " + name + " service"); }
    return k.c;
}

// Read deadlines are absolute ("every read ends ms from now"), so a step
// that waits on the principal (the consent sheet) re-arms the deadline
// before the connection is read again.
@requires(network, declassify)
pub Bool rearm(Conn c, Int ms) { return resid_tcp_deadline(c.fd, ms); }

@requires(network, declassify)
pub Bool disconnect(Conn c, Str why) {
    Conn c1 = send_packet(c, [msg_disconnect()].concat(u32_be(11)).concat(sstr(why)).concat(sstr("")));
    _ = resid_tcp_shutdown(c1.fd);
    return resid_tcp_close(c1.fd);
}
